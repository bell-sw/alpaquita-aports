# Description: Python is a clear and powerful object-oriented programming
# language, comparable to Perl, Ruby, Scheme, or Java.

pkgname=python3
# the python3-tkinter's pkgver needs to be synchronized with this.
pkgver=3.11.13
_basever="${pkgver%.*}"
pkgrel=3
pkgdesc="Python programming language"
url="https://www.python.org/"
arch="all"
license="PSF-2.0"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-tests::noarch
	$pkgname-gdbm
	"
# since 3.11.9, pyexpat exposes the reparse deferral API in expat >= 2.6.0
depends="libexpat>=2.6.3"
makedepends="
	!gettext-dev
	bluez-headers
	bzip2-dev
	expat-dev
	gdbm-dev
	libffi-dev
	linux-headers
	mpdecimal-dev
	musl:musl-libintl
	ncurses-dev
	openssl-dev
	readline-dev
	sqlite-dev
	tcl-dev
	xz-dev
	zlib-dev
	"
# The '.diff' extension is for x86_64 specific patches so abuild won't apply
# them automatically.
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz
	musl:musl-find_library.patch

	0100-skip-test_url_host_with-test-cases.patch
	0101-AVX2-and-AVX512-support.diff
	0102-Force-config-to-always-be-shared.patch
	0103-Unset-BASH_XTRACEFD-in-tests.patch
	0104-CVE-2025-8194.patch
	0105-CVE-2025-12084.patch
	0106-CVE-2025-13836.patch
	0107-CVE-2025-13837.patch
	0108-gh-136063-fix-quadratic-complexity-parsing-in-email..patch
	0109-CVE-2026-0865.patch
	0110-CVE-2025-15282.patch
	0111-CVE-2026-0672.patch
	0112-CVE-2025-15366.patch
	0113-CVE-2025-15367.patch
	0114-CVE-2026-1299.patch
	0115-CVE-2025-11468.patch
	0116-CVE-2025-12781-pre.patch
	0117-CVE-2025-12781.patch
	"
options="net" # Required for tests
builddir="$srcdir/Python-$pkgver"

