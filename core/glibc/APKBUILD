# Description: glibc is a backward compatible and highly performant
# C library. The package includes core libraries with essential APIs
# for the GNU and Linux systems.

pkgname=glibc
pkgver=2.39.0
pkgrel=12
_glibcver=${pkgver%.*}
_patch_ver="glibc-2.39-298-gbe1e627cd7"
pkgdesc="GNU C Library"
url="https://www.gnu.org/software/libc"
arch="x86_64 aarch64"
license="GPL-2.0 LGPL-2.0"
depends_dev="linux-headers"
makedepends="bison perl python3 texinfo gawk grep sed coreutils"
source="
	https://ftp.gnu.org/gnu/libc/glibc-$_glibcver.tar.xz
	${VENDOR_URL/\/\//\/\/packages.}${VENDOR_DISTRO}/distfiles/${_patch_ver}.patch.xz
	ld.so.conf
	locale.gen.in
	locale-gen
	ldconfig.trigger.c
	0100-delocalize-glibc-utils-scripts-use-bin-sh.patch
	0101-resolv-Declare-__p_class_syms-__p_type_syms-for-inte.patch
	0102-resolv-Fix-ns_sprintrrf-formatting-of-class-type-val.patch
	0103-resolv-Improve-formatting-of-unknown-records-in-ns_s.patch
	0104-resolv-Check-for-inet_ntop-failure-in-ns_sprintrrf.patch
	0105-CVE-2026-5435-resolv-More-types-as-unknown-in-ns_spr.patch
	0106-CVE-2026-6238-resolv-Fix-buffer-overreads-in-ns_spri.patch
	0107-resolv-Add-test-case-tst-ns_sprintrr-bug-34033-bug-3.patch
	0108-CVE-2026-6791-posix-Fix-stack-overflow-in-wordexp-ti.patch
	0109-rtld-cache-cpuid-results-on-the-stack-for-intel.patch
	0110-CVE-2026-19542.patch
	0111-CVE-2026-6368-posix-Fix-wordexp-WRDE_APPEND-to-prese.patch
	0112-CVE-2026-19499-stdlib-Fix-right-justification-in-str.patch
	0113-CVE-2026-77117-iconvdata-SHIFT_JISX0213-decoding-lac.patch
	0114-CVE-2026-80489-iconvdata-EUC_JISX0213-decoding-lacks.patch
	0115-iconvdata-Test-case-for-bug-34556-bug-34568.patch
	"
builddir="$srcdir/glibc-$_glibcver"
options="!libc_musl lib64 ldpath-recursive !check !annobin"
[ "$BOOTSTRAP" != "nolibc" ] && triggers="$pkgname-utils.trigger=/usr/lib:/usr/lib64:/usr/local/lib"
subpackages="
	$pkgname-dbg
	$pkgname-nscd
	$pkgname-utils
	$pkgname-locales::noarch
	$pkgname-doc
	$pkgname-dev
	$pkgname-gconv-extra:gconv_extra
"

