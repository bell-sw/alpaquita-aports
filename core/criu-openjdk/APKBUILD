pkgname=criu-openjdk
pkgver=1.4
pkgrel=7
pkgdesc="Checkpoint and Restore in Userspace"
url="https://github.com/openjdk/crac"
arch="aarch64 x86_64"
license="GPL-2.0-only"

# annobin interferes with criu and must be disabled
# yes, openjdk-crac officially requires criu to be installed setuid
# make test requires py3-protobuf that we don't have packaged yet
options="!annobin suid !check"
# options="checkroot"

# XXX: criu wants lz4io as a library and so it build its own copy
_lz4_version=1.9.4

makedepends="
	libcap-dev
	libnet-dev
	libnet-static
	libnl3-dev
	libnl3-static
	perl
	protobuf-c-dev
	protobuf-dev
	python3
	"

# checkdepends="
# 	libaio-dev
# 	py3-yaml
# 	py3-protobuf
# 	"

source="
	http://packages.bell-sw.com/alpaquita/distfiles/checkpointrestore-criu-bell-sw-release-$pkgver-ga.tar.bz2
	criu-lz4-$_lz4_version.tar.gz::https://github.com/lz4/lz4/archive/v$_lz4_version.tar.gz

	features.patch
	glibc-rseq_size.patch
	lz4-drop-in.patch
	musl-support.patch
	criu-pr-2539-vdso-handle-vvar_vclock-vma-s.patch
	musl:aarch64-musl-include.patch
	vdso-switch-from-DT_HASH-to-DT_GNU_HASH-aarch64.patch

	vma_area_guard/0001-criu-include-mman-define-MADV_GUARD_INSTALL.patch
	vma_area_guard/0002-kerndat-add-madvise-MADV_GUARD_INSTALL-feature-detec.patch
	vma_area_guard/0003-kerndat-check-support-for-PAGE_IS_SOFT_DIRTY.patch
	vma_area_guard/0004-kerndat-add-pagemap_scan_guard_pages-feature-check-l.patch
	vma_area_guard/0005-cr-dump-warn-if-MADV_GUARD-is-supported-but-isn-t-sh.patch
	vma_area_guard/0006-criu-pagemap-cache-pagescan-look-for-PAGE_IS_GUARD-p.patch
	vma_area_guard/0007-criu-mem-dump-skip-MADV_GUARD-pages-content-dump.patch
	vma_area_guard/0008-criu-mem-vdso-cr-restore-introduce-VMA_AREA_GUARD-fa.patch
	vma_area_guard/0009-criu-pie-restorer-add-madvise-MADV_GUARD_INSTALL-res.patch
	vma_area_guard/0010-criu-mem-dump-note-MADV_GUARD-pages-as-VMA_AREA_GUAR.patch
	vma_area_guard/0011-pagemap-prevent-integer-overflow-in-pagemap_len.patch
	vma_area_guard/0012-pagemap-change-PagemapEntry.nr_pages-to-uint64-to-su.patch
	vma_area_guard/0013-pagemap-use-unsigned-long-for-page-counts.patch
	vma_area_guard/0014-pagemap-print-page-regions-in-the-format-start-end.patch
	vma_area_guard/0015-pagemap-cache-stop-filling-cache-on-VMA_AREA_GUARD.patch
	"

builddir="$srcdir/checkpointrestore-criu-bell-sw-release-$pkgver-ga"

unpack() {
	# unpack both criu and lz4 in srcdir
	default_unpack

	# move lz4 into the location criu wants it
	rmdir "$builddir/lz4"	# empty placeholder (git module)
	mv "$srcdir/lz4-$_lz4_version" "$builddir/lz4"
}

build() {
	local verbose
	# verbose="-w V=1"	# uncomment if necessary

	make $verbose WERROR=0
}

package() {
	# openjdk needs just the criu binary and it expects it in its
	# own libdir.  install the binary (shared by different jdk
	# versions) in libexec and let the jdk packages pick it from
	# there, creating the necessary link in their post-install
	# script.
	#
	# in case we might also need to install criu-ns later, use a
	# subdir in libexec so that we have our options open.
	install -d "$pkgdir"/usr/libexec/$pkgname
	install -m 4755 "$builddir"/criu/criu "$pkgdir"/usr/libexec/$pkgname/criu
}

