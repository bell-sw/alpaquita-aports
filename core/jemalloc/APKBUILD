237d11c69c74402a78d0fb67914144653e5215170bb8047726d35d895b6edab603189d611b2b24cf783cc93fe5f6a25bae28f659d20d44054d182faeb07bbf7c  malloc.sh
0f497426e9f731fbfd2392b6313ac8355ffcd6815b3b115b70542500614cbd0808a159afc143ca6f5d7b901871cff2126ef710bc399409ed336bc4550029449e  pkgconf.patch
