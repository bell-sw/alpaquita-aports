# Description: contains a library for userspace interfaces to POSIX 1003.1e
# capabilities. It makes programming much easier than the traditional
# libcap library.

pkgname=libcap-ng
pkgver=0.9.6
pkgrel=0
pkgdesc="POSIX 1003.1e capabilities next-gen library"
url="https://people.redhat.com/sgrubb/libcap-ng/index.html"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
depends_dev="linux-headers"
makedepends="$depends_dev autoconf automake libtool python3-dev swig"
subpackages="$pkgname-static
	$pkgname-bash-completion
	$pkgname-dev
	$pkgname-doc
	$pkgname-utils
	py3-$pkgname:_py3
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/stevegrubb/libcap-ng/archive/v$pkgver/libcap-ng-$pkgver.tar.gz"

prepare() {
	default_prepare

	touch NEWS # or autoreconf will fail
	autoreconf -vif
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--without-python \
		--with-python3 \
		--enable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

utils() {
	pkgdesc="posix capabilities utils"

	amove usr/bin
}

_py3() {
	pkgdesc="python bindings for libcap-ng"

	amove usr/lib/python3*
}

sha512sums="
77bc255688606cbc3a9d40cc1d417ebf748d04b8d837d793708b58431857ebfaa077f00cebfcf03c58ce56985feb63f9f8eb70cce21ba304ca3418a0fe1b61d1  libcap-ng-0.9.6.tar.gz
"
