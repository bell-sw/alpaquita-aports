6f3475ed5502a114b06e4c13f4c358082a3ed0763471c413f4b6c09fba6652a4f1e1568bce1343acce1350f5f45e1b5f04a82845d1fbbdf7f7698f19fd99964a  0001-fix-musl-build-with-linux-prctl.h.patch
237d11c69c74402a78d0fb67914144653e5215170bb8047726d35d895b6edab603189d611b2b24cf783cc93fe5f6a25bae28f659d20d44054d182faeb07bbf7c  malloc.sh
"
