9de56641fb9008ae361c80fb6aae995683ac602d5b8306fd77926558e2cc1cb8c8899a53ce1aab932bd63b50515616a36faf04fd35f590b22689e57b3bbd26d9  0001-fix-musl-build-with-linux-prctl.h.patch
237d11c69c74402a78d0fb67914144653e5215170bb8047726d35d895b6edab603189d611b2b24cf783cc93fe5f6a25bae28f659d20d44054d182faeb07bbf7c  malloc.sh
"
