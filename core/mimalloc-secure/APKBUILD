e13d434f818cc9187e1c4de6945bb9839dbf8d6a34c130e3ac15fd808a566d4a93c4c85558f41a881d87cec885a4fae4887d23c223019005e7a0a1f3edc0105b  0001-fix-musl-build-with-linux-prctl.h.patch
237d11c69c74402a78d0fb67914144653e5215170bb8047726d35d895b6edab603189d611b2b24cf783cc93fe5f6a25bae28f659d20d44054d182faeb07bbf7c  malloc.sh
"
