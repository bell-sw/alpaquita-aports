ldpath="$_java_home/jre/lib"

if [ "$BUILD_FROM_SOURCE" -ne 0 ]; then
	# To build from sources - build with openjdk8-bootstrap, provided by a
	# previous version of this package
	makedepends="$makedepends
		openjdk8-bootstrap>=8u333
		"
