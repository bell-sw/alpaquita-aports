pkgver=${_java_ver/+/_p}
pkgver=${pkgver/u/.}
pkgrel=0
pkgdesc="$_java_name"
url="$VENDOR_URL"
license="GPL-2.0 WITH Classpath-Exception-2.0"
arch="aarch64 x86_64"
options="!strip !tracedeps ldpath-recursive !annobin"
