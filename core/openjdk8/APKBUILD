	$pkgname-jre-no-deps:_jre_no_deps
	$pkgname-jre:_jre
	$pkgname-jdk-no-deps:_jdk_no_deps
	$pkgname-jdk:_jdk
	"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

provides="
	$pkgname-lite=$pkgver-r$pkgrel
	openjdk8=$pkgver-r$pkgrel
	openjdk8-lite=$pkgver-r$pkgrel
	openjdk
"

