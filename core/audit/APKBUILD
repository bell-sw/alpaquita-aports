pkgname=audit
pkgver=4.2.1
pkgrel=0
pkgdesc="User space tools for kernel auditing"
url="https://people.redhat.com/sgrubb/audit/"
arch="all"
license="LGPL-2.1-or-later"
depends_dev="linux-headers"
makedepends="
	$depends_dev
	autoconf
	automake
	coreutils-fmt
	libapparmor-dev
	libcap-ng-dev
	libtool
	python3-dev
	swig
	"
install="$pkgname.pre-install"
subpackages="
	$pkgname-static
	$pkgname-dev
	$pkgname-doc
	$pkgname-libs
	$pkgname-openrc
	$pkgname-bash-completion
	$pkgname-systemd
	py3-audit-pyc
	py3-audit:py3
	"
source="https://github.com/linux-audit/audit-userspace/archive/v$pkgver/audit-$pkgver.tar.gz
	0003-all-get-rid-of-strndupa.patch
	fix-basename.patch
	auditd.initd
	auditd.confd
	"
builddir="$srcdir/$pkgname-userspace-$pkgver"

prepare() {
	default_prepare

	autoreconf -fvi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--runstatedir=/run \
		--disable-zos-remote \
		--enable-shared=audit \
		--with-arm \
		--with-aarch64 \
		--with-apparmor=yes \
		--with-io_uring=yes \
		--with-libcap-ng=yes \
		--with-python3=yes

	make
}

check() {
	case "$CARCH" in
	loongarch64|riscv64)
		# TODO: investigate
		make check XFAIL_TESTS="auditctl_rule_file_test" ;;
	*)
		make check ;;
	esac
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm755 "$srcdir"/auditd.initd "$pkgdir"/etc/init.d/auditd
	install -Dm644 "$srcdir"/auditd.confd "$pkgdir"/etc/conf.d/auditd

	# The directory is required by /usr/sbin/augenrules. The augenrules program expects rules to be located in /etc/audit/rules.d/
	install -dm750 "$pkgdir"/etc/audit/rules.d/

	cd "$pkgdir"
	rm -r usr/libexec/initscripts/legacy-actions/auditd
	rmdir -vp --ignore-fail-on-non-empty usr/lib/systemd \
		usr/libexec/initscripts/legacy-actions
}

py3() {
	pkgdesc="Python audit module"
	depends="python3"

	amove usr/lib/python*
}

