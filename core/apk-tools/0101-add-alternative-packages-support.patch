From 13f08169a1f65383c5813ccdea9a08a5f30e6f09 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Tue, 22 Feb 2022 18:18:06 +0300
Subject: [PATCH] add alternative packages support

---
 src/apk_package.h     |   1 +
 src/apk_solver.h      |   1 +
 src/apk_solver_data.h |   2 +
 src/app_add.c         |   2 +-
 src/package.c         |   8 +++
 src/solver.c          | 122 ++++++++++++++++++++++++++++++++++++++----
 6 files changed, 125 insertions(+), 11 deletions(-)

diff --git a/src/apk_package.h b/src/apk_package.h
index 929a61e..94f9d95 100644
--- a/src/apk_package.h
+++ b/src/apk_package.h
@@ -95,6 +95,7 @@ struct apk_package {
 	unsigned char cached_non_repository : 1;
 	unsigned char cached : 1;
 	unsigned char layer : 3;
+	unsigned char alternative : 1;
 	uint8_t digest_alg;
 	uint8_t digest[];
 };
diff --git a/src/apk_solver.h b/src/apk_solver.h
index 37f85b7..6af5c86 100644
--- a/src/apk_solver.h
+++ b/src/apk_solver.h
@@ -34,6 +34,7 @@ struct apk_changeset {
 #define APK_SOLVERF_IGNORE_CONFLICT	0x0010
 #define APK_SOLVERF_INSTALLED	 	0x0020
 #define APK_SOLVERF_REMOVE		0x0040
+#define APK_SOLVERF_NEW_ADD	 	0x0080
 
 void apk_solver_set_name_flags(struct apk_name *name,
 			       unsigned short solver_flags,
diff --git a/src/apk_solver_data.h b/src/apk_solver_data.h
index 78441cc..d65708c 100644
--- a/src/apk_solver_data.h
+++ b/src/apk_solver_data.h
@@ -41,6 +41,7 @@ struct apk_solver_name_state {
 	unsigned has_auto_selectable : 1;
 	unsigned iif_needed : 1;
 	unsigned resolvenow : 1;
+	unsigned new_alternative : 1;
 };
 
 struct apk_solver_package_state {
@@ -60,4 +61,5 @@ struct apk_solver_package_state {
 	unsigned char iif_triggered : 1;
 	unsigned char iif_failed : 1;
 	unsigned char error : 1;
+	unsigned char old_alternative : 1;
 };
diff --git a/src/app_add.c b/src/app_add.c
index fd0dcdf..0c9986d 100644
--- a/src/app_add.c
+++ b/src/app_add.c
@@ -176,7 +176,7 @@ static int add_main(void *ctx, struct apk_ctx *ac, struct apk_string_array *args
 		} else {
 			apk_deps_add(&world, &dep);
 			apk_solver_set_name_flags(dep.name,
-						  actx->solver_flags,
+						  actx->solver_flags | APK_SOLVERF_NEW_ADD,
 						  actx->solver_flags);
 		}
 	}
diff --git a/src/package.c b/src/package.c
index e1545ac..13d8f02 100644
--- a/src/package.c
+++ b/src/package.c
@@ -516,6 +516,9 @@ int apk_pkgtmpl_add_info(struct apk_database *db, struct apk_package_tmpl *tmpl,
 	case 'k':
 		pkg->provider_priority = apk_blob_pull_uint(&value, 10);
 		break;
+	case 'B':
+		pkg->alternative = apk_blob_pull_uint(&value, 10);
+		break;
 	case 'F': case 'M': case 'R': case 'Z': case 'r': case 'q':
 	case 'a': case 's': case 'f': case 'g':
 		/* installed db entries which are handled in database.c */
@@ -601,6 +604,7 @@ static int read_info_line(struct read_info_ctx *ri, apk_blob_t line)
 		{ "builddate",	't' },
 		{ "commit",	'c' },
 		{ "provider_priority", 'k' },
+		{ "alternative", 'B' },
 	};
 	apk_blob_t l, r;
 	int i;
@@ -863,6 +867,10 @@ int apk_pkg_write_index_header(struct apk_package *info, struct apk_ostream *os)
 		apk_blob_push_blob(&bbuf, APK_BLOB_STR("\nk:"));
 		apk_blob_push_uint(&bbuf, info->provider_priority, 10);
 	}
+	if (info->alternative) {
+		apk_blob_push_blob(&bbuf, APK_BLOB_STR("\nB:"));
+		apk_blob_push_uint(&bbuf, info->alternative, 10);
+	}
 	apk_blob_push_blob(&bbuf, APK_BLOB_STR("\n"));
 
 	if (APK_BLOB_IS_NULL(bbuf))
diff --git a/src/solver.c b/src/solver.c
index ed38e7f..a2375e1 100644
--- a/src/solver.c
+++ b/src/solver.c
@@ -238,11 +238,19 @@ static void discover_name(struct apk_solver_state *ss, struct apk_name *name)
 			apk_array_foreach(dep, pkg->depends)
 				discover_name(ss, dep->name);
 
-			dbg_printf("discover " PKG_VER_FMT ": tag_ok=%d, tag_pref=%d selectable=%d\n",
+			pkg->name->ss.new_alternative =
+				pkg->alternative &&
+				!pkg->ipkg &&
+				(pkg->ss.solver_flags & APK_SOLVERF_NEW_ADD);
+
+			dbg_printf("discover " PKG_VER_FMT ": tag_ok=%d, tag_pref=%d selectable=%d solver_flags=%x alternative=%d(%d)\n",
 				PKG_VER_PRINTF(pkg),
 				pkg->ss.tag_ok,
 				pkg->ss.tag_preferred,
-				pkg->ss.pkg_selectable);
+				pkg->ss.pkg_selectable,
+				pkg->ss.solver_flags,
+				pkg->alternative,
+				pkg->name->ss.new_alternative);
 		}
 
 		name->ss.no_iif &= pkg->ss.iif_failed;
@@ -267,8 +275,9 @@ static void discover_name(struct apk_solver_state *ss, struct apk_name *name)
 			discover_name(ss, dep->name);
 	}
 
-	dbg_printf("discover %s: no_iif=%d num_virtual=%d, order_id=%d\n",
-		name->name, name->ss.no_iif, num_virtual, name->ss.order_id);
+	dbg_printf("discover %s: no_iif=%d num_virtual=%d, order_id=%d new_alternative=%d\n",
+		name->name, name->ss.no_iif, num_virtual, name->ss.order_id,
+		name->ss.new_alternative);
 }
 
 static void name_requirers_changed(struct apk_solver_state *ss, struct apk_name *name)
@@ -308,9 +317,9 @@ static void apply_constraint(struct apk_solver_state *ss, struct apk_package *pp
 	struct apk_name *name = dep->name;
 	int is_provided;
 
-	dbg_printf("    apply_constraint: %s%s%s" BLOB_FMT "\n",
+	dbg_printf("    apply_constraint: %s%s(req %d dep %d)%s" BLOB_FMT "\n",
 		apk_dep_conflict(dep) ? "!" : "",
-		name->name,
+		name->name, name->ss.requirers, apk_dep_conflict(dep),
 		apk_version_op_string(dep->op),
 		BLOB_PRINTF(*dep->version));
 
@@ -340,14 +349,56 @@ static void apply_constraint(struct apk_solver_state *ss, struct apk_package *pp
 static void exclude_non_providers(struct apk_solver_state *ss, struct apk_name *name, struct apk_name *must_provide, int skip_virtuals)
 {
 	if (name == must_provide || ss->ignore_conflict) return;
-	dbg_printf("%s must provide %s (skip_virtuals=%d)\n", name->name, must_provide->name, skip_virtuals);
+	dbg_printf("%s must provide %s (skip_virtuals=%d new_alternative=%d)\n)",
+		    name->name, must_provide->name, skip_virtuals, must_provide->ss.new_alternative);
+
+	int mp_installed = 0;
+	int mp_priority = 0;
+	int mp_alternative = 0;
+
+	apk_array_foreach(p, must_provide->providers) {
+		if (!p->pkg->alternative)
+			continue;
+		mp_alternative = 1;
+		mp_priority = p->pkg->provider_priority;
+		if (p->pkg->ipkg) {
+			mp_installed = 1;
+			break;
+		}
+	}
+
 	apk_array_foreach(p, name->providers) {
 		if (p->pkg->name == must_provide || !p->pkg->ss.pkg_selectable ||
 		    (skip_virtuals && p->version == &apk_atom_null))
 			goto next;
-		apk_array_foreach(d, p->pkg->provides)
+		if (p->pkg->name->ss.new_alternative) {
+			dbg_printf("  skip transitivity check for new_alternative apk\n");
+			goto next;
+		}
+
+		apk_array_foreach(d, p->pkg->provides) {
+			dbg_printf("    provides: %s\n", d->name->name);
 			if (d->name == must_provide || (skip_virtuals && d->version == &apk_atom_null))
 				goto next;
+		}
+
+		if (mp_alternative && p->pkg->alternative) {
+			if (must_provide->ss.new_alternative) {
+				p->pkg->ss.old_alternative = 1;
+				dbg_printf("  old_alternative=1 for "PKG_VER_FMT"\n", PKG_VER_PRINTF(p->pkg));
+				goto next;
+			}
+
+			if (mp_installed && mp_priority == p->pkg->provider_priority) {
+				dbg_printf("  skip disqualify for possible upgrade "PKG_VER_FMT"\n",
+					PKG_VER_PRINTF(p->pkg));
+				goto next;
+			} else if (!mp_installed && mp_priority != p->pkg->provider_priority) {
+				dbg_printf("  skip disqualify when different priority "PKG_VER_FMT"\n",
+					PKG_VER_PRINTF(p->pkg));
+				goto next;
+			}
+		}
 		disqualify_package(ss, p->pkg, "provides transitivity");
 	next: ;
 	}
@@ -531,6 +582,17 @@ static void reconsider_name(struct apk_solver_state *ss, struct apk_name *name)
 		name->name, name->ss.has_options, name->ss.has_auto_selectable, name->ss.reverse_deps_done);
 }
 
+static int check_installed_deps(struct apk_package *pkg)
+{
+	apk_array_foreach(dep, pkg->depends) {
+		apk_array_foreach(p, dep->name->providers) {
+			if (p->pkg->ipkg)
+				return 1;
+		}
+	}
+	return 0;
+}
+
 static int compare_providers(struct apk_solver_state *ss,
 			     struct apk_provider *pA, struct apk_provider *pB)
 {
@@ -605,7 +667,7 @@ static int compare_providers(struct apk_solver_state *ss,
 		    (solver_flags & APK_SOLVERF_INSTALLED)) {
 			r = (pkgA->ipkg != NULL) - (pkgB->ipkg != NULL);
 			if (r) {
-				dbg_printf("    prefer installed\n");
+				dbg_printf("    prefer installed on self-upgrade\n");
 				return r;
 			}
 		}
@@ -633,6 +695,15 @@ static int compare_providers(struct apk_solver_state *ss,
 			return r;
 		}
 
+		/* Prefer new alternative */
+		if (solver_flags & APK_SOLVERF_NEW_ADD) {
+			r = (int)pkgA->name->ss.new_alternative - (int)pkgB->name->ss.new_alternative;
+			if (r) {
+				dbg_printf("    prefer new alternative\n");
+				return r;
+			}
+		}
+
 		/* Prefer installed */
 		if (!(solver_flags & APK_SOLVERF_UPGRADE)) {
 			r = (pkgA->ipkg != NULL) - (pkgB->ipkg != NULL);
@@ -672,6 +743,14 @@ static int compare_providers(struct apk_solver_state *ss,
 		return r;
 	}
 
+	if (pkgA->name->ss.new_alternative && pkgB->name->ss.new_alternative) {
+		r = check_installed_deps(pkgA) - check_installed_deps(pkgB);
+		if (r) {
+			dbg_printf("    prefer new alternative pkg with installed dependencies\n");
+			return r;
+		}
+	}
+
 	/* Prefer highest declared provider priority. */
 	r = pkgA->provider_priority - pkgB->provider_priority;
 	if (r) {
@@ -694,10 +773,15 @@ static int compare_providers(struct apk_solver_state *ss,
 static void assign_name(struct apk_solver_state *ss, struct apk_name *name, struct apk_provider p)
 {
 	if (name->ss.locked) {
+		dbg_printf("assign_name: %s pkg %s provider_priority=%d, new_alternative=%d\n",
+			   name->name, (p.pkg) ? p.pkg->name->name : "null", (p.pkg) ? p.pkg->provider_priority : 0,
+			   name->ss.new_alternative);
+
 		/* If both are providing this name without version, it's ok */
 		if (p.version == &apk_atom_null &&
 		    name->ss.chosen.version == &apk_atom_null)
 			return;
+
 		if (ss->ignore_conflict)
 			return;
 		/* Conflict: providing same name */
@@ -726,8 +810,15 @@ static void assign_name(struct apk_solver_state *ss, struct apk_name *name, stru
 		apk_array_foreach(p0, name->providers) {
 			if (p0->pkg == p.pkg) continue;
 			if (p.version == &apk_atom_null &&
-			    p0->version == &apk_atom_null)
+			    p0->version == &apk_atom_null) {
+				dbg_printf("  no-versions, skip conflicting provides\n");
 				continue;
+			}
+			if (p.pkg && p.pkg->alternative && p0->pkg->alternative &&
+			    !p0->pkg->name->ss.new_alternative && p.pkg->name->ss.new_alternative) {
+				dbg_printf("  reset requirers for %s\n", p0->pkg->name->name);
+				p0->pkg->name->ss.requirers = 0;
+			}
 			disqualify_package(ss, p0->pkg, "conflicting provides");
 		}
 	}
@@ -775,6 +866,13 @@ static void select_package(struct apk_solver_state *ss, struct apk_name *name)
 
 	pkg = chosen.pkg;
 	if (pkg) {
+		if (pkg->alternative && (pkg->ss.old_alternative || !pkg->ss.pkg_selectable)) {
+			dbg_printf("reset " PKG_VER_FMT " alternative pkg, selectable=%d\n",
+				PKG_VER_PRINTF(pkg), pkg->ss.pkg_selectable);
+			assign_name(ss, name, provider_none);
+			return;
+		}
+
 		if (!pkg->ss.pkg_selectable || !pkg->ss.tag_ok) {
 			/* Selecting broken or unallowed package */
 			mark_error(ss, pkg, "broken package / tag not ok");
@@ -826,6 +924,10 @@ static void cset_track_deps_added(struct apk_package *pkg)
 	apk_array_foreach(d, pkg->depends) {
 		if (apk_dep_conflict(d) || !d->name->ss.installed_name) continue;
 		d->name->ss.installed_name->ss.requirers++;
+		dbg_printf("cset_track_deps_added: %s, installed name %s req %d\n",
+			d->name->name,
+			d->name->ss.installed_name->name,
+			d->name->ss.installed_name->ss.requirers);
 	}
 }
 
-- 
2.25.1

