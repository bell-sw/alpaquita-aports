From b9d32ed57da34259629f107c13ca337edd325f58 Mon Sep 17 00:00:00 2001
From: Dmitry Klochkov <dmitry.klochkov@bell-sw.com>
Date: Wed, 27 Dec 2023 16:58:59 +0300
Subject: [PATCH] tests: run abuild with exported APKBUILD=

If there is an exported non-empty variable $APKBUILD, its value will override
the default APKBUILD file path './APKBUILD' which tests rely on.
---
 test/alpine/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/alpine/Makefile b/test/alpine/Makefile
index b8a17302..4f1ea8f0 100644
--- a/test/alpine/Makefile
+++ b/test/alpine/Makefile
@@ -22,7 +22,7 @@ all: alpine-tests
 $(repos):
 	echo "Building $@"
 	@cd "$@" && for i in */APKBUILD; do \
-		(cd $${i%/*} && REPODEST="$$PWD/../.." abuild -r) || exit 1; \
+		(cd $${i%/*} && REPODEST="$$PWD/../.." APKBUILD= abuild -r) || exit 1; \
 	done
 
 clean:
-- 
2.53.0

