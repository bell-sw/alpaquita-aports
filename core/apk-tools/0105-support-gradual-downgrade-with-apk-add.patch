--- a/src/apk_solver_data.h
+++ b/src/apk_solver_data.h
@@ -40,6 +40,7 @@ struct apk_solver_name_state {
 	unsigned has_virtual_provides : 1;
 	unsigned has_auto_selectable : 1;
 	unsigned new_alternative : 1;
+	unsigned new_downgrade : 1;
 };
 
 struct apk_solver_package_state {
diff --git a/src/app_add.c b/src/app_add.c
index 0c9986d..80859ec 100644
--- a/src/app_add.c
+++ b/src/app_add.c
@@ -26,6 +26,7 @@ struct add_ctx {
 	OPT(OPT_ADD_no_chown,   "no-chown") \
 	OPT(OPT_ADD_upgrade,	APK_OPT_SH("u") "upgrade") \
 	OPT(OPT_ADD_usermode,	"usermode") \
+	OPT(OPT_ADD_downgrade,	APK_OPT_SH("d") "downgrade") \
 	OPT(OPT_ADD_virtual,	APK_OPT_ARG APK_OPT_SH("t") "virtual")
 
 APK_OPTIONS(add_options_desc, ADD_OPTIONS);
@@ -48,6 +49,9 @@ static int add_parse_option(void *ctx, struct apk_ctx *ac, int opt, const char *
 	case OPT_ADD_upgrade:
 		actx->solver_flags |= APK_SOLVERF_UPGRADE;
 		break;
+	case OPT_ADD_downgrade:
+		actx->solver_flags |= APK_SOLVERF_DOWNGRADE;
+		break;
 	case OPT_ADD_virtual:
 		actx->virtpkg = optarg;
 		break;
diff --git a/src/solver.c b/src/solver.c
index 1a658d6..44796bc 100644
--- a/src/solver.c
+++ b/src/solver.c
@@ -208,18 +208,24 @@ static void discover_name(struct apk_solver_state *ss, struct apk_name *name)
 				!pkg->ipkg &&
 				(pkg->ss.solver_flags & APK_SOLVERF_NEW_ADD);
 
-			dbg_printf("discover " PKG_VER_FMT ": tag_ok=%d, tag_pref=%d selectable=%d solver_flags=%x alternative=%d(%d)\n",
+			pkg->name->ss.new_downgrade =
+				(pkg->ss.solver_flags & APK_SOLVERF_NEW_DOWNGRADE) == APK_SOLVERF_NEW_DOWNGRADE;
+
+			dbg_printf("discover " PKG_VER_FMT
+				": tag_ok=%d, tag_pref=%d selectable=%d solver_flags=%x alternative=%d(%d) downgrade=%d\n",
 				PKG_VER_PRINTF(pkg),
 				pkg->ss.tag_ok,
 				pkg->ss.tag_preferred,
 				pkg->ss.pkg_selectable,
 				pkg->ss.solver_flags,
 				pkg->alternative,
-				pkg->name->ss.new_alternative);
+				pkg->name->ss.new_alternative,
+				pkg->name->ss.new_downgrade);
 		}
 
 		name->ss.no_iif &= pkg->ss.iif_failed;
 		num_virtual += (p->pkg->name != name);
+		name->ss.new_downgrade |= pkg->name->ss.new_downgrade;
 	}
 
 	apk_array_foreach_item(name0, name->rinstall_if)
@@ -240,9 +246,9 @@ static void discover_name(struct apk_solver_state *ss, struct apk_name *name)
 			discover_name(ss, dep->name);
 	}
 
-	dbg_printf("discover %s: no_iif=%d num_virtual=%d, order_id=%d new_alternative=%d\n",
+	dbg_printf("discover %s: no_iif=%d num_virtual=%d, order_id=%d new_alternative=%d new_downgrade=%d\n",
 		name->name, name->ss.no_iif, num_virtual, name->ss.order_id,
-		name->ss.new_alternative);
+		name->ss.new_alternative, name->ss.new_downgrade);
 }
 
 static void name_requirers_changed(struct apk_solver_state *ss, struct apk_name *name)
@@ -662,7 +668,7 @@ static int compare_providers(struct apk_solver_state *ss,
 		}
 
 		/* Prefer installed */
-		if (!(solver_flags & APK_SOLVERF_UPGRADE)) {
+		if (!(solver_flags & APK_SOLVERF_UP_OR_DOWNGRADE)) {
 			r = (pkgA->ipkg != NULL) - (pkgB->ipkg != NULL);
 			if (r) {
 				dbg_printf("    prefer installed\n");
@@ -786,14 +792,28 @@ static void assign_name(struct apk_solver_state *ss, struct apk_name *name, stru
 		reevaluate_reverse_installif(ss, name);
 }
 
+static struct apk_provider *apk_get_installed_provider(struct apk_name *name)
+{
+	apk_array_foreach(p, name->providers) {
+		if (p->pkg->ipkg) {
+			dbg_printf("found installed pkg "PKG_VER_FMT"\n", PKG_VER_PRINTF(p->pkg));
+			return p;
+		}
+	}
+	return NULL;
+}
+
 static void select_package(struct apk_solver_state *ss, struct apk_name *name)
 {
-	struct apk_provider chosen = { NULL, &apk_atom_null };
+	struct apk_provider chosen = { NULL, &apk_atom_null }, *ip = NULL;
 	struct apk_package *pkg = NULL;
 
 	dbg_printf("select_package: %s (requirers=%d, autosel=%d, iif=%d)\n", name->name, name->ss.requirers, name->ss.has_auto_selectable, name->ss.has_iif);
 
 	if (name->ss.requirers || name->ss.has_iif) {
+		if (name->ss.new_downgrade)
+			ip = apk_get_installed_provider(name);
+
 		apk_array_foreach(p, name->providers) {
 			dbg_printf("  consider "PKG_VER_FMT" iif_triggered=%d, tag_ok=%d, selectable=%d, available=%d, flags=0x%x, provider_priority=%d, installed=%d\n",
 				PKG_VER_PRINTF(p->pkg),
@@ -813,11 +833,28 @@ static void select_package(struct apk_solver_state *ss, struct apk_name *name)
 				dbg_printf("    ignore: virtual package without provider_priority\n");
 				continue;
 			}
+
+			if (ip) {
+				switch (apk_version_compare(*p->pkg->version, *ip->pkg->version)) {
+				case APK_VERSION_GREATER:
+				case APK_VERSION_EQUAL:
+					dbg_printf("    downgrade: ignore "PKG_VER_FMT" version >= installed version\n",
+						PKG_VER_PRINTF(p->pkg));
+					continue;
+				}
+			}
+
 			if (compare_providers(ss, p, &chosen) > 0) {
 				dbg_printf("    choose as new provider\n");
 				chosen = *p;
 			}
 		}
+
+		if (ip && !chosen.pkg) {
+			dbg_printf("  pkg for downgrade not found, choose installed "PKG_VER_FMT"\n",
+				PKG_VER_PRINTF(ip->pkg));
+			chosen = *ip;
+		}
 	}
 
 	pkg = chosen.pkg;
