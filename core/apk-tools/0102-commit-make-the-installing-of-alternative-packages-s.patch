From 6bb4efe47a40103eba97763d218ee691ae6948a2 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Tue, 1 Mar 2022 16:39:21 +0300
Subject: [PATCH] commit: make the installing of alternative packages safer

Move the removal of old alternative packages to the end and
exit at the first error when installing a new alternative
package.
---
 src/commit.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/src/commit.c b/src/commit.c
index 6f6f3136..715357d8 100644
--- a/src/commit.c
+++ b/src/commit.c
@@ -384,6 +384,12 @@ int apk_solver_precache_changeset(struct apk_database *db, struct apk_changeset
 	return prog.done.packages;
 }
 
+static void swap_pkg_change(struct apk_change_array **changes, struct apk_change *change)
+{
+	apk_change_array_add(changes, *change);
+	change->old_pkg = NULL;
+}
+
 int apk_solver_commit_changeset(struct apk_database *db,
 				struct apk_changeset *changeset,
 				struct apk_dependency_array *world)
@@ -476,10 +482,29 @@ int apk_solver_commit_changeset(struct apk_database *db,
 	if (run_commit_hooks(db, PRE_COMMIT_HOOK) == -2)
 		return -1;
 
+	if (changeset->num_remove) {
+		struct apk_change_array *remove_changes = NULL;
+
+		apk_array_foreach(change, changeset->changes) {
+			if (change->new_pkg || !change->old_pkg || !change->old_pkg->alternative)
+				continue;
+			if (!remove_changes)
+				apk_change_array_init(&remove_changes);
+			swap_pkg_change(&remove_changes, change);
+		}
+		if (remove_changes) {
+			apk_array_foreach(change, remove_changes)
+				swap_pkg_change(&changeset->changes, change);
+			apk_change_array_free(&remove_changes);
+		}
+	}
+
 	/* Go through changes */
 	db->indent_level = 1;
 	apk_progress_start(&prog.prog, out, "install", apk_progress_weight(prog.total.bytes, prog.total.packages));
 	apk_array_foreach(change, changeset->changes) {
+		if (!change->old_pkg && !change->new_pkg)
+			continue;
 		r = change->old_pkg &&
 			(change->old_pkg->ipkg->broken_files ||
 			 change->old_pkg->ipkg->broken_script);
@@ -490,6 +515,8 @@ int apk_solver_commit_changeset(struct apk_database *db,
 				if (!(db->ctx->flags & APK_SIMULATE))
 					r = apk_db_install_pkg(db, change->old_pkg, change->new_pkg, &prog.prog) != 0;
 				apk_progress_item_end(&prog.prog);
+				if (r && change->new_pkg && change->new_pkg->alternative)
+					return -1;
 			}
 			if (change->new_pkg && change->new_pkg->ipkg)
 				change->new_pkg->ipkg->repository_tag = change->new_repository_tag;
-- 
2.53.0

