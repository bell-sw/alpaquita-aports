# Description: apk-tools provides instruments to work with packages:
# install, upgrade, or delete them.

pkgname=apk-tools
pkgver=3.0.0_rc7
_commit=4369278256670e3c691dd5c834d8f828e03a31b3
pkgrel=0
pkgdesc="APK Package Manager (Derivative from Alpine Package Keeper)"
arch="all"
url="https://gitlab.alpinelinux.org/alpine/apk-tools"
license="GPL-2.0-only"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc $pkgname-zsh-completion libapk"
# Musl 1.2 introduced new ABI for time64 => upgrading apk-tools
# while staying on musl <1.2 causes missing symbols
# starting with musl 1.2.4 and glibc 2.37, we added DT_RELR
# it is possible for old systems to upgrade, and apk-tools would upgrade first,
# which would upgrade to a binary that cannot run until musl/glibc is upgraded.
# forcing this constraint makes apk upgrade musl/glibc as part of the 'critical' transaction,
# and update musl/glibc first.
# openssl 3.5(?) introduced new symbols:
# https://gitlab.alpinelinux.org/alpine/aports/-/issues/17199
depends="
	musl:musl>=1.2.4
	libcrypto3>=3.5
	glibc:glibc>=2.39.0
	libapk=$pkgver-r$pkgrel
	"
_lua="5.3"
makedepends_build="meson openssl-dev>=3.5 lua$_lua lua$_lua-lzlib scdoc"
makedepends_host="
	linux-headers
	openssl-dev
	zlib-dev
	zstd-dev
	"
checkdepends="cmocka-dev"
if [ -z "$BOOTSTRAP" ]; then
	subpackages="$subpackages lua$_lua-apk:luaapk py3-apk:pyapk"
	makedepends_host="$makedepends_host lua$_lua-dev python3-dev"

	# ca-certificates-bundle needed for https certificate validation
	depends="$depends ca-certificates-bundle"
fi
source="https://gitlab.alpinelinux.org/alpine/apk-tools/-/archive/$_commit/apk-tools-v$pkgver.tar.gz
	repo-hash-sha1.patch
	_apk
	0100-Get-rid-of-separation-of-sbin-lib-and-their-usr-coun.patch
	0101-add-alternative-packages-support.patch
	0102-commit-make-the-installing-of-alternative-packages-s.patch
	0103-alternative-packages-tests.patch
	0104-solver-clean-db-when-removing-alternative-pkg.patch
	0105-support-gradual-downgrade-with-apk-add.patch
	0106-apk-search-sorted-output.patch
	0107-reset-sigpipe-handler-to-default-when-running-script.patch
	0108-retry-fetch-on-http-timeout-errors.patch
	0109-database-verify-old-file-onwers-with-fallback-paths.patch
	0110-tests-add-new-test-with-symlinks.patch
	0111-tests-run-abuild-with-exported-APKBUILD.patch
	0112-adjust-user-tests.patch
	"
builddir="$srcdir/apk-tools-$_commit"

# secfixes:
#   2.12.6-r0:
#     - CVE-2021-36159
#   2.12.5-r0:
#     - CVE-2021-30139

build() {
	export VERSION=$pkgver-r$pkgrel

	abuild-meson \
		--auto-features=disabled \
		--bindir=/usr/sbin \
		-Darch="$CARCH" \
		-Ddocs=enabled \
		-Dhelp=enabled \
		-Dlua_version=$_lua \
		-Dlua="$([ -z "$BOOTSTRAP" ] && echo enabled || echo disabled)" \
		-Dpython="$([ -z "$BOOTSTRAP" ] && echo enabled || echo disabled)" \
		-Dtests="$(want_check && echo enabled || echo disabled)" \
		output
	ninja -C output
}

check() {
	meson test --print-errorlogs -C output

	# /lib/bin/sbin symlink test
	make -C test/alpine
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -d "$pkgdir"/var/lib/apk/db \
		"$pkgdir"/var/lib/apk/exec \
		"$pkgdir"/etc/apk/keys \
		"$pkgdir"/etc/apk/protected_paths.d

	install -Dm644 "$srcdir"/_apk "$pkgdir"/usr/share/zsh/site-functions/_apk
}

libapk() {
	provides="libapk2=$pkgver-r$pkgrel"
	depends=""
	amove usr/lib/libapk.so.*
}

luaapk() {
	pkgshortdesc="Lua module for apk-tools"
	depends="$depends libapk2=$pkgver-r$pkgrel"
	amove usr/lib/lua
}

pyapk() {
	pkgdesc="Python module for apk-tools"
	depends=""
	amove usr/lib/python*
}

