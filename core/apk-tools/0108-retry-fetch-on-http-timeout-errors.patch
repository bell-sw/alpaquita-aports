From 96f6c93ccea07f8d4e63f6545ca2dc858afea1d6 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Tue, 28 Mar 2023 16:24:27 +0000
Subject: [PATCH] retry fetch on http timeout errors

Also, reinitialize 'struct url' to avoid any side effects
as fetchXGet() can change the struct members.
---
 libfetch/fetch.h      |  1 +
 src/io_url_libfetch.c | 12 ++++++++++++
 2 files changed, 13 insertions(+)

diff --git a/libfetch/fetch.h b/libfetch/fetch.h
index 739cfc3..7637ced 100644
--- a/libfetch/fetch.h
+++ b/libfetch/fetch.h
@@ -86,6 +86,7 @@ enum {
 	FETCH_OK = 0,
 	FETCH_ERR_UNKNOWN,
 	FETCH_ERR_UNCHANGED,
+	FETCH_ERR_GWTIMEOUT,
 
 	/* Error URL category codes */
 	FETCH_ERR_URL_MALFORMED = 1,
diff --git a/src/io_url_libfetch.c b/src/io_url_libfetch.c
index c77e3c2..f8ee891 100644
--- a/src/io_url_libfetch.c
+++ b/src/io_url_libfetch.c
@@ -41,6 +41,7 @@ static int fetch_maperror(struct fetch_error fe)
 		{ FETCH_OK,			0, },
 		{ FETCH_ERR_UNKNOWN,		EIO },
 		{ FETCH_ERR_UNCHANGED,		APKE_FILE_UNCHANGED },
+		{ FETCH_ERR_GWTIMEOUT,		ETIMEDOUT },
 	};
 	static const struct maperr tls_err[] = {
 		{ FETCH_ERR_TLS,			APKE_TLS_ERROR },
@@ -134,7 +135,9 @@ struct apk_istream *apk_io_url_istream(const char *url, time_t since)
 	char *flags = "Ci";
 	fetchIO *io = NULL;
 	int rc = -EIO;
+	int fetch_attempts = 5;
 
+retry:
 	u = fetchParseURL(url);
 	if (!u) {
 		rc = -APKE_URL_FORMAT;
@@ -153,6 +156,15 @@ struct apk_istream *apk_io_url_istream(const char *url, time_t since)
 
 	io = fetchXGet(u, &fis->urlstat, flags);
 	if (!io) {
+		/* We may intermittently receive 408/504 (Request/Gateway-Proxy timeout)
+		 * HTTP errors. So try to fetch again in this particular case.
+		 */
+		if (fetchLastErrCode.category == FETCH_ERRCAT_FETCH &&
+		    fetchLastErrCode.code == FETCH_ERR_GWTIMEOUT && fetch_attempts--) {
+			fetchFreeURL(u);
+			free(fis);
+			goto retry;
+		}
 		rc = -fetch_maperror(fetchLastErrCode);
 		goto err;
 	}
-- 
2.25.1

