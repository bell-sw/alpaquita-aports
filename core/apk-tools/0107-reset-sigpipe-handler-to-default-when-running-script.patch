From c728014200cbb60126f66d21f14c89133853e34a Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Thu, 2 Jun 2022 11:39:46 +0300
Subject: [PATCH] reset sigpipe handler to default when running scripts

---
 src/database.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/database.c b/src/database.c
index bce4b94..b47dbeb 100644
--- a/src/database.c
+++ b/src/database.c
@@ -2438,6 +2438,7 @@ int apk_db_run_script(struct apk_database *db, const char *hook_type, const char
 		goto err;
 	}
 	if (pid == 0) {
+		signal(SIGPIPE, SIG_DFL);
 		umask(0022);
 		if (fchdir(db->root_fd) != 0) script_panic("fchdir");
 		if (!(ac->flags & APK_NO_CHROOT)) {
-- 
