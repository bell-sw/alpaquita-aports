From b0b11b3d7369f33476cdb2f60600a08232ffdfed Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Thu, 2 Jun 2022 11:39:46 +0300
Subject: [PATCH] reset sigpipe handler to default when running scripts

---
 src/database.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/database.c b/src/database.c
index 99836a69..a7e3afc2 100644
--- a/src/database.c
+++ b/src/database.c
@@ -2525,6 +2525,7 @@ int apk_db_run_script(struct apk_database *db, const char *hook_type, const char
 		goto err;
 	}
 	if (pid == 0) {
+		signal(SIGPIPE, SIG_DFL);
 		umask(0022);
 		if (fchdir(db->root_fd) != 0) script_panic("fchdir");
 		if (!(ac->flags & APK_NO_CHROOT)) {
