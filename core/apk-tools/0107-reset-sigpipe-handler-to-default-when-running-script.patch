From af1c468ed01cfdf6e8d2d12c96b99a76dc763af9 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Thu, 2 Jun 2022 11:39:46 +0300
Subject: [PATCH] reset sigpipe handler to default when running scripts

---
 src/database.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/database.c b/src/database.c
index 7939c8d..482d141 100644
--- a/src/database.c
+++ b/src/database.c
@@ -1933,6 +1933,7 @@ int apk_db_run_script(struct apk_database *db, char *fn, char **argv)
 		return -2;
 	}
 	if (pid == 0) {
+		signal(SIGPIPE, SIG_DFL);
 		umask(0022);
 
 		if (fchdir(db->root_fd) != 0) {
-- 
