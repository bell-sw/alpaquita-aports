From 4da5ebf9a01372dc385e98acfd04d21195a7deff Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Tue, 15 Jul 2025 16:09:46 +0000
Subject: [PATCH] adjust user/* tests

---
 test/user/query.sh    | 4 ++--
 test/user/replaces.sh | 2 +-
 test/user/uvol.sh     | 6 +++---
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/test/user/query.sh b/test/user/query.sh
index e9479f25..9fa608c3 100755
--- a/test/user/query.sh
+++ b/test/user/query.sh
@@ -5,7 +5,7 @@ TESTDIR=$(realpath "${TESTDIR:-"$(dirname "$0")"/..}")
 
 installed_db="$(realpath "$(dirname "$0")/query-installed.data")"
 setup_apkroot
-cp "$installed_db" "$TEST_ROOT"/lib/apk/db/installed
+cp "$installed_db" "$TEST_ROOT"/var/lib/apk/db/installed
 
 APK="$APK --no-network"
 
@@ -142,7 +142,7 @@ $APK query --format yaml --installed --fields all "apk-tools" 2>&1 | diff -u /de
     - so:libapk.so.2.14.0=2.14.0
     - cmd:apk=2.14.6-r3
   repositories:
-    - lib/apk/db/installed
+    - var/lib/apk/db/installed
   reverse-depends:
     - alpine-base
   reverse-install-if:
diff --git a/test/user/replaces.sh b/test/user/replaces.sh
index 6eead1a4..ed2a2e4e 100755
--- a/test/user/replaces.sh
+++ b/test/user/replaces.sh
@@ -40,7 +40,7 @@ $APK query --format yaml --fields name,tags,repositories a  | diff -u /dev/fd/4
     - tagA
     - tagB
   repositories:
-    - lib/apk/db/installed
+    - var/lib/apk/db/installed
 EOF
 
 $APK add b-1.0.apk && assert "should error with conflicting file"
diff --git a/test/user/uvol.sh b/test/user/uvol.sh
index 607199ff..596cef4a 100755
--- a/test/user/uvol.sh
+++ b/test/user/uvol.sh
@@ -14,9 +14,9 @@ EOF
 }
 
 reset_uvol_db() {
-	rm -rf "$TEST_ROOT/lib/apk/db-uvol"
-	mkdir -p "$TEST_ROOT/lib/apk/db-uvol"
-	touch "$TEST_ROOT/lib/apk/db-uvol/world"
+	rm -rf "$TEST_ROOT/var/lib/apk/db-uvol"
+	mkdir -p "$TEST_ROOT/var/lib/apk/db-uvol"
+	touch "$TEST_ROOT/var/lib/apk/db-uvol/world"
 }
 
 setup_apkroot
-- 
2.53.0

