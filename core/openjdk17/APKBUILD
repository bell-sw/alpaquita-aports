6e0c99ed1824eabd7cde3f32a4370dffbe4cb8c24137bf3d087a5cb7a694ce191efab9162ae18b9aabda44523a7ef92826446485f9a3a898573604f31283a1ac  src-linux-alpaquita-musl-aarch64-17.0.20.1+1-r$pkgrel.tar.gz
"
		;;
	esac

fi

source="
	$JDK_BIN
	HelloJava.java
"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib"

_jre_tools="
	java
	keytool
	rmiregistry
	"

if [ "$BUILD_FROM_SOURCE" -ne 0 ]; then
	# To build from sources - build with openjdk17-bootstrap, provided by a
	# previous version of this package
	makedepends="$makedepends
		openjdk17-bootstrap
		"
fi

