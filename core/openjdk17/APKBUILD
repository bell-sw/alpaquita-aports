0a1d010558637c7d5074df0ddc963fc56a6059f9e7d60cd97e7cfabb62363b90a68aaafb3f9d1fed4d8318b44b906a5471f022e1d9395883a7bca357374afd4a  src-linux-alpaquita-musl-aarch64-17.0.21.1+5-r$pkgrel.tar.gz
"
		;;
	esac

fi

source="
	$JDK_BIN
	HelloJava.java
"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib"

_jre_tools="
	java
	keytool
	rmiregistry
	"

if [ "$BUILD_FROM_SOURCE" -ne 0 ]; then
	# To build from sources - build with openjdk17-bootstrap, provided by a
	# previous version of this package
	makedepends="$makedepends
		openjdk17-bootstrap
		"
fi

