# Description: $VENDOR_NAME $VENDOR_JAVA_NAME is a build of OpenJDK verified by the OpenJDK
# Technology Compatibility Kit test suite to be compliant with the Java SE
# specifications.

: ${BUILD_FROM_SOURCE:=0}

_java_pkg_name=$(echo $VENDOR_JAVA_NAME | tr [:upper:] [:lower:])
_java_ver=17.0.19+11
_java_rel_date=2026-04-21
_java_name="$VENDOR_NAME $VENDOR_JAVA_NAME JDK 17"

pkgname=${_java_pkg_name}17
pkgver=${_java_ver/+/_p}
pkgrel=0
pkgdesc="$_java_name"
url="$VENDOR_URL"
license="GPL-2.0 WITH Classpath-Exception-2.0"
arch="aarch64 x86_64"
options="!strip ldpath-recursive !tracedeps !annobin"
annocheck_skip="libsyslookup.so"
depends="$pkgname-doc=$pkgver-r$pkgrel $pkgname-jdk=$pkgver-r$pkgrel"

# NB: openjdk17-bootstrap is added to makedepends separately, only if
# not bootstrapping the first package from prebuilt binaries
makedepends="
	alsa-lib-dev
	automake
	autoconf
	bash
	ca-certificates
	coreutils
	cups-dev
	file
	findutils
	fontconfig-dev
	freetype-dev
