_java_ver=21.0.7+13
_java_rel_date=2025-04-15
_java_name="$VENDOR_NAME $VENDOR_JAVA_NAME JDK 21"

pkgname=${_java_pkg_name}21
pkgver=${_java_ver/+/_p}
pkgrel=0
pkgdesc="$_java_name"
url="$VENDOR_URL"
