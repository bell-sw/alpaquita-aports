	local srcdir="$(_lang_native_dir WASM graalwasm wasm)"
	local dstdir=$_nikdir/wasm-native-openjdk${_javamajor}-${pkgver}

	mkdir -p "$subpkgdir"/${dstdir}
	cp -a "$srcdir"/. "$subpkgdir"/${dstdir}
}

sha512sums="
$NIK_SHA
"
