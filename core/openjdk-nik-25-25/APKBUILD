	${pkgname}-js:_js
	${pkgname}-js-native:_js_native
	${pkgname}-llvm-core:_llvm_core
	${pkgname}-llvm-core-native:_llvm_core_native
	${pkgname}-nodejs:_nodejs
	${pkgname}-nodejs-native:_nodejs_native
