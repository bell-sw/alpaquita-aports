makedepends=
if [ "${BUILD_FROM_SOURCE}" -ne 0 ]; then
	makedepends="
		openjdk$_javamajor~$_javaver
		openjdk$_javamajor-jmods~$_javaver
		openjdk$_javamajor-libs-static~$_javaver
		openjdk$_javamajor-src~$_javaver
	"
fi

makedepends="
	$makedepends
	bash
	bzip2-dev
	cmake
	coreutils
	curl-dev
	diffutils
	ed
	gfortran
	git
