pkgname=distro-installer
pkgver=0.9.5
pkgrel=0
pkgdesc="$VENDOR_DISTRO_NAME Linux Installer"
url="$VENDOR_URL"
arch="noarch"
license="AGPL-3.0-or-later"
depends="
	blkid
	bonding
	cryptsetup
	dosfstools
	e2fsprogs
	hwids-pci
	hwids-usb
	ifupdown-ng-wifi
	kmod
	lsblk
	lvm2
	mdadm
	mdadm-udev
	parted
	py3-attrs
	py3-passlib
	py3-urwid
	py3-yaml
	python3
	sfdisk
	tzdata
	wipefs
	xfsprogs
"
makedepends="py3-setuptools"
builddir="$srcdir/alpaquero-$pkgver"
provides="$VENDOR_DISTRO-installer=$pkgver-r$pkgrel"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/bell-sw/alpaquero/archive/refs/tags/v$pkgver.tar.gz
	https://raw.githubusercontent.com/bell-sw/alpaquita-aports/stream/core/distro-keys/info@bell-sw.com-60a2aed7.rsa.pub
	https://raw.githubusercontent.com/bell-sw/alpaquita-aports/stream/core/distro-keys/info@bell-sw.com-61c66027.rsa.pub
	https://raw.githubusercontent.com/bell-sw/alpaquita-aports/stream/core/distro-keys/info@bell-sw.com-66b9cb80.rsa.pub
	https://raw.githubusercontent.com/bell-sw/alpaquita-aports/stream/core/distro-keys/info@bell-sw.com-66b9cb81.rsa.pub
	"

_set_vendor() {
	local distro_file='alpaquero/app/distro.py'
	local readme_file='README.md'
	local setup_file='setup.py'

	sed -i -E \
		-e "s/^[[:space:]]*(DISTRO)[[:space:]]*=.*/\\1='$VENDOR_DISTRO'/" \
		-e "s/^[[:space:]]*(DISTRO_NAME)[[:space:]]*=.*/\\1='$VENDOR_DISTRO_NAME Linux'/" \
		-e "s,^[[:space:]]*(DISTRO_REPO_BASE_URL)[[:space:]]*=.*,\\1='${VENDOR_REPO_BASE_URL%/}'," \
		"$distro_file"

	sed -i -E \
		-e "s/\\w+(-like Linux)/$VENDOR_DISTRO_NAME\\1/" \
		-e "s/(configured to work with )\\w+/\\1$VENDOR_DISTRO_NAME/" \
		"$readme_file"

	sed -i -E \
		-e "/description=/s/\\w+(-like Linux)/$VENDOR_DISTRO_NAME\\1/" \
		"$setup_file"
}

build() {
	_set_vendor

	local apk_keys_glibc=""
	local apk_keys_musl=""
	case "$CARCH" in
	x86_64)
		apk_keys_glibc="info@bell-sw.com-61c66027.rsa.pub"
		apk_keys_musl="info@bell-sw.com-60a2aed7.rsa.pub"
		;;
	aarch64)
		apk_keys_glibc="info@bell-sw.com-66b9cb81.rsa.pub"
		apk_keys_musl="info@bell-sw.com-66b9cb80.rsa.pub"
		;;
	esac
	local key
	for key in $apk_keys_glibc; do
		install -v -D -m 0644 "${srcdir}/${key}" -t alpaquero/keys/glibc/
	done
	for key in $apk_keys_musl; do
		install -v -D -m 0644 "${srcdir}/${key}" -t alpaquero/keys/musl/
	done

	python3 setup.py build
}

check() {
	python3 setup.py check
}

package() {
	python3 setup.py install --prefix=/usr --root="$pkgdir"

	mv "$pkgdir/usr/bin/alpaquero" "$pkgdir/usr/bin/$pkgname"
	ln -s "$pkgname" "$pkgdir/usr/bin/$VENDOR_DISTRO-installer"

	mkdir -p "$pkgdir/usr/share/doc/$pkgname"
	for _doc in *.md; do
		install -m 0644 $_doc "$pkgdir/usr/share/doc/$pkgname"
	done
}

