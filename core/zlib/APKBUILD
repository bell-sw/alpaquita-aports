# Description: general-purpose library for lossless data compression without
# data expansion.

pkgname=zlib
pkgver=1.3.2
pkgrel=1
pkgdesc="Library for data compression"
arch="all"
license="Zlib"
url="https://zlib.net/"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="https://zlib.net/fossils/zlib-$pkgver.tar.gz

	0100-CVE-2026-85091.patch
	"

# secfixes:
#   1.3.2-r1:
#     - CVE-2026-85091
#   1.3.2-r0:
#     - CVE-2026-27171
#   1.2.12-r2:
#     - CVE-2022-37434
#   1.2.11-r4:
#     - CVE-2018-25032
#   0:
#     - CVE-2023-45853
#     - CVE-2023-6992
#     - CVE-2026-22184

build() {
	# we trade size for a little more speed.
	export CFLAGS="$CFLAGS -O2"
	CHOST="$CHOST" ./configure \
		--prefix=/usr \
		--shared \
		--disable-crcvx
	make
}

check() {
	make check
}

package() {
	make install DESTDIR="$pkgdir"
}

