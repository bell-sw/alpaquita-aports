# Description:

pkgname=libxcrypt
pkgver=4.5.0
pkgrel=0
pkgdesc="Modern library for one-way hashing of passwords"
url="https://github.com/besser82/libxcrypt/"
arch="all"
license="LGPL"
options="!libc_musl"
makedepends="autoconf automake libtool perl"
subpackages="
	$pkgname-static
	$pkgname-dev
	$pkgname-doc
	$pkgname-compat:compat
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/besser82/libxcrypt/archive/refs/tags/v$pkgver.tar.gz"

_build() {
	local build_path=$1
	shift

	mkdir -p $build_path
	cd $build_path

	../configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--enable-hashes=strong,glibc \
		--disable-failure-tokens \
		$@
	make

	cd ..
}

build() {
	./autogen.sh
	_build build-new-api \
		--enable-obsolete-api=no \
		--enable-static

	_build build-compat \
		--enable-obsolete-api=glibc \
		--disable-static
}

check() {
	make -C build-new-api check
	make -C build-compat check
}

package() {
	make -C build-new-api DESTDIR="$pkgdir/" install
}

dev() {
	replaces="glibc-dev<2.39.0"
	default_dev
}

static() {
	replaces="glibc-dev<2.39.0"
	default_static
}

compat() {
	pkgdesc='Modern library for one-way hashing of passwords (legacy API functions)'
	depends="glibc>=2.39.0"

	make -C "$builddir/build-compat" DESTDIR="$subpkgdir/" install
	rm -rf \
		"$subpkgdir"/usr/include \
		"$subpkgdir"/usr/share \
		"$subpkgdir"/usr/lib/pkgconfig \
		"$subpkgdir"/usr/lib/*.so
}

sha512sums="
e66f78adda1989e635d8df3f0273816c979d9bcb0396ed8bfa326541e7e8e0d092d63d19dba3dd5aafb887f74eff835d344d4cffc0a98d7e8ee8b2de3b88fabc  libxcrypt-4.5.0.tar.gz
"
