# Description: openntpd enables clock synchronization with NTP servers; it can
# also act as an NTP server.

pkgname=openntpd
pkgver=7.9_p1
_pkgver=${pkgver/_/}
pkgrel=0
pkgdesc="OpenBSD NTP implementation"
url="https://openntpd.org/"
subpackages="openntpd-doc openntpd-openrc"
makedepends="linux-headers bsd-compat-headers
	autoconf automake libtool byacc"
arch="all"
license="ISC"
options="!check"
source="https://ftp.openbsd.org/pub/OpenBSD/OpenNTPD/openntpd-$_pkgver.tar.gz
	ntp-user.patch
	$pkgname.confd
	$pkgname.initd
	"
builddir="$srcdir/$pkgname-$_pkgver"

prepare() {
	default_prepare
	autoreconf -vif
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--localstatedir=/var \
		--mandir=/usr/share/man \
		--sysconfdir=/etc \
		--with-privsep-user=ntp \
		--enable-https-constraint
	make
}

package() {
	make install DESTDIR="$pkgdir"

	install -Dm755 "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/"$pkgname"
	install -Dm644 "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/"$pkgname"
	rmdir "$pkgdir"/var/run
}

