_doc() {
	pkgdesc="$_java_name (Documentation)"
	depends="$pkgname-jre-doc=$pkgver-r$pkgrel"
	provides="openjdk11-lite-doc=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir/$_java_home"
	mv "$pkgdir/$_java_home/man" "$subpkgdir/$_java_home/"
