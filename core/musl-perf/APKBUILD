# Description: standard C Library designed for Linux. Designed to allow
# efficient static linking and to have realtime-quality robustness by avoiding
# race conditions, internal failures on resource exhaustion, various other
# bad worst-case behaviors present in existing implementations and performance
# enhancements including glibc-string library (glibc asm-optimized string
# functions, such as memcpy(), memset(), memmove(), etc).

pkgname=musl-perf
pkgver=1.2.6
pkgrel=7
_mimalloc_ver=2.5.2
pkgdesc="the musl c library (libc) implementation (optimized for performance)"
url="https://musl.libc.org/"
arch="aarch64 x86_64"
#
# License clarification:
#
# musl-perf libraries are based on musl libc and statically linked with
# glibc-string library. The package is distributed under the MIT license.
#
# In addition, the musl-perf-dev package provides a separate libc-noglibc-string.a
# library derived from musl libc without glibc-string code and distributed under
# the MIT license.
#
# glibc-string package (musl-perf-dev dependency) provides static libglibc-string.a
# file derived from glibc, distributed under the LGPL-2.1-or-later license.
#
license="MIT"
depends_dev="glibc-string"
makedepends="$depends_dev"
options="!libc_glibc lib64 !fortify !check !annobin"
subpackages="
	$pkgname-dbg
	$pkgname-libintl:libintl:noarch
	$pkgname-dev
	"

provides="musl=$pkgver-r$pkgrel"
provider_priority=1
replaces="musl-default"
replaces_priority=1
alternative=1

case "$BOOTSTRAP" in
nocc)	pkgname="$pkgname-dev"; subpackages="";;
nolibc) ;;
esac
source="https://musl.libc.org/releases/musl-$pkgver.tar.gz
	mimalloc-$_mimalloc_ver.tar.gz::https://github.com/microsoft/mimalloc/archive/refs/tags/v$_mimalloc_ver.tar.gz
	0001-add-stub-for-pthread_mutexattr_setprioceiling.patch
	0001-fix-toctou-race-in-popen-children-s-closing-of-other.patch
	fix-loongarch64-zero-len-extcontext.patch
	CVE-2026-6042.patch
	CVE-2026-40200.patch
	fstatat-null.patch
	adjust-paths.patch
	CVE-2026-107891.patch

	0100-ldso-dynlink-add-ifunc-support.patch
	0101-support-ifunc-in-static-linking.patch
	0102-Makefile-link-glibc-string-lib.patch
	0103-use-internal-ifunc-symbols-in-libc.patch
	0104-increase-buffer-size-for-stdio-stream-functions.patch
	0105-ifunc-aarch64-support.patch
	0106-support-linking-with-aarch64-glibc-stirng.patch
	0107-dynlink-print-cpu-diagnostics.patch
	0108-process-rela.dyn-plt-relocations-with-ifuncs-in-stat.patch
	0109-ldd-detect-static-pie-binaries.patch
	0110-ldd-process-only-one-program-interpreter-segment-typ.patch

	0120-plumb-in-support-for-externally-provided-allocator-l.patch
	0121-implement-necessary-bits-for-musl-integration.patch
	0122-make-internal-declarations-static.patch
	0123-add-some-missed-errnos-where-needed.patch
	0124-re-enable-memory-align-via-hint-address.patch
	0125-turn-off-THP-via-madvise-instead-of-prctl.patch
	0126-detect-invalid-ptr-in-secure-mode-1.patch
	0127-support-new-mi_collect-bool-force-interface.patch
	0128-fix-musl-build-with-linux-prctl.h.patch
	0129-use-sched_yield-instead-of-sleep-0-in-libc-build.patch
	0130-add-MI_RANDOMIZE_FREE_LIST-to-enable-free-list-random.patch

	mimalloc.c
	__stack_chk_fail_local.c
	"
# this is needed for BOOTSTRAP=nocc (see above)
builddir="$srcdir/musl-$pkgver"

# secfixes:
#   1.2.6-r6:
#     - CVE-2026-107891
#   1.2.6-r2:
#     - CVE-2026-40200
#   1.2.6-r1:
#     - CVE-2026-6042
#   1.2.5-r11:
#     - CVE-2025-26519
#   1.2.2_pre2-r0:
#     - CVE-2020-28928
#   1.1.23-r2:
#     - CVE-2019-14697
#   1.1.15-r4:
#     - CVE-2016-8859

prepare() {
	mv ../mimalloc-$_mimalloc_ver mimalloc
	cp ../mimalloc.c mimalloc/src/

	default_prepare

	echo "$pkgver" > VERSION

	# delete hand-optimized x86-64 string manipulation functions
	# as modern GCC generates faster code
	rm src/string/x86_64/memcpy.s src/string/x86_64/memmove.s
}

build() {
	[ "$BOOTSTRAP" = "nocc" ] && return 0

	export CPPFLAGS="${CPPFLAGS/-Os/-O2}"
	export CFLAGS="${CFLAGS/-Os/-O2}"
	export LDFLAGS="${LDFLAGS/-O1/-O2}"

	# provide minimal libssp_nonshared.a so we don't need libssp from gcc
	${CROSS_COMPILE}cc $CFLAGS -c "$srcdir"/__stack_chk_fail_local.c -o __stack_chk_fail_local.o
	${CROSS_COMPILE}ar r libssp_nonshared.a __stack_chk_fail_local.o

	cp /usr/lib/libglibc-string.a "$builddir"/

	local lib_new="$(nm --quiet --defined --extern --just-symbols libglibc-string.a | grep -v '^__')"
	local n

	for n in $lib_new; do
		echo "Removing default implementation for $n"
		rm -f ./src/string/$n.c ./src/string/$CARCH/$n*
	done

	# note: not autotools
	# shellcheck disable=2153
	LDFLAGS="$LDFLAGS -Wl,-soname,libc.musl-$CARCH.so.1" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--syslibdir=/usr/lib \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--enable-optimize \
		--enable-debug \
		--with-malloc=external

	EXTRA_OBJ="src/malloc/external/mimalloc.o" \
	make
}

package() {
	case "$CARCH" in
	aarch64*)	ARCH="aarch64" ;;
	x86_64)		ARCH="x86_64" ;;
	esac

	if [ "$BOOTSTRAP" = "nocc" ]; then
		make ARCH="$ARCH" prefix=/usr DESTDIR="$pkgdir" install-headers
	else
		make DESTDIR="$pkgdir" install

		cp libssp_nonshared.a lib/libc-noglibc-string.a "$pkgdir"/usr/lib

		# make LDSO the be the real file, and libc the symlink
		local rule="$(printf "%s\n\t%s\n" 'print-ldso:' '@echo $$(basename $(LDSO_PATHNAME))')"
		local LDSO=$(make -f Makefile --eval "$rule" print-ldso)
		mv -f "$pkgdir"/usr/lib/libc.so "$pkgdir"/usr/lib/"$LDSO"
		ln -sf "$LDSO" "$pkgdir"/usr/lib/libc.musl-${CARCH}.so.1
		ln -sf ../../usr/lib/"$LDSO" "$pkgdir"/usr/lib/libc.so
		mkdir -p "$pkgdir"/usr/bin
	fi

	ln -sf usr/lib "$pkgdir"/lib
	ln -sf usr/bin $pkgdir/bin
	ln -sf usr/sbin $pkgdir/sbin
}

# currently we don't want by default any NLS
# and use GNU gettext where needed. the plan is to migrate to
# musl gettext() later on as fully as possible.
libintl() {
	provides="musl-libintl=1"
	replaces="musl-default-libintl"
	depends="$pkgname=$pkgver-r$pkgrel"

	pkgdesc="musl libintl.h header"
	mkdir -p "$subpkgdir"/usr/include
	mv "$pkgdir"/usr/include/libintl.h \
		"$subpkgdir"/usr/include/
}

dev() {
	default_dev

	# libc-dev is for backwards compatibility
	provides="musl-dev=1 libc-dev=1"
	replaces="musl-default-dev"

	strip --strip-debug "$subpkgdir"/usr/lib/*crt*.o
}

dbg() {
	provides="musl-dbg=1"
	replaces="musl-default-dbg"
	depends="$pkgname=$pkgver-r$pkgrel"

	default_dbg
}

