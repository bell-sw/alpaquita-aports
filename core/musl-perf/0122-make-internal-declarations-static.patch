From 09051bfd81d80b3d8d99e8329819d59055caedc5 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Fri, 17 Jan 2025 14:02:10 +0000
Subject: [PATCH] make internal declarations static

Patch based on https://github.com/chimera-linux/cports/blob/master/main/musl/patches/0001-implement-necessary-bits-for-musl-integration.patch
---
 mimalloc/include/mimalloc/atomic.h   |   2 +-
 mimalloc/include/mimalloc/internal.h | 297 ++++++++++++++-------------
 mimalloc/include/mimalloc/prim.h     |  43 ++--
 mimalloc/include/mimalloc/types.h    |   8 +-
 mimalloc/src/arena.c                 |   2 +-
 mimalloc/src/bitmap.h                |  26 +--
 mimalloc/src/init.c                  |   9 +
 mimalloc/src/os.c                    |   3 +
 mimalloc/src/page.c                  |   2 +-
 9 files changed, 208 insertions(+), 184 deletions(-)

diff --git a/mimalloc/include/mimalloc/atomic.h b/mimalloc/include/mimalloc/atomic.h
index 39ff5c90..ad0fd935 100644
--- a/mimalloc/include/mimalloc/atomic.h
+++ b/mimalloc/include/mimalloc/atomic.h
@@ -477,7 +477,7 @@ static inline void mi_lock_done(mi_lock_t* lock) {
 
 #elif defined(MI_USE_PTHREADS)
 
-void _mi_error_message(int err, const char* fmt, ...);
+static void _mi_error_message(int err, const char* fmt, ...);
 
 #define mi_lock_t  pthread_mutex_t
 
diff --git a/mimalloc/include/mimalloc/internal.h b/mimalloc/include/mimalloc/internal.h
index eae85ab6..9e7e035d 100644
