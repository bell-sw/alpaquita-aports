From 39e7c3b59772efab21c00ded3e2d23ccd528d5e2 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Fri, 17 Sep 2021 18:13:40 +0300
Subject: [PATCH] support ifunc in static linking

---
 src/env/__init_tls.c        | 34 ++++++++++++++++++++++++++++++++++
 src/env/__libc_start_main.c |  1 +
 2 files changed, 35 insertions(+)

diff --git a/src/env/__init_tls.c b/src/env/__init_tls.c
index a93141ed..2e4fd163 100644
--- a/src/env/__init_tls.c
+++ b/src/env/__init_tls.c
@@ -8,6 +8,9 @@
 #include "libc.h"
 #include "atomic.h"
 #include "syscall.h"
+#include "elf.h"
+#include "link.h"
+#include "reloc.h"
 
 volatile int __thread_list_lock;
 
@@ -73,12 +76,41 @@ void *__copy_tls(unsigned char *mem)
 
 #if ULONG_MAX == 0xffffffff
 typedef Elf32_Phdr Phdr;
+#define R_TYPE(x) ((x)&255)
 #else
 typedef Elf64_Phdr Phdr;
+#define R_TYPE(x) ((x)&0x7fffffff)
 #endif
 
 extern weak hidden const size_t _DYNAMIC[];
 
+static ElfW(Addr) resolve_ifunc_addr(const ElfW(Addr) addr)
+{
+	void *new_addr = ((void *(*)(void))addr)();
+
+	return (ElfW(Addr))new_addr;
+}
+
+static void process_iplt(const ElfW(Rela) *reloc)
+{
+	if (R_TYPE(reloc->r_info) != REL_IRELATIVE)
+		a_crash();
+
+	ElfW(Addr) * const reloc_addr = (void *)reloc->r_offset;
+
+	*reloc_addr = resolve_ifunc_addr(reloc->r_addend);
+}
+
+static void init_ifunc(void)
+{
+	extern weak hidden const ElfW(Rela) __rela_iplt_start[];
+	extern weak hidden const ElfW(Rela) __rela_iplt_end[];
+	const ElfW(Rela) *i = __rela_iplt_start;
+
+	for (; i < __rela_iplt_end; ++i)
+		process_iplt(i);
+}
+
 static void static_init_tls(size_t *aux)
 {
 	unsigned char *p;
@@ -148,6 +180,8 @@ static void static_init_tls(size_t *aux)
 	/* Failure to initialize thread pointer is always fatal. */
 	if (__init_tp(__copy_tls(mem)) < 0)
 		a_crash();
+
+	init_ifunc();
 }
 
 weak_alias(static_init_tls, __init_tls);
diff --git a/src/env/__libc_start_main.c b/src/env/__libc_start_main.c
index c5b277bd..f6f8188d 100644
--- a/src/env/__libc_start_main.c
+++ b/src/env/__libc_start_main.c
@@ -89,6 +89,7 @@ int __libc_start_main(int (*main)(int,char **,char **), int argc, char **argv,
 static int libc_start_main_stage2(int (*main)(int,char **,char **), int argc, char **argv)
 {
 	char **envp = argv+argc+1;
+
 	__libc_start_init();
 
 	/* Pass control to the application */
-- 
