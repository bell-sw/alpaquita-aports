_java_name="$VENDOR_NAME $VENDOR_JAVA_NAME JDK 21 CRaC"

pkgname=${_java_pkg_name}21-crac
pkgver=${_java_ver/+/_p}
pkgrel=0
pkgdesc="$_java_name (Coordinated Restore at Checkpoint)"
url="$VENDOR_URL"
