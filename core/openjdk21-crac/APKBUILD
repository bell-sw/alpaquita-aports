	local debugdir="$subpkgdir/usr/lib/debug"
	mkdir -p "$debugdir/$_java_home"
	tar -C "$debugdir/$_java_home" -xf "$builddir"/build/linux-*-release/bundles/*21*_bin-symbols-r$pkgrel.tar.gz --no-same-owner --strip-components=1
