	$pkgname-libs-static:_libs_static
	$pkgname-jre-cds:_jre_cds
	$pkgname-jre-no-deps:_jre_no_deps
	$pkgname-jre:_jre
	$pkgname-jdk-no-deps:_jdk_no_deps
	$pkgname-jdk:_jdk
	"

