	mkdir -p "$subpkgdir/$_java_home/lib"
	tar -C "$subpkgdir/$_java_home" -xf "$builddir"/build/linux-*-release/bundles/*21*_bin-static-libs-r$pkgrel.tar.gz --no-same-owner --strip-components=1
}

