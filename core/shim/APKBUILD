pkgname=shim
pkgver=16.1
pkgrel=0
pkgdesc="shim, a first-stage UEFI bootloader"
url="https://github.com/rhboot/shim"
arch="x86_64 aarch64"
license="BSD-2-Clause-Patent"
makedepends="gcc make elfutils-dev xxd dos2unix efivar-dev musl:libunwind-dev"
source="https://github.com/rhboot/shim/releases/download/$pkgver/shim-$pkgver.tar.bz2
	bellsoft-uefi-ca.der
	sbat.distro.csv

	0001-tests-fix-build-on-musl-based-systems.patch
	0002-test-str.c-replace-the-glibc-specific-__GNUC_PREREQ-.patch
"
builddir="$srcdir/$pkgname-$pkgver"
subpackages="$pkgname-utils $pkgname-dbg"
options="!stackprot !annobin"

# secfixes:
#   15.8-r0:
#     - CVE-2023-40546
#     - CVE-2023-40547
#     - CVE-2023-40548
#     - CVE-2023-40549
#     - CVE-2023-40550
#     - CVE-2023-40551

prepare() {
	default_prepare
	cp "$srcdir"/bellsoft-uefi-ca.der "$builddir"/

	sed -e "s,@VERSION@,$pkgver-r$pkgrel,g" \
		-e "s,@DISTRO@,$VENDOR_DISTRO,g" -e "s,@DISTRO_NAME@,$VENDOR_DISTRO_NAME,g" \
		-e "s,@SUPPORT_URL@,$VENDOR_BUG_REPORT_URL,g" \
		< "$srcdir"/sbat.distro.csv > "$builddir"/data/sbat.distro.csv
	msg "$VENDOR_DISTRO_NAME .sbat section: $(cat $builddir/data/sbat.distro.csv)"
}

build() {
	make VENDOR_CERT_FILE=bellsoft-uefi-ca.der
}

package() {
	make VENDOR_CERT_FILE=bellsoft-uefi-ca.der \
	     DESTDIR=$pkgdir \
	     EFIDIR="$VENDOR_DISTRO" \
	     install
}

utils() {
	local lib_path="$subpkgdir/usr/lib/shim"

	mkdir -p $lib_path
	cp "$pkgdir"/boot/efi/EFI/"$VENDOR_DISTRO"/* $lib_path
	cp "$pkgdir"/boot/efi/EFI/BOOT/* $lib_path
	cp "$srcdir"/bellsoft-uefi-ca.der $lib_path
}

dbg()
{
	mkdir -p "$subpkgdir"
	mv "$pkgdir"/usr "$subpkgdir"
}

check() {
	# Use -j1 since a parallel test build may fail on test-random.h
	# and libefi-test.a files not being ordered (created) properly
	# before the compilation targets.
	make -j1 $([ "$CLIBC" = "musl" ] && echo ENABLE_LIBUNWIND=1) test
}

