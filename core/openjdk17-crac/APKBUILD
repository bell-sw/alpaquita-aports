sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib"

_jre_tools="
	java
	keytool
	rmiregistry
	"

if [ "$BUILD_FROM_SOURCE" -ne 0 ]; then
	# To build from sources - build with openjdk17-bootstrap, provided by a
	# previous version of this package
	makedepends="$makedepends
		openjdk17-bootstrap>=17.0.3
		"
fi

# secfixes:
#   17.0.16_p13-r0:
#     - CVE-2025-50059
#     - CVE-2025-30749
#     - CVE-2025-50106
#     - CVE-2025-30754
