			src-linux-alpaquita-musl-aarch64-17.0.20.1+2-r$pkgrel-lite.tar.gz::https://download.bell-sw.com/linux-alpaquita/java-sources/java/17.0.20.1+2-crac-r0/linux-alpaquita-musl-aarch64/src.tar.gz
"
			JDK_SHA="
cf0d0d55f8ffdebd55da7d32a46817f4ec8b2eb7e2d7b019af97d87bd900aa0f64dc8b9926f04011dfb3eebe7f66ae273538c6980e231c4150fb056348ff929e  src-linux-alpaquita-musl-aarch64-17.0.20.1+2-r$pkgrel-lite.tar.gz
"
		;;
	esac

fi

source="
	$JDK_BIN
	HelloJava.java
"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib"

