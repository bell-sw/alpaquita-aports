	pkgdesc="$_java_name (Java Modules)"
	depends="$pkgname-jdk=$pkgver-r$pkgrel"
	provides="openjdk17-crac-jmods=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir/$_java_home"
