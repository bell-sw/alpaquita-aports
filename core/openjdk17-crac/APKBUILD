			src-linux-alpaquita-musl-aarch64-17.0.21.1+6-r$pkgrel-lite.tar.gz::https://download.bell-sw.com/linux-alpaquita/java-sources/java/17.0.21.1+6-crac-r0/linux-alpaquita-musl-aarch64/src.tar.gz
"
			JDK_SHA="
9db74c979f2734e18dc86cfb8833fd0ebf7e3bfd126a0d153b0664edf89ea2cb66cacf74828ce636950af247d7fadca19fc0bbeae4e7506df5a87d7ee23ef68b  src-linux-alpaquita-musl-aarch64-17.0.21.1+6-r$pkgrel-lite.tar.gz
"
		;;
	esac

fi

source="
	$JDK_BIN
	HelloJava.java
"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib"

