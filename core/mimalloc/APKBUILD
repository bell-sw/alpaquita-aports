b5064f0c19db2e1e886caa87868b942cdd39570c7f6006d11e85939ce79b7bba24c284f4310ec6e9663b3f5873714e2456faec337c575681e6ce663ae4ca6918  0001-fix-musl-build-with-linux-prctl.h.patch
237d11c69c74402a78d0fb67914144653e5215170bb8047726d35d895b6edab603189d611b2b24cf783cc93fe5f6a25bae28f659d20d44054d182faeb07bbf7c  malloc.sh
"
