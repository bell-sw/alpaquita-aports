8ad2ccec075b5349d6d3287e58f339e682a29f5ac8f4f734f43712c3664633d609db54973fb0d1ac7741bc90ae2e7a93a2369f68cf6a7cf9477748c5d9b87508  src-linux-alpaquita-musl-aarch64-lite-17.0.20+10-lite-r$pkgrel.tar.gz
"
		;;
	esac

fi

source="
	$JDK_BIN
	HelloJava.java
"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib:$_java_home/lib/jli:$_java_home/lib/server"

_jre_tools="
	java
	keytool
	rmiregistry
	"


