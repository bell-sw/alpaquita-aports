	libxext-dev
	libxi-dev
	libxrandr-dev
	libxrender-dev
	libxt-dev
	libxtst-dev
	linux-headers
	sed
	zip
	zlib-dev
	${_java_pkg_name}17-bootstrap>=17.0.2
	"

