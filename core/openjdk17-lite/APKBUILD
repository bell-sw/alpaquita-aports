b942652867b4f1464dff056a991c0c80ac79f9e1aafd357a3dcf2f35580de29b6eacd65cdfbb1d008945dce302c0fca20acf73c095ef15db77162e0cc97c8bda  src-linux-alpaquita-musl-aarch64-lite-17.0.18+10-lite-r$pkgrel.tar.gz
"
		;;
	esac

fi

source="
	$JDK_BIN
	HelloJava.java
"

builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib:$_java_home/lib/jli:$_java_home/lib/server"

_jre_tools="
	java
	keytool
	rmiregistry
	"

# secfixes:
#   17.0.16_p12-r0:
#     - CVE-2025-50059
#     - CVE-2025-30749
