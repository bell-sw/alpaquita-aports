pkgname=distro-base
pkgver=25.0
pkgrel=2
pkgdesc="Meta package for minimal $VENDOR_NAME $VENDOR_DISTRO_NAME base"
url="$VENDOR_URL"
arch="noarch"
license="MIT"
depends="
	distro-baselayout
	distro-release
	apk-tools
	busybox
	busybox-openrc
	busybox-suid
	dev-openrc
	$CLIBC-utils
	openrc
	"
makedepends=""
install=""
subpackages=""
subpackages="distro-release:release hardened-release:hardened_release"
replaces="$VENDOR_DISTRO-baselayout"
provides="$VENDOR_DISTRO-base=$pkgver-r$pkgrel"
source=""
options="!check"

case $pkgver in
    *.*)
	_ver=${pkgver%%.*}
	_ver_pretty="$_ver LTS"
	;;
    *)
	_ver="stream"
	_ver_pretty="Stream"
	;;
esac

package() {
	mkdir -p "$pkgdir"
}

_create_os_release() {
	local basic=$1
	local pretty=$2
	local id=$3

	mkdir -p "$subpkgdir"/usr/lib
	cat >"$subpkgdir"/usr/lib/os-release<<EOF
NAME="$basic"
ID=$id
ID_LIKE=alpine
VERSION="$_ver_pretty"
VERSION_ID=$_ver
PRETTY_NAME="$pretty"
HOME_URL="$VENDOR_URL"
BUG_REPORT_URL="$VENDOR_BUG_REPORT_URL"
LIBC_TYPE=$CLIBC
EOF

	mkdir -p "$subpkgdir"/etc
	ln -s ../usr/lib/os-release "$subpkgdir"/etc/os-release
}

release() {
	depends="distro-keys"
	pkgdesc="$VENDOR_DISTRO_NAME release data"
	provides="$VENDOR_DISTRO-release=$pkgver-r$pkgrel"

	local basic="$VENDOR_NAME $VENDOR_DISTRO_NAME Linux"
	local pretty="$basic $_ver_pretty ($CLIBC)"

	_create_os_release "$basic" "$pretty" "$VENDOR_DISTRO"

	# create /etc/$VENDOR_DISTRO-release
	echo $_ver > "$subpkgdir/etc/$VENDOR_DISTRO-release"

	# create /etc/issue
	cat >"$subpkgdir"/etc/issue<<EOF
Welcome to $pretty
Kernel \\r on \\m (\\l)

EOF
}

hardened_release() {
	depends="!distro-release"
	pkgdesc="Hardened release data"

	local basic="$VENDOR_NAME Hardened Containers"
	local pretty="$basic $_ver_pretty ($CLIBC)"

	_create_os_release "$basic" "$pretty" "$(echo "$basic" | tr '[:upper:] ' '[:lower:]-')"
}
