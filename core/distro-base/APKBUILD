pkgname=distro-base
pkgver=23.0
pkgrel=1
pkgdesc="Meta package for minimal $VENDOR_NAME $VENDOR_DISTRO_NAME base"
url="$VENDOR_URL"
arch="noarch"
license="MIT"
depends="
	distro-baselayout
	distro-release
	apk-tools
	busybox
	busybox-openrc
	busybox-suid
	dev-openrc
	libc-utils
	openrc
	"
makedepends=""
install=""
subpackages=""
subpackages="distro-release:release"
replaces="$VENDOR_DISTRO-baselayout"
provides="$VENDOR_DISTRO-base=$pkgver-r$pkgrel"
source=""
options="!check"

build() {
	return 0
}

package() {
	mkdir -p "$pkgdir"
}

release() {
	depends="distro-keys"
	pkgdesc="$VENDOR_DISTRO_NAME release data"
	provides="$VENDOR_DISTRO-release=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir"/etc

	# create /etc/$VENDOR_DISTRO-release
	local _ver=${pkgver%_*}
	echo $_ver > "$subpkgdir/etc/$VENDOR_DISTRO-release"

	local basic="$VENDOR_NAME $VENDOR_DISTRO_NAME Linux"
	local pretty
	case $pkgver in
	    *.*)
		basic="$basic LTS"
		pretty="$basic $pkgver ($CLIBC)"
		;;
	    *)
		basic="$basic Stream"
		pretty="$basic ($CLIBC)"
		;;
	esac

	# create /etc/issue
	cat >"$subpkgdir"/etc/issue<<EOF
Welcome to $pretty
Kernel \\r on an \\m (\\l)

EOF

	# create os-release
	cat >"$subpkgdir"/etc/os-release<<EOF
NAME="$basic"
ID=$VENDOR_DISTRO
ID_LIKE=alpine
VERSION_ID=$_ver
PRETTY_NAME="$pretty"
HOME_URL="$VENDOR_URL"
BUG_REPORT_URL="$VENDOR_BUG_REPORT_URL"
LIBC_TYPE=$CLIBC
EOF
}
