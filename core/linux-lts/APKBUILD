#   6.1.97-r0:
#     - CVE-2024-25741
#   6.1.85-r0:
#     - CVE-2024-24857
#     - CVE-2024-24858
#   6.1.84-r0:
#     - CVE-2023-47233
#   6.1.83-r0:
