From 1c1a3bc17c96bca6db23c9ec83b2454f5abf6e86 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Mon, 10 Jan 2022 12:13:02 +0300
Subject: [PATCH] make using realpath compatible with busybox

---
 dracut-init.sh                                   | 2 +-
 dracut.sh                                        | 2 +-
 modules.d/90kernel-modules-extra/module-setup.sh | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/dracut-init.sh b/dracut-init.sh
index 88a1b869..35c1a48d 100755
--- a/dracut-init.sh
+++ b/dracut-init.sh
@@ -54,7 +54,7 @@ if ! [[ $kernel ]]; then
     export kernel
 fi
 
-srcmods="$(realpath -e "$dracutsysrootdir/lib/modules/$kernel")"
+srcmods="$(realpath "$dracutsysrootdir/lib/modules/$kernel")"
 
 [[ $drivers_dir ]] && {
     if ! command -v kmod &> /dev/null && vercmp "$(modprobe --version | cut -d' ' -f3)" lt 3.7; then
diff --git a/dracut.sh b/dracut.sh
index c2b2c949..625b416d 100755
--- a/dracut.sh
+++ b/dracut.sh
@@ -1312,7 +1312,7 @@ if [[ -z $DRACUT_KMODDIR_OVERRIDE && -n $drivers_dir ]]; then
     fi
 fi
 
-TMPDIR="$(realpath -e "$tmpdir")"
+TMPDIR="$(realpath "$tmpdir")"
 readonly TMPDIR
 [ -d "$TMPDIR" ] || {
     printf "%s\n" "dracut[F]: Invalid tmpdir '$tmpdir'." >&2
diff --git a/modules.d/90kernel-modules-extra/module-setup.sh b/modules.d/90kernel-modules-extra/module-setup.sh
index 85e2e0ad..1541f8fb 100755
--- a/modules.d/90kernel-modules-extra/module-setup.sh
+++ b/modules.d/90kernel-modules-extra/module-setup.sh
@@ -178,7 +178,7 @@ installkernel() {
         | tr -d ':' \
         | (
             cd "$depmod_module_dir" || exit
-            xargs -r realpath -se --
+            xargs -r realpath --
         ) \
         | instmods || return 1
 
-- 
2.25.1

