pkgname=dracut
pkgver=107
pkgrel=0
pkgdesc="Event-driven initramfs infrastructure that is used to create an initramfs image"
url="https://github.com/dracutdevs/dracut"
arch="all"
options="!check"
license="GPL-2.0-or-later"
depends="
	musl:musl-utils
	findmnt
	xz
	zstd
	eudev
	bash
	device-mapper
	blkid
	kmod
"
makedepends="asciidoc musl:musl-fts-dev kmod-dev coreutils"
subpackages="$pkgname-doc $pkgname-dev $pkgname-bash-completion"
source="$pkgname-ng-$pkgver.tar.gz::https://github.com/dracut-ng/dracut-ng/archive/refs/tags/$pkgver.tar.gz
	distro.conf
	0001-make-using-cp-readlink-compatible-with-busybox.patch
	0002-make-using-realpath-compatible-with-busybox.patch
	0003-read-busybox-ln-help-from-stderr.patch
	0004-dracut-functions.sh-replace-grep-perl-regexp-with-aw.patch
	0005-modules.d-add-new-module-distro-iso.patch
	0006-Makefile-always-use-APKBUILD-version.patch
	0007-don-t-search-libs-in-usr-lib64-use-usr-lib.patch
	0008-init.sh-move-dev-sys-proc-to-new-root.patch
	0009-distro-iso-enable-auto-login-and-start-the-installer.patch
	0010-dracut-distro-iso-enable-getty-on-the-serial-port.patch
	0011-modules.d-add-kernel-netmods-load.patch
	0012-dracut-use-grub-to-load-early-microcode-by-default.patch
	0013-dracut-make-cpio-options-busybox-compatible.patch
	0014-98-distro-iso-install-missing-umount.patch
	0015-distro-iso-also-support-root-PARTLABEL-UUID-PARTUUID.patch
	0016-distro-iso-auto-detect-serial-consoles-and-allow-to-.patch
	0017-distro-iso-enable-installer-on-serial-consoles.patch
	0018-distro-iso-fix-init-s-askfirst-serial-console-speed.patch
	0019-busybox-sed-workaround.patch
	0020-do-not-depend-on-network-legacy-no-support.patch
	0021-dracut-install-ignore-musl-ldd-reloc-errors.patch
	0022-busybox-sh-compat-module.patch
	0023-partially-revert-commit-8519dcdb154b-fix-improve-hos.patch
	"
triggers="$pkgname.trigger=/usr/share/kernel/*"
builddir="$srcdir"/$pkgname-ng-$pkgver

build()
{
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
}

package()
{
	make DESTDIR="$pkgdir" install

	cp "$srcdir"/distro.conf "$pkgdir"/etc/dracut.conf.d/"${VENDOR_DISTRO}.conf"

	for m in 00bash 00dash \
		 30convertfs \
		 35network-* \
		 80cms \
		 81cio_ignore \
		 90dmsquash-live* 90livenet 90ppcmac \
		 91zipl \
		 95dcssblk 95zfcp 95znet \
		 98selinux \
		; do
		rm -r "$pkgdir"/usr/lib/dracut/modules.d/$m
	done
	rm -f "$pkgdir"/usr/share/man/man8/*.service.8.gz
}

