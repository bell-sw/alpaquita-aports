From df701badf576933e4b95fbd936d078a27a56f4ca Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Mon, 10 Jan 2022 12:23:27 +0300
Subject: [PATCH] read busybox/ln help from stderr

---
 dracut-init.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dracut-init.sh b/dracut-init.sh
index 470242b5..dfa68eee 100755
--- a/dracut-init.sh
+++ b/dracut-init.sh
@@ -1163,7 +1163,7 @@ instmods() {
     return $_ret
 }
 
-if [[ "$(ln --help)" == *--relative* ]]; then
+if [[ "$(ln --help 2>&1)" == *--relative* ]]; then
     ln_r() {
         ln -sfnr "${initdir}/$1" "${initdir}/$2"
     }
-- 
2.25.1

