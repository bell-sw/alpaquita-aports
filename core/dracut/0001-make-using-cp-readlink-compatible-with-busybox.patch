From 64eb4db42dce97e1f0170da2f3ccc75655739b2a Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Mon, 10 Jan 2022 12:01:23 +0300
Subject: [PATCH] make using cp/readlink compatible with busybox

---
 dracut-init.sh                 | 6 +-----
 modules.d/99base/dracut-lib.sh | 2 +-
 src/install/dracut-install.c   | 6 ++----
 3 files changed, 4 insertions(+), 10 deletions(-)

diff --git a/dracut-init.sh b/dracut-init.sh
index 9be00c56..88a1b869 100755
--- a/dracut-init.sh
+++ b/dracut-init.sh
@@ -19,11 +19,7 @@
 #
 export LC_MESSAGES=C
 
-if [[ $EUID == "0" ]] && ! [[ $DRACUT_NO_XATTR ]]; then
-    export DRACUT_CP="cp --reflink=auto --sparse=auto --preserve=mode,timestamps,xattr,links -dfr"
-else
-    export DRACUT_CP="cp --reflink=auto --sparse=auto --preserve=mode,timestamps,links -dfr"
-fi
+export DRACUT_CP="cp -pdfr"
 
 # is_func <command>
 # Check whether $1 is a function.
diff --git a/modules.d/99base/dracut-lib.sh b/modules.d/99base/dracut-lib.sh
index 05c361c6..6e9e4000 100755
--- a/modules.d/99base/dracut-lib.sh
+++ b/modules.d/99base/dracut-lib.sh
@@ -605,7 +605,7 @@ copytree() {
     local src="$1" dest="$2"
     [ -d "$src" ] || return 1
     mkdir -p "$dest" || return 1
-    dest=$(readlink -e -q "$dest") || return 1
+    dest=$(readlink -fq "$dest") || return 1
     (
         cd "$src" || exit 1
         cp -af . -t "$dest"
diff --git a/src/install/dracut-install.c b/src/install/dracut-install.c
index bacbe86e..111ceda6 100644
--- a/src/install/dracut-install.c
+++ b/src/install/dracut-install.c
@@ -402,10 +402,8 @@ static int cp(const char *src, const char *dst)
 
 normal_copy:
         pid = fork();
-        const char *preservation = (geteuid() == 0
-                                    && no_xattr == false) ? "--preserve=mode,xattr,timestamps,ownership" : "--preserve=mode,timestamps,ownership";
         if (pid == 0) {
-                execlp("cp", "cp", "--reflink=auto", "--sparse=auto", preservation, "-fL", src, dst, NULL);
+                execlp("cp", "cp", "-pfL", src, dst, NULL);
                 _exit(errno == ENOENT ? 127 : 126);
         }
 
@@ -417,7 +415,7 @@ normal_copy:
         }
         ret = WIFSIGNALED(ret) ? 128 + WTERMSIG(ret) : WEXITSTATUS(ret);
         if (ret != 0)
-                log_error("ERROR: 'cp --reflink=auto --sparse=auto %s -fL %s %s' failed with %d", preservation, src, dst, ret);
+                log_error("ERROR: 'cp -pfL %s %s' failed with %d", src, dst, ret);
         log_debug("cp ret = %d", ret);
         return ret;
 }
-- 
2.25.1

