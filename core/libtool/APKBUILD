# Description: The GNU Libtool hides the complexity of generating special
# library types (such as shared libraries) behind a consistent interface.

pkgname=libtool
pkgver=2.6.2
pkgrel=0
pkgdesc="Generic library support script"
url="https://www.gnu.org/software/libtool/"
arch="all"
license="LGPL-2.0-or-later AND GPL-2.0-or-later"
# libtool-next-version expects a `diff` that doesn't default to unified context
depends="
	diffutils
	libltdl=$pkgver-r$pkgrel
	"
makedepends="
	autoconf
	automake
	help2man
	m4
	texinfo
	"
checkdepends="
	gawk
	gzip
	"
subpackages="libltdl-static libltdl $pkgname-doc"
source="https://ftp.gnu.org/gnu/libtool/libtool-$pkgver.tar.gz
	no-xz.patch
	"
options="libtool !archcheck" # arch-specific files moved into libltdl

prepare() {
	default_prepare

	cp -v README README-release
	./bootstrap -cf --skip-git --skip-po
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
}

check() {
	#  58: debug tracing: not compatible with debug tracing enabled in CI
	#  77: glibc asserts on static-pie with DT_RUNPATH
	# 187: repeats the entire test suite with shorter max_cmd_len
	if [ "$CLIBC" = "musl" ] ; then
		make check TESTSUITEFLAGS="-j$JOBS 1-57 59-76 77 78-186" SUBDIRS=.
	elif [ "$CLIBC" = "glibc" ] ; then
		make check TESTSUITEFLAGS="-j$JOBS 1-57 59-76    78-186" SUBDIRS=.

		# XXX: glibc asserts that static PIE doesn't carry
		# DT_RUNPATH, but libtool passes one when linking
		make check CFLAGS="$CFLAGS -no-pie" TESTSUITEFLAGS="77" SUBDIRS=.
	fi
}

package() {
	make DESTDIR="$pkgdir" install
}

libltdl() {
	pkgdesc="Runtime libraries for GNU Libtool Dynamic Module Loader"
	depends=

	amove usr/lib/libltdl.so*
}

