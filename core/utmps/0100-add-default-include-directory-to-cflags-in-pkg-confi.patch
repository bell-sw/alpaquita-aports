From 9a3eb2fbcc0d2b826b51626284afdcf70038abd8 Mon Sep 17 00:00:00 2001
From: Dmitry Klochkov <dmitry.klochkov@bell-sw.com>
Date: Fri, 16 May 2025 16:02:16 +0000
Subject: [PATCH] add default include directory to cflags in pkg-config

---
 tools/gen-dotpc.sh | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/tools/gen-dotpc.sh b/tools/gen-dotpc.sh
index 802c78e..132453f 100755
--- a/tools/gen-dotpc.sh
+++ b/tools/gen-dotpc.sh
@@ -92,9 +92,7 @@ echo "URL: ${url:-https://skarnet.org/software/${package}/}"
 if test -n "${extra_libs}" ; then
   print_requires ${extra_libs}
 fi
-if test -n "$ilist" ; then
-  echo "Cflags: ${ilist}"
-fi
+echo "Cflags: ${ilist}${ilist:+ }-I${includedir}/${library}"
 echo "Libs: ${dlist}${dlist:+ }-l${library}${ldlibs:+ }${ldlibs}"
 if test -n "${extra_libs}" ; then
   echo "Libs.private: ${slist}${slist:+ }${extra_libs}"
