	java
	keytool
	rmiregistry
	"

if [ "$BUILD_FROM_SOURCE" -ne 0 ]; then
	# To build from sources - build with openjdk24-bootstrap, provided by a
	# previous version of this package
	makedepends="$makedepends
		openjdk24-bootstrap
		"
fi

