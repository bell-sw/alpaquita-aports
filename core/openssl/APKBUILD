# Description: openssl carries out general-purpose cryptographic activities and
# ensures communication security.

pkgname=openssl
pkgver=3.0.22
_abiver=${pkgver%.*.*}
pkgrel=1
pkgdesc="Toolkit for general-purpose cryptography and secure communication (v.3)"
url="https://www.openssl.org/"
arch="all"
license="Apache-2.0"
replaces="openssl"
makedepends_build="perl"
makedepends_host="linux-headers"
makedepends="$makedepends_host $makedepends_build"
subpackages="$pkgname-dbg $pkgname-libs-static $pkgname-dev $pkgname-doc
	libcrypto$_abiver:_libcrypto libssl$_abiver:_libssl"
source="https://github.com/openssl/openssl/releases/download/openssl-$pkgver/openssl-$pkgver.tar.gz
	0100-rsa-implicit-rejection-in-PKCS-1-v1.5.patch
	0101-CVE-2024-41996.patch
	0102-CVE-2026-75805-Guard-comparision-when-values-are-NUL.patch
	0103-Add-test-for-CVE-2026-75805.patch
	0104-CVE-2026-75806-TLS-Reject-undersized-TLS-1.2-AEAD-re.patch
	0105-CVE-2026-35189-Defer-computation-of-relative-CRLDP-n.patch
	0106-CVE-2026-84782-dtls-reset-init_off-before-retransmit.patch
	0107-CVE-2026-54872-ec-make-ossl_ec_scalar_mul_ladder-sca.patch
	0108-CVE-2026-77696-sm2-make-sm2_sig_gen-constant-time.patch
	"
builddir="$srcdir/openssl-$pkgver"

