# Description: binutils is a set of tools that enables compilation and linking
# of programs within the GNU system.

pkgname=binutils
pkgver=2.45.1
_gold_ver=2.44 # last even version of $pkgver
pkgrel=0
pkgdesc="GNU tools for programs building"
url="https://www.gnu.org/software/binutils/"
makedepends_build="bison flex texinfo linux-headers"
makedepends_host="zlib-dev"
checkdepends="dejagnu"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause"
subpackages="$pkgname-dev $pkgname-doc"
source="https://ftp.gnu.org/gnu/binutils/binutils-$pkgver.tar.xz
	https://ftp.gnu.org/gnu/binutils/binutils-with-gold-$_gold_ver.tar.xz
	0001-Revert-PR25882-.gnu.attributes-are-not-checked-for-s.patch
	binutils-ld-fix-static-linking.patch
	s390x-pie.patch

	0100-CVE-2025-1147.patch
	0101-CVE-2025-11414.patch
	0102-CVE-2025-11412.patch
	0103-CVE-2025-11413-pre.patch
	0103-CVE-2025-11413.patch
	0104-CVE-2025-11494.patch
	0105-CVE-2025-11495.patch
	0106-CVE-2025-11840.patch
	0107-CVE-2025-11839.patch
	"
builddir="$srcdir/$pkgname-$pkgver"

if [ "$CBUILD" = "$CTARGET" ]; then
	_alpine_archs="
		aarch64
		x86_64
		"
fi

if [ -z "$BOOTSTRAP" ]; then
	makedepends_host="$makedepends_host jansson-dev zstd-dev"
	_noboot_configure="--enable-jansson --with-zstd"

	for _target_arch in $_alpine_archs; do
		if [ "$_target_arch" != "$CARCH" ]; then
			_cross_targets="$_cross_targets $_target_arch"
			subpackages="
				$subpackages
				$pkgname-$_target_arch:_cross_target
				"
		fi
	done
fi

if [ "$CHOST" != "$CTARGET" ]; then
	pkgname="$pkgname-$CTARGET_ARCH"
	subpackages=""
	sonameprefix="$pkgname:"
fi

_gold_configure="--disable-gold"
if [ "$CHOST" = "$CBUILD" ] && [ "$CBUILD" = "$CTARGET" ] ; then
	subpackages="$subpackages $pkgname-gold"
	_gold_configure="--enable-gold"
fi

