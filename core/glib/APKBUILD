# Description: glib includes several libraries that provide common data
# structures, portability wrappers, and interfaces.

pkgname=glib
pkgver=2.84.4
_gi_version=1.82.0
pkgrel=4
pkgdesc="Common C routines used by GTK+ and others"
url="https://developer.gnome.org/glib/"
arch="all"
license="LGPL-2.1-or-later"
triggers="$pkgname.trigger=/usr/share/glib-2.0/schemas:/usr/lib/gio/modules:/usr/lib/gtk-4.0"
depends_dev="
	bzip2-dev
	docbook-xml
	docbook-xsl
	gettext-dev
	libxml2-utils
	libxslt
	python3
	py3-packaging
	"
makedepends="$depends_dev
	bash
	bison
	flex
	libffi-dev
	meson
	pcre2-dev
	py3-setuptools
	python3-dev
	util-linux-dev
	zlib-dev
	py3-docutils
	"
[ "$CLIBC" = "glibc" ] && checkdepends="tzdata"
subpackages="
	$pkgname-dbg
	$pkgname-doc
	$pkgname-static
	$pkgname-dev
	$pkgname-lang
	$pkgname-bash-completion
	"
source="https://download.gnome.org/sources/glib/${pkgver%.*}/glib-$pkgver.tar.xz
	https://download.gnome.org/sources/gobject-introspection/${_gi_version%.*}/gobject-introspection-$_gi_version.tar.xz
	tests-machine-id.patch
	flaky-tests.patch

	0100-CVE-2025-14087.patch
	0101-CVE-2025-14512.patch
	0102-CVE-2026-0988.patch
	0103-CVE-2026-1484.patch
	0104-CVE-2026-1485.patch
	0105-CVE-2026-1489.patch
	0106-CVE-2026-15588.patch
	"

# 2.80 moves gir here
replaces="gobject-introspection<1.80.0"

[ "$CARCH" = "ppc64le" ] && options="$options !check" # https://gitlab.gnome.org/GNOME/glib/-/issues/3474

# secfixes:
#   2.84.4-r4:
#     - CVE-2026-15588
#   2.84.4-r3:
#     - CVE-2026-1484
#     - CVE-2026-1485
#     - CVE-2026-1489
#   2.84.4-r2:
#     - CVE-2026-0988
#   2.84.4-r1:
#     - CVE-2025-14087
#     - CVE-2025-14512
#   2.80.1-r0:
#     - CVE-2024-34397
#   2.66.6-r0:
#     - CVE-2021-27219 GHSL-2021-045
#   2.62.5-r0:
#     - CVE-2020-6750
#   2.60.4-r0:
#     - CVE-2019-12450

build() {
	export CFLAGS="$CFLAGS -ffat-lto-objects -O2"
	export CXXFLAGS="$CXXFLAGS -O2"
	export CPPFLAGS="$CPPFLAGS -O2"
	local _prefix="$PWD/boostrap-glib"

	msg "build bootstrap glib"
	meson setup \
		--default-library=shared \
		--prefix="$_prefix" \
		--libdir="$_prefix/lib" \
		-Dman-pages=disabled \
		-Dlibmount=disabled \
		-Dtests=false \
		-Dintrospection=disabled \
		-Dnls=disabled \
		. output
	meson compile -C output
	meson install --no-rebuild -C output

	msg "build bootstrap gobject-introspection"
	meson setup \
		--pkg-config-path="$_prefix"/lib/pkgconfig \
		--prefix="$_prefix" \
		--libdir="$_prefix/lib" \
		-Dbuild_introspection_data=false \
		-Dcairo=disabled \
		-Ddoctool=disabled \
		"$srcdir"/gobject-introspection-$_gi_version \
		gioutput
	meson compile -C gioutput
	meson install --no-rebuild -C gioutput

	msg "re-build glib with introspection"
	PATH="$_prefix/bin:$PATH" LD_LIBRARY_PATH="$_prefix/lib" \
		meson setup \
		--reconfigure \
		--pkg-config-path="$_prefix"/lib/pkgconfig \
		--default-library=both \
		--prefix=/usr \
		--libdir=/usr/lib \
		-Dman-pages=enabled \
		-Dlibmount=enabled \
		-Dtests="$(want_check && echo true || echo false)" \
		-Dintrospection=enabled \
		-Dnls=enabled \
		. output
	PATH="$_prefix/bin:$PATH" LD_LIBRARY_PATH="$_prefix/lib" \
		meson compile -C output
}

check() {
	# riscv64 and armhf may time out with the standard timeout
	meson test --timeout-multiplier 10 --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

dev() {
	# 2.80 moves gir here
	replaces="gobject-introspection-dev<1.80.0"
	default_dev
	mkdir -p "$subpkgdir"/usr/bin "$subpkgdir"/usr/share
	find "$pkgdir"/usr/bin ! -name "glib-compile-schemas" -a \( \
		-name "gdbus-codegen" -o \
		-name "gobject-query" -o \
		-name "gresource" -o \
		-name "gtester*" -o \
		-name "glib-*" \) \
		-exec mv {} "$subpkgdir"/usr/bin \;

	amove usr/share/gdb usr/share/glib-2.0
}

static() {
	default_static
	depends="gettext-static"
}

