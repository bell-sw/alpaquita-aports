# Description: glib includes several libraries that provide common data
# structures, portability wrappers, and interfaces.

pkgname=glib
pkgver=2.74.7
pkgrel=7
pkgdesc="Common C routines used by GTK+ and others"
url="https://developer.gnome.org/glib/"
arch="all"
license="LGPL-2.1-or-later"
triggers="$pkgname.trigger=/usr/share/glib-2.0/schemas:/usr/lib/gio/modules:/usr/lib/gtk-4.0"
depends_dev="
	bzip2-dev
	docbook-xml
	docbook-xsl
	gettext-dev
	libxml2-utils
	libxslt
	python3
	"
makedepends="$depends_dev pcre2-dev meson zlib-dev libffi-dev util-linux-dev"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-static $pkgname-dev $pkgname-lang"
source="https://download.gnome.org/sources/glib/${pkgver%.*}/glib-$pkgver.tar.xz
	0001-gquark-fix-initialization-with-c-constructors.patch
	deprecated-no-warn.patch
	0001-gslice-remove-slice-allocator.patch

	0100-CVE-2024-34397.patch
	0101-CVE-2024-52533.patch
	0102-CVE-2025-3360.patch
	0103-CVE-2025-4373-part1.patch
	0103-CVE-2025-4373-part2.patch
	0104-CVE-2025-7039.patch
	0105-CVE-2025-14087.patch
	0106-CVE-2025-14512.patch
	0107-CVE-2026-0988.patch
	0108-CVE-2026-1484.patch
	0109-CVE-2026-1485.patch
	0110-CVE-2026-1489.patch
	0111-CVE-2026-15588.patch
	"
options="!check" # don't like to be run without first being installed

# secfixes:
#   2.74.7-r7:
#     - CVE-2026-15588
#   2.74.7-r6:
#     - CVE-2026-1484
#     - CVE-2026-1485
#     - CVE-2026-1489
#   2.74.7-r5:
#     - CVE-2026-0988
#   2.74.7-r4:
#     - CVE-2025-14087
#     - CVE-2025-14512
#   2.74.7-r3:
#     - CVE-2025-3360
#     - CVE-2025-4373
#     - CVE-2025-7039
#   2.74.7-r2:
#     - CVE-2024-52533
#   2.74.7-r1:
#     - CVE-2024-34397
#   2.66.6-r0:
#     - CVE-2021-27219 GHSL-2021-045
#   2.62.5-r0:
#     - CVE-2020-6750
#   2.60.4-r0:
#     - CVE-2019-12450

build() {
	abuild-meson \
		--default-library=both \
		-Dman=true \
		-Dtests="$(want_check && echo true || echo false)" \
		. output
	meson compile ${JOBS:+-j ${JOBS}} -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

dev() {
	default_dev
	mkdir -p "$subpkgdir"/usr/bin "$subpkgdir"/usr/share
		find "$pkgdir"/usr/bin ! -name "glib-compile-schemas" -a \( \
		-name "gdbus-codegen" -o \
		-name "gobject-query" -o \
		-name "gresource" -o \
		-name "gtester*" -o \
		-name "glib-*" \) \
		-exec mv {} "$subpkgdir"/usr/bin \;

	amove usr/share/gdb usr/share/glib-2.0
}

static() {
	default_static
	depends="gettext-static"
}

