pkgname=async-profiler
pkgver=3.0
pkgrel=0
pkgdesc="Low overhead sampling profiler for Java"
url="https://github.com/async-profiler/async-profiler"
arch="all"
license="Apache-2.0"
makedepends="openjdk17"
options="!fhs"
checkdepends="bash"
source="
	$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz
	0001-940-lseek64-is-not-declared-when-compiling-on-Alpine.patch
	0002-parse-from-both-.rela.plt-and-.rela.dyn.patch
"

build() {
	make all
}

package() {
	install -m755 -D build/lib/libasyncProfiler.so "$pkgdir"/opt/async-profiler/lib/libasyncProfiler.so
	install -m755 -D build/bin/asprof "$pkgdir"/opt/async-profiler/bin/asprof
	install -m644 -D build/lib/async-profiler.jar "$pkgdir"/opt/async-profiler/lib/async-profiler.jar
	install -m644 -D build/lib/converter.jar "$pkgdir"/opt/async-profiler/lib/converter.jar

	install -dm755 "$pkgdir"/usr/lib "$pkgdir"/usr/bin
	ln -s ../../opt/async-profiler/lib/libasyncProfiler.so "$pkgdir"/usr/lib/libasyncProfiler.so
	ln -s ../../opt/async-profiler/bin/asprof "$pkgdir"/usr/bin/asprof
}

