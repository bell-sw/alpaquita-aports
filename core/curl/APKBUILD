prepare() {
	default_prepare
	autoreconf -vif
}

_build() {
	local new_builddir=$1
	local extra_configure=$2

	mkdir -p "$new_builddir"
	cd "$new_builddir"

	# the ca-cert path detection is skipped when cross-compiling
	[ "$CBUILD" != "$CHOST" ] \
		&& extra_configure="$extra_configure --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt"

	msg "Building the following:"
	echo ""
	echo "  new_builddir=$new_builddir"
	echo "  extra_configure=$extra_configure"
	echo ""

	"$builddir"/configure \
		--build=$CBUILD \
		--host=$CHOST \
		$extra_configure \
		--prefix=/usr \
		--enable-ipv6 \
		--enable-unix-sockets \
		--enable-static \
		--with-openssl \
		--with-zsh-functions-dir \
		--with-fish-functions-dir \
		--without-libidn2 \
		--with-nghttp2 \
		--disable-ldap \
		--with-pic \
		--enable-websockets \
		--without-libpsl \
		--without-libssh2 # https://bugs.alpinelinux.org/issues/10222
	make

	# generation of completions is not supported when cross-compiling.
	if [ -z "$BOOTSTRAP" ]; then
		make -C scripts/
	fi
}

build() {
	_build "$srcdir/build"
	# we need a debug-enabled curl to be able to run WebSockets tests
	_build "$srcdir/build-debug" '--enable-debug'
}

_check() {
	local new_builddir=$1
	local extra_tflags=$2

	cd "$new_builddir"

	make -C tests TFLAGS="$extra_tflags" nonflaky-test
}

check() {
	_check "$srcdir/build"
	_check "$srcdir/build-debug" 'WebSockets'
}

package() {
	cd "$srcdir/build"

	make install DESTDIR="$pkgdir"
	if [ -z "$BOOTSTRAP" ]; then
		install -Dm644 scripts/_curl -t \
			"$pkgdir"/usr/share/zsh/site-functions/
		install -Dm644 scripts/curl.fish -t \
			"$pkgdir"/usr/share/fish/completions/
	fi
}

libcurl() {
	pkgdesc="The multiprotocol file transfer library"

	mkdir -p "$subpkgdir"/usr
	mv "$pkgdir"/usr/lib "$subpkgdir"/usr
}

static() {
	pkgdesc="$pkgdesc (static library)"

	mkdir -p "$subpkgdir"/usr/lib
	mv "$pkgdir"/usr/lib/*.a "$subpkgdir"/usr/lib
}

