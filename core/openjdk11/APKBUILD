builddir="$srcdir/jdk-${_java_ver%+*}"
sonameprefix="$pkgname:"

_java_home=/usr/lib/jvm/"$pkgname"
ldpath="$_java_home/lib"

_jre_tools="
	java
	jjs
	keytool
	pack200
	rmid
	rmiregistry
	unpack200
	"

if [ "$BUILD_FROM_SOURCE" -ne 0 ]; then
	# To build from sources - build with openjdk11-bootstrap, provided by a
	# previous version of this package
	makedepends="$makedepends
		openjdk11-bootstrap>=11.0.15
		"
