edc0679c0b324f54fadcb7e6e4f902eb2a846aeb886423c586dbcaa90d6bc9164d85d8508df8b888de7893ae5bec0401c4c67d63b345c7370e1c2aec8ddf4a9f  gcc14-armv7.patch
