#   3.8.3-r0:
#     - CVE-2023-5981
#     - CVE-2024-0553
#     - CVE-2024-0567
#   3.8.0-r0:
#     - CVE-2023-0361
#   3.7.7-r0:
#     - CVE-2022-2509 GNUTLS-SA-2022-07-07
