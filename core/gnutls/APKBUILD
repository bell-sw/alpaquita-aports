# Description: gnutils implements the TLS, SSL, and DTLS protocol. It is aimed
# at establishing secure communications back-end.

pkgname=gnutls
pkgver=3.7.11
pkgrel=1
pkgdesc="The GNU TLS library"
url="https://www.gnutls.org/"
arch="all"
license="LGPL-2.1-or-later"
checkdepends="diffutils datefudge"
makedepends="automake nettle-dev zlib-dev libkcapi-dev libtasn1-dev linux-headers p11-kit-dev libunistring-dev texinfo"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-dev $pkgname-utils $pkgname-c++:xx"
_v=${pkgver%.*}
case $pkgver in
*.*.*.*) _v=${_v%.*};;
esac
source="https://www.gnupg.org/ftp/gcrypt/gnutls/v$_v/gnutls-$pkgver.tar.xz
	musl:skip-crq.patch
	musl:tests-certtool.patch

	0100-CVE-2024-12243.patch
	0101-CVE-2025-32989.patch
	0102-CVE-2025-32988.patch
	0103-CVE-2025-32990.patch
	0104-CVE-2025-6395.patch
	0105-CVE-2025-9820.patch
	"

