# Description: the new implementation of PCRE, a library of functions to support
# regular expressions whose syntax and semantics are as close as possible to
# those of the Perl 5 language.

pkgname=pcre2
pkgver=10.48
pkgrel=1
pkgdesc="New Perl Compatible Regular Expression Library "
url="https://pcre.org/"
arch="all"
license="BSD-3-Clause"
depends_dev="
	libedit-dev
	zlib-dev
	"
makedepends="$depends_dev"
subpackages="
	$pkgname-static
	$pkgname-dev
	$pkgname-doc
	$pkgname-tools
	libpcre2-16:_libpcre
	libpcre2-32:_libpcre
	"
source="https://github.com/PhilipHazel/pcre2/releases/download/pcre2-$pkgver/pcre2-$pkgver.tar.bz2
	pcre2-10.49-Fix-large-stack-allocation.patch
	pcre2-10.49-Fix-large-stack-allocation_tests
"

# secfixes:
#   10.48-r1:
#     - CVE-2026-103111
#   10.48-r0:
#     - CVE-2026-89156
#     - CVE-2026-89157
#     - CVE-2026-89158
#     - CVE-2026-89160
#     - CVE-2026-86145
#     - CVE-2026-89161
#     - CVE-2026-89162
#   10.46-r0:
#     - CVE-2025-58050
#   10.41-r0:
#     - CVE-2022-41409
#   10.40-r0:
#     - CVE-2022-1586
#     - CVE-2022-1587

case "$CARCH" in
	sh*) _enable_jit="";;
	*) _enable_jit="--enable-jit";;
esac

prepare() {
	default_prepare

	case "$CARCH" in
	arm*|x86)
		# tests from original pcre2-10.49-Fix-large-stack-allocation.patch
		# fail on 32bit architectures
		;;
	*)
		patch -Np1 -i "$srcdir"/pcre2-10.49-Fix-large-stack-allocation_tests
		;;
	esac
}

build() {
	# Note: Forced -O3 is recommended (needed?) for Julia.
	./configure \
		CFLAGS="$CFLAGS -O3" \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--docdir=/usr/share/doc/$pkgname-$pkgver \
		--htmldir=/usr/share/doc/$pkgname-$pkgver/html \
		--enable-pcre2-16 \
		--enable-pcre2-32 \
		--enable-pcre2grep-libz \
		--enable-pcre2test-libedit \
		$_enable_jit
	make
}

check() {
	./RunTest
	if [ -n "$_enable_jit" ]; then
		./pcre2_jit_test
	fi
}

package() {
	make DESTDIR="$pkgdir" install
}

_libpcre() {
	local bits="${subpkgname##*-}"
	pkgdesc="PCRE2 with $bits bit character support"

	amove usr/lib/libpcre2-$bits.so*
}

tools() {
	pkgdesc="Auxiliary utilities for PCRE2"

	amove usr/bin
}

