_java_pkg_name=$(echo $VENDOR_JAVA_NAME | tr [:upper:] [:lower:])
_java_ver=26.0.2.1+1
_java_rel_date=2026-08-18
_java_name="$VENDOR_NAME $VENDOR_JAVA_NAME JDK 26"

pkgname=${_java_pkg_name}26
pkgver=${_java_ver/+/_p}
pkgrel=0
pkgdesc="$_java_name"
url="$VENDOR_URL"
license="GPL-2.0 WITH Classpath-Exception-2.0"
arch="aarch64 x86_64"
options="!strip ldpath-recursive !tracedeps !annobin"
annocheck_skip="libsyslookup.so"
depends="$pkgname-jdk=$pkgver-r$pkgrel"

