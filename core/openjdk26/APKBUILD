_src() {
	pkgdesc="$_java_name (Sources)"
	depends="$pkgname-jdk=$pkgver-r$pkgrel"
	provides="openjdk26-src=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir/$_java_home/lib"
