		mv "$pkgdir/$_java_home/$f" "$subpkgdir/$_java_home/"
	done
}

_jdk() {
	pkgdesc="$_java_name (JDK)"
	depends="$pkgname-jre=$pkgver-r$pkgrel $pkgname-jdk-no-deps=$pkgver-r$pkgrel"
	provides="
