}

_demos() {
	pkgdesc="$_java_name (Demos)"
	depends="$pkgname-jdk=$pkgver-r$pkgrel"
	provides="openjdk26-demos=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir/$_java_home"
