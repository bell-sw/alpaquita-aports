}

_dbg() {
	pkgdesc="$_java_name (Debug Info)"
	depends="$pkgname-jdk=$pkgver-r$pkgrel"
	provides="openjdk26-dbg=$pkgver-r$pkgrel"

	local debugdir="$subpkgdir/usr/lib/debug"
	mkdir -p "$debugdir/$_java_home"
	tar -C "$debugdir/$_java_home" -xf "$builddir"/build/linux-*-release/bundles/*_bin-symbols-r$pkgrel.tar.gz --no-same-owner --strip-components=1
}

_libs_static() {
	pkgdesc="$_java_name (Static Libraries)"
	depends="$pkgname-jdk=$pkgver-r$pkgrel"
