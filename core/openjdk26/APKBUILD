_java_ver=26.0.1+10
_java_rel_date=2026-04-21
_java_name="$VENDOR_NAME $VENDOR_JAVA_NAME JDK 26"

pkgname=${_java_pkg_name}26
pkgver=${_java_ver/+/_p}
pkgrel=0
pkgdesc="$_java_name"
url="$VENDOR_URL"
