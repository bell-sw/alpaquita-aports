	$pkgname-dbg:_dbg
	$pkgname-jmods:_jmods:noarch
	$pkgname-demos:_demos:noarch
	$pkgname-src:_src:noarch
	$pkgname-libs-static:_libs_static
	$pkgname-jre-cds:_jre_cds
