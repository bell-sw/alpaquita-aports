pkgname=shim-signed

# shim 15.8 signed with 2011 MS cert — fallback when 2023 cert is not present
_build_2011="20240729"
# shim 16.1 signed with 2023 MS cert
_build_2023="20260522"

pkgver=16.1
pkgrel=0

case "${CARCH:-$(arch)}" in
x86_64)  _efi_sfx="x64" ;;
aarch64) _efi_sfx="aa64" ;;
esac
pkgdesc="shim, a first-stage UEFI bootloader (signed)"
url="https://github.com/rhboot/shim"
arch="x86_64 aarch64"
license="BSD-2-Clause-Patent"
makedepends="sbsigntool"
depends="mokutil"
options="!strip !check !tracedeps"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	$VENDOR_REPO_BASE_URL/$VENDOR_DISTRO/distfiles/shim-$_build_2011.x86_64.tar.xz
	$VENDOR_REPO_BASE_URL/$VENDOR_DISTRO/distfiles/shim-$_build_2011.aarch64.tar.xz
	$VENDOR_REPO_BASE_URL/$VENDOR_DISTRO/distfiles/shim-$_build_2023.x86_64.tar.gz
	$VENDOR_REPO_BASE_URL/$VENDOR_DISTRO/distfiles/shim-$_build_2023.aarch64.tar.gz
	../shim/bellsoft-uefi-ca.pem
	../shim/bellsoft-uefi-sign-2026.pem
"
builddir_2011="$srcdir/shim-$_build_2011.$CARCH"
builddir_2023="$srcdir/shim-$_build_2023.$CARCH"
_efi="boot/efi/EFI"

sign_list="
	usr/lib/shim/cert-2011/BOOT/mm${_efi_sfx}.efi
	usr/lib/shim/cert-2011/$VENDOR_DISTRO/mm${_efi_sfx}.efi
	usr/lib/shim/cert-2011/BOOT/fb${_efi_sfx}.efi
	usr/lib/shim/cert-2023/BOOT/mm${_efi_sfx}.efi
	usr/lib/shim/cert-2023/$VENDOR_DISTRO/mm${_efi_sfx}.efi
	usr/lib/shim/cert-2023/BOOT/fb${_efi_sfx}.efi
"
sign_verify="bellsoft-uefi-ca.pem bellsoft-uefi-sign-2026.pem"

package() {
	# Create target directories for both MS cert versions
	mkdir -p "$pkgdir"/usr/lib/shim/cert-2011
	mkdir -p "$pkgdir"/usr/lib/shim/cert-2023

	# Copy fallback 2011 MS cert shim files (shim 15.8)
	cp -rf "$builddir_2011"/$_efi/* "$pkgdir"/usr/lib/shim/cert-2011/

	# Copy 2023 MS cert shim files (shim 16.1)
	cp -rf "$builddir_2023"/$_efi/* "$pkgdir"/usr/lib/shim/cert-2023/
}

sha512sums="
