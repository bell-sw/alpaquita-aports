# Description: expat is a stream-oriented XML parser in C suitable for large
# files.

pkgname=expat
pkgver=2.7.3
_tagver=R_${pkgver//./_}
pkgrel=1
pkgdesc="XML Parser library written in C"
url="https://libexpat.github.io/"
arch="all"
license="MIT"
depends="libexpat=$pkgver-r$pkgrel"
checkdepends="bash"
source="
	https://github.com/libexpat/libexpat/releases/download/$_tagver/expat-$pkgver.tar.bz2

	0101-CVE-2026-24515-lib.patch
	0102-CVE-2026-24515-tests.patch
	"
# pull in xmlwf for dev
depends_dev="$pkgname=$pkgver-r$pkgrel"
# Order matters, ensure -dev does not gobble up static libraries.
subpackages="$pkgname-static $pkgname-dev $pkgname-doc lib$pkgname:libs"

