From 20ec066d5f11ae0e23a390df09a50c65a357dad0 Mon Sep 17 00:00:00 2001
From: BellSoft <info@bell-sw.com>
Date: Mon, 12 Oct 2026 10:18:10 +0000
Subject: [PATCH] feat(vendorjdk): match standalone vendor runtimes sent as OS
 packages

A client of the server mode that builds the package list itself from purls
(an SBOM platform, for example) sends the purls of the vendor's standalone
JDK and NIK (pkg:generic/<namespace>/<jdk or nik name>) in the OS package
list, usually without an operating system. They were reported as packages
of an unsupported OS and never matched, because the advisories of
standalone vendor runtimes are served by the vendorjdk detector of the
language packages.

Move such packages into applications of their product type before the
scan: the name becomes the distribution variant from the package_type
qualifier, and a source name that is not a JDK or NIK ecosystem is dropped
(the families are the module's EcosystemJDK / EcosystemNIK).

Such a package has no ecosystem. A JDK was already placed by its feature
version; a NIK is now placed on the Java line whose advisories are bounded
by versions of its minor (23.0.x is the Java 17 line, 23.1.x the Java 21
line) instead of being skipped.
---
 pkg/detector/library/vendorjdk/vendorjdk.go   | 45 +++++++++++-
 .../library/vendorjdk/vendorjdk_test.go       | 18 ++++-
 pkg/scan/local/service.go                     |  6 ++
 pkg/scan/local/vendorjdk.go                   | 56 +++++++++++++++
 pkg/scan/local/vendorjdk_test.go              | 71 +++++++++++++++++++
 5 files changed, 192 insertions(+), 4 deletions(-)
 create mode 100644 pkg/scan/local/vendorjdk.go
 create mode 100644 pkg/scan/local/vendorjdk_test.go

diff --git a/pkg/detector/library/vendorjdk/vendorjdk.go b/pkg/detector/library/vendorjdk/vendorjdk.go
index 842b96a..4d47677 100644
--- a/pkg/detector/library/vendorjdk/vendorjdk.go
+++ b/pkg/detector/library/vendorjdk/vendorjdk.go
@@ -6,9 +6,11 @@ package vendorjdk
 
 import (
 	"context"
+	"strings"
 
 	"golang.org/x/xerrors"
 
+	osvinternal "github.com/bell-sw/osv-internal"
 	"github.com/bell-sw/osv-internal/match"
 	"github.com/bell-sw/osv-internal/osvdata"
 
@@ -99,8 +101,8 @@ func (s *Scanner) Detect(ctx context.Context, libType ftypes.LangType, pkgs []ft
 
 // matchRuntime evaluates one runtime against the index of its product family.
 // The ecosystem ("<family>:21", "<family>:23-21") is in SrcName; a
-// JDK without it (re-scanned from an SBOM purl) is placed by its version, a
-// NIK without it cannot be placed on a Java line and is skipped.
+// package without it (re-scanned from an SBOM purl) is placed by its version:
+// a JDK by its feature version, a NIK by nikRelease.
 func matchRuntime(idx *osvdata.Index, libType ftypes.LangType, pkg ftypes.Package) ([]match.Finding, error) {
 	if pkg.SrcName != "" {
 		return match.MatchProduct(idx, pkg.SrcName, pkg.Name, pkg.Version)
@@ -108,5 +110,42 @@ func matchRuntime(idx *osvdata.Index, libType ftypes.LangType, pkg ftypes.Packag
 	if libType == ftypes.VendorJDK {
 		return match.MatchJDK(idx, pkg.Name, pkg.Version)
 	}
-	return nil, xerrors.Errorf("%s %s@%s: the Java line of the runtime is unknown", libType, pkg.Name, pkg.Version)
+	release, ok := nikRelease(idx, pkg.Name, pkg.Version)
+	if !ok {
+		return nil, xerrors.Errorf("%s %s@%s: the Java line of the runtime is unknown", libType, pkg.Name, pkg.Version)
+	}
+	return match.MatchProduct(idx, osvinternal.Ecosystem(idx.Family, release), pkg.Name, pkg.Version)
+}
+
+// nikRelease finds the release ("23-21") of a NIK bundle from its version
+// alone. A NIK major can be built for several Java lines, each with its own
+// minor ("23.0.x" for Java 17, "23.1.x" for Java 21), and the version bounds
+// of a line's advisories are on that minor.
+func nikRelease(idx *osvdata.Index, bundle, version string) (string, bool) {
+	parts := strings.SplitN(version, ".", 3)
+	if len(parts) < 2 {
+		return "", false
+	}
+	major, line := parts[0], parts[0]+"."+parts[1]+"."
+	var candidates, sameLine []string
+	for _, release := range idx.Releases() {
+		if !strings.HasPrefix(release, major+"-") {
+			continue
+		}
+		candidates = append(candidates, release)
+		for _, adv := range idx.Advisories(bundle, release) {
+			if strings.HasPrefix(adv.Introduced, line) || strings.HasPrefix(adv.Fixed, line) ||
+				strings.HasPrefix(adv.LastAffected, line) {
+				sameLine = append(sameLine, release)
+				break
+			}
+		}
+	}
+	switch {
+	case len(sameLine) == 1:
+		return sameLine[0], true
+	case len(sameLine) == 0 && len(candidates) == 1:
+		return candidates[0], true
+	}
+	return "", false
 }
