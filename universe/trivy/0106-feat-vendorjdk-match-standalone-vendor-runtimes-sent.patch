diff --git a/pkg/scan/local/service.go b/pkg/scan/local/service.go
index 9f3c36c..d9086c8 100644
--- a/pkg/scan/local/service.go
+++ b/pkg/scan/local/service.go
@@ -86,6 +86,12 @@ func (s Service) Scan(ctx context.Context, targetName, artifactKey string, blobK
 		return types.ScanResponse{}, xerrors.Errorf("failed to apply layers: %w", err)
