diff --git a/pkg/scan/local/vendorjdk.go b/pkg/scan/local/vendorjdk.go
new file mode 100644
index 0000000..553d6d9
--- /dev/null
+++ b/pkg/scan/local/vendorjdk.go
@@ -0,0 +1,56 @@
+package local
+
+import (
+	"github.com/package-url/packageurl-go"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+
+	"github.com/aquasecurity/trivy/pkg/dependency"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/vendordb"
+)
+
+// liftVendorRuntimes moves standalone vendor runtimes sent as OS packages
+// (a server-mode client building the package list from purls sends
+// pkg:generic/<namespace>/<jdk or nik name> that way) into applications
+// of their product type, where the vendorjdk detector matches them.
+func liftVendorRuntimes(detail *ftypes.ArtifactDetail) {
+	runtimes := make(map[ftypes.LangType][]ftypes.Package)
+	var rest ftypes.Packages
+	for _, pkg := range detail.Packages {
+		p := pkg.Identifier.PURL
+		if p == nil || p.Type != packageurl.TypeGeneric || !vendordb.IsVendorRuntimePURL(p.Namespace, p.Name) {
+			rest = append(rest, pkg)
+			continue
+		}
+		t, _ := vendordb.LangTypeForPURLName(p.Name)
+		// The package name is the distribution variant, a purl qualifier.
+		if variant := p.Qualifiers.Map()[osvjdk.PURLQualifier]; variant != "" {
+			pkg.Name = variant
+		}
+		if p.Version != "" {
+			pkg.Version = p.Version
+		}
+		pkg.ID = dependency.ID(t, pkg.Name, pkg.Version)
+		// The source name of a runtime is its ecosystem ("<family>:21");
+		// anything else is a placeholder of the client.
+		if f := osvinternal.Family(pkg.SrcName); f != osvinternal.EcosystemJDK && f != osvinternal.EcosystemNIK {
+			pkg.SrcName = ""
+		}
+		pkg.SrcVersion, pkg.SrcRelease, pkg.SrcEpoch, pkg.Arch = "", "", 0, ""
+		runtimes[t] = append(runtimes[t], pkg)
+	}
+	if len(runtimes) == 0 {
+		return
+	}
+	detail.Packages = rest
+	for _, t := range []ftypes.LangType{ftypes.VendorJDK, ftypes.VendorNIK} {
+		if pkgs := runtimes[t]; len(pkgs) > 0 {
+			detail.Applications = append(detail.Applications, ftypes.Application{
+				Type:     t,
+				Packages: pkgs,
+			})
+		}
+	}
+}
diff --git a/pkg/scan/local/vendorjdk_test.go b/pkg/scan/local/vendorjdk_test.go
new file mode 100644
index 0000000..ec52500
--- /dev/null
+++ b/pkg/scan/local/vendorjdk_test.go
@@ -0,0 +1,71 @@
+package local
+
+import (
+	"testing"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+
+	"github.com/package-url/packageurl-go"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+)
+
+func purlOf(t *testing.T, s string) *packageurl.PackageURL {
+	t.Helper()
+	p, err := packageurl.FromString(s)
+	require.NoError(t, err)
+	return &p
+}
+
+func Test_liftVendorRuntimes(t *testing.T) {
+	nik2321 := osvinternal.Ecosystem(osvinternal.EcosystemNIK, "23-21")
+	jdk := purlOf(t, osvjdk.PURL("jdk-lite", "21.0.2+14"))
+	nik := purlOf(t, osvjdk.PURLNIK("core", "23.1.0+1"))
+	other := purlOf(t, "pkg:generic/acme/" + osvjdk.PURLNameJDK + "@1.0")
+	deb := purlOf(t, "pkg:deb/debian/zlib1g@1.2.13?distro=debian-12")
+	detail := ftypes.ArtifactDetail{
+		Packages: ftypes.Packages{
+			// as a purl-forwarding client sends them: purl name, source = binary
+			{Name: osvjdk.PURLNameJDK, Version: "21.0.2+14", SrcName: osvjdk.PURLNameJDK, SrcVersion: "21.0.2+14", Arch: "x86_64",
+				Identifier: ftypes.PkgIdentifier{PURL: jdk}},
+			// with the ecosystem the analyzer recorded as source name
+			{Name: osvjdk.PURLNameNIK, Version: "23.1.0+1", SrcName: nik2321, SrcVersion: "23.1.0+1",
+				Identifier: ftypes.PkgIdentifier{PURL: nik}},
+			{Name: osvjdk.PURLNameJDK, Version: "1.0", Identifier: ftypes.PkgIdentifier{PURL: other}},
+			{Name: "zlib1g", Version: "1.2.13", Identifier: ftypes.PkgIdentifier{PURL: deb}},
+			{Name: "nopurl", Version: "1"},
+		},
+	}
+	liftVendorRuntimes(&detail)
+
+	var left []string
+	for _, p := range detail.Packages {
+		left = append(left, p.Name)
+	}
+	assert.Equal(t, []string{osvjdk.PURLNameJDK, "zlib1g", "nopurl"}, left)
+
+	require.Len(t, detail.Applications, 2)
+	assert.Equal(t, ftypes.Application{
+		Type: ftypes.VendorJDK,
+		Packages: ftypes.Packages{{
+			ID: "jdk-lite@21.0.2+14", Name: "jdk-lite", Version: "21.0.2+14",
+			Identifier: ftypes.PkgIdentifier{PURL: jdk},
+		}},
+	}, detail.Applications[0])
+	assert.Equal(t, ftypes.Application{
+		Type: ftypes.VendorNIK,
+		Packages: ftypes.Packages{{
+			ID: "core@23.1.0+1", Name: "core", Version: "23.1.0+1", SrcName: nik2321,
+			Identifier: ftypes.PkgIdentifier{PURL: nik},
+		}},
+	}, detail.Applications[1])
+
+	// Nothing to lift: untouched.
+	plain := ftypes.ArtifactDetail{Packages: ftypes.Packages{{Name: "zlib1g", Version: "1.2.13"}}}
+	liftVendorRuntimes(&plain)
+	assert.Len(t, plain.Packages, 1)
+	assert.Empty(t, plain.Applications)
+}
