+// indexSource serves pre-built indexes, one per ecosystem family.
+type indexSource struct {
+	indexes map[string]*osvdata.Index
+	err     error
+}
+
+func (s indexSource) Ecosystem(_ context.Context, family string) (*osvdata.Index, error) {
+	if s.err != nil {
+		return nil, s.err
+	}
+	idx, ok := s.indexes[family]
+	if !ok {
+		return nil, xerrors.Errorf("no index for %s", family)
+	}
+	return idx, nil
+}
+
+// loadBucket zips testdata/bucket/<family>/*.json like the OSV bucket and
+// builds the index of every family (records renamed to the module's current
+// values by testfix.RewriteOSV).
+func loadBucket(t *testing.T) indexSource {
+	t.Helper()
+	src := indexSource{indexes: make(map[string]*osvdata.Index)}
+	for _, family := range osvinternal.Ecosystems {
+		dir := filepath.Join("testdata/bucket", testfix.UpstreamFamily(family))
+		files, err := os.ReadDir(dir)
+		if os.IsNotExist(err) {
+			continue
+		}
+		require.NoError(t, err)
+		zipPath := filepath.Join(t.TempDir(), "all.zip")
+		f, err := os.Create(zipPath)
+		require.NoError(t, err)
+		zw := zip.NewWriter(f)
+		for _, rec := range files {
+			b, err := os.ReadFile(filepath.Join(dir, rec.Name()))
+			require.NoError(t, err)
+			w, err := zw.Create(rec.Name())
+			require.NoError(t, err)
+			_, err = w.Write(testfix.RewriteOSV(b))
+			require.NoError(t, err)
+		}
+		require.NoError(t, zw.Close())
+		require.NoError(t, f.Close())
+		idx, err := osvdata.LoadArchive(zipPath, family)
+		require.NoError(t, err)
+		src.indexes[family] = idx
+	}
+	return src
+}
