diff --git a/pkg/vendordb/vendordb.go b/pkg/vendordb/vendordb.go
new file mode 100644
index 0000000..7454e44
--- /dev/null
+++ b/pkg/vendordb/vendordb.go
@@ -0,0 +1,282 @@
+// Package vendordb wires the vendor OSV advisory source into Trivy. The
+// advisories are not in Trivy DB; the shared github.com/bell-sw/osv-internal
+// module downloads the OSV bulk archives on demand and caches them under
+// <cache-dir>/<ecosystem>/. This package holds the process-wide source
+// configured from the flags (like db.Init for Trivy DB) and the Trivy
+// presentation of an advisory.
+package vendordb
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/xerrors"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	osvdistro "github.com/bell-sw/osv-internal/distro"
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+
+	dbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/log"
+	"github.com/aquasecurity/trivy/pkg/types"
+	xhttp "github.com/aquasecurity/trivy/pkg/x/http"
+)
+
+// Source IDs, one per ecosystem family.
+const (
+	SourceLinux    dbTypes.SourceID = osvdistro.IDLinux
+	SourceHardened dbTypes.SourceID = osvdistro.IDHardened
+	SourceJDK      dbTypes.SourceID = osvjdk.PURLNameJDK
+)
+
+// Options are the user-facing settings of the OSV source.
+type Options struct {
+	// CacheDir is the Trivy cache directory.
+	CacheDir string
+	// BaseURL is the base of "<ecosystem>/all.zip" for every family
+	// (--vendor-url); empty means the module's default of each family.
+	BaseURL string
+	// Strict makes an unavailable archive an error instead of a warning
+	// (--vendor-strict).
+	Strict bool
+	// URLs overrides the archive location per ecosystem (--vendor-feed).
+	URLs map[string]string
+	// SkipUpdate is true with --skip-db-update or --offline-scan.
+	SkipUpdate bool
+	// Quiet suppresses progress logging.
+	Quiet bool
+}
+
+// AdvisorySource serves the advisory index of an ecosystem family.
+// *osvdata.Source implements it; tests inject an index built from a file.
+type AdvisorySource interface {
+	Ecosystem(ctx context.Context, family string) (*osvdata.Index, error)
+}
+
+var (
+	mu     sync.Mutex
+	source *osvdata.Source
+	strict bool
+	// warned holds the families whose "unavailable" warning was printed, so
+	// that it appears once per family and not once per scanned layer.
+	warned = make(map[string]struct{})
+)
+
+// Init configures the process-wide source. It is called by the command layer
+// once the flags are parsed; drivers resolve the source lazily at scan time
+// because they are constructed at package initialization.
+func Init(opts Options) {
+	mu.Lock()
+	defer mu.Unlock()
+	source = newSource(opts)
+	strict = opts.Strict
+	warned = make(map[string]struct{})
+}
+
+func newSource(opts Options) *osvdata.Source {
+	if opts.CacheDir == "" {
+		opts.CacheDir = defaultCacheDir()
+	}
+	src := &osvdata.Source{
+		BaseURL:    opts.BaseURL,
+		URLs:       opts.URLs,
+		CacheDir:   opts.CacheDir,
+		Offline:    opts.SkipUpdate,
+		HTTPClient: xhttp.Client(),
+		UserAgent:  "trivy osv-internal/" + osvinternal.Version,
+	}
+	// the module's own prefix is redundant in Trivy's log
+	msg := func(format string, args ...any) string {
+		return strings.TrimPrefix(fmt.Sprintf(format, args...), "osv-internal: ")
+	}
+	if opts.Quiet {
+		src.Logf = func(format string, args ...any) { log.Debug(msg(format, args...)) }
+	} else {
+		src.Logf = func(format string, args ...any) { log.Info(msg(format, args...)) }
+	}
+	return src
+}
+
+// defaultCacheDir mirrors cache.DefaultDir without importing the cache package.
+func defaultCacheDir() string {
+	dir, err := os.UserCacheDir()
+	if err != nil {
+		dir = os.TempDir()
+	}
+	return filepath.Join(dir, "trivy")
+}
+
+// Source returns the process-wide source, created with defaults when Init
+// was never called (library use, unit tests).
+func Source() *osvdata.Source {
+	mu.Lock()
+	defer mu.Unlock()
+	if source == nil {
+		source = newSource(Options{})
+	}
+	return source
+}
+
+// Download fetches every vendor archive into the cache (--download-db-only).
+// An unavailable family is warned about as during a scan and the others are
+// still downloaded, unless strict mode is on.
+func Download(ctx context.Context) error {
+	src := Source()
+	for _, family := range osvinternal.Ecosystems {
+		err := src.Update(ctx, family)
+		if err == nil {
+			continue
+		}
+		if w := osvdata.UnavailableWarning(err); w != "" && !isStrict() {
+			warnOnce(ctx, family, w)
+			continue
+		}
+		return xerrors.Errorf("%s OSV download error: %w", osvinternal.Vendor, err)
+	}
+	return nil
+}
+
+// Index returns the advisory index of a family from src. An unavailable
+// archive is logged once per family with the module's canonical warning and
+// yields a nil index and nil error (no findings for that family); in strict
+// mode, and for any other failure, the error is returned.
+func Index(ctx context.Context, src AdvisorySource, family string) (*osvdata.Index, error) {
+	idx, err := src.Ecosystem(ctx, family)
+	if err == nil {
+		WarnIfStale(ctx, idx)
+		return idx, nil
+	}
+	if w := osvdata.UnavailableWarning(err); w != "" && !isStrict() {
+		warnOnce(ctx, family, w)
+		return nil, nil
+	}
+	return nil, xerrors.Errorf("failed to load the %s advisories for %s: %w", osvinternal.Vendor, family, err)
+}
+
+func isStrict() bool {
+	mu.Lock()
+	defer mu.Unlock()
+	return strict
+}
+
+func warnOnce(ctx context.Context, family, warning string) {
+	mu.Lock()
+	_, done := warned[family]
+	warned[family] = struct{}{}
+	mu.Unlock()
+	if !done {
+		log.WarnContext(ctx, warning)
+	}
+}
+
+// WarnIfStale logs when the module served an expired cache because the
+// download failed, so that stale results are never silent.
+func WarnIfStale(ctx context.Context, idx *osvdata.Index) {
+	if idx != nil && idx.Stale {
+		log.WarnContext(ctx, "The vendor OSV archive could not be refreshed; using the cached copy",
+			log.String("ecosystem", idx.Family), log.String("downloaded_at", idx.DownloadedAt.Format(time.RFC3339)))
+	}
+}
+
+// Clear removes the cached archives and indexes (trivy clean --vuln-db); the
+// families live directly in the Trivy cache directory, so only they go.
+func Clear(ctx context.Context, cacheDir string) error {
+	src := &osvdata.Source{CacheDir: cacheDir}
+	for _, family := range osvinternal.Ecosystems {
+		dir := src.CachePath(family)
+		log.DebugContext(ctx, "Removing the vendor OSV cache", log.String("dir", dir))
+		if err := os.RemoveAll(dir); err != nil {
+			return xerrors.Errorf("unable to remove %s: %w", dir, err)
+		}
+	}
+	return nil
+}
+
+// DataSource describes where an advisory of the given ecosystem comes from.
+// recordURL is the canonical record (database_specific.source) when known.
+func DataSource(ecosystem, recordURL string) *dbTypes.DataSource {
+	ds := &dbTypes.DataSource{
+		Name: osvinternal.Vendor + " OSV database",
+		URL:  "https://github.com/bell-sw/osv-database",
+	}
+	family := osvinternal.Family(ecosystem)
+	switch family {
+	case osvinternal.EcosystemLinux:
+		ds.ID = SourceLinux
+	case osvinternal.EcosystemHardened:
+		ds.ID = SourceHardened
+	case osvinternal.EcosystemJDK:
+		ds.ID = SourceJDK
+	}
+	if ds.ID != "" {
+		ds.Name = family + " OSV database"
+	}
+	if recordURL != "" {
+		ds.URL = recordURL
+	}
+	return ds
+}
+
+// Vulnerability converts a finding of the shared matcher into the Trivy
+// finding: the CVE as vulnerability id, the OSV record id as vendor id, plus
+// the severity, CVSS and references the vendor publishes.
+func Vulnerability(f match.Finding) types.DetectedVulnerability {
+	adv := f.Advisory
+	ds := DataSource(f.Ecosystem, adv.SourceURL)
+	v := types.DetectedVulnerability{
+		VulnerabilityID:  adv.CVE,
+		VendorIDs:        []string{adv.ID},
+		InstalledVersion: f.InstalledVersion,
+		FixedVersion:     f.FixedVersion,
+		DataSource:       ds,
+		Vulnerability: dbTypes.Vulnerability{
+			Title:       adv.Summary,
+			Description: adv.Details,
+		},
+	}
+	if adv.CVE == adv.ID {
+		v.VendorIDs = nil
+	}
+	for _, alias := range adv.Aliases {
+		if alias != adv.CVE && alias != adv.ID {
+			v.VendorIDs = append(v.VendorIDs, alias)
+		}
+	}
+	for _, ref := range adv.References {
+		if ref.URL != "" {
+			v.References = append(v.References, ref.URL)
+		}
+	}
+	if !adv.Published.IsZero() {
+		t := adv.Published
+		v.PublishedDate = &t
+	}
+	if !adv.Modified.IsZero() {
+		t := adv.Modified
+		v.LastModifiedDate = &t
+	}
+	if adv.Severity != "" && adv.Severity != dbTypes.SeverityUnknown.String() {
+		v.Severity = adv.Severity
+		v.SeveritySource = ds.ID
+	}
+	if adv.CVSSVector != "" {
+		cvss := dbTypes.CVSS{}
+		switch adv.CVSSVersion {
+		case "2.0", "2":
+			cvss.V2Vector, cvss.V2Score = adv.CVSSVector, adv.CVSSScore
+		case "4.0", "4":
+			cvss.V40Vector, cvss.V40Score = adv.CVSSVector, adv.CVSSScore
+		default:
+			cvss.V3Vector, cvss.V3Score = adv.CVSSVector, adv.CVSSScore
+		}
+		v.CVSS = dbTypes.VendorCVSS{ds.ID: cvss}
+	}
+	return v
+}
diff --git a/pkg/vendordb/vendordb_test.go b/pkg/vendordb/vendordb_test.go
new file mode 100644
index 0000000..7193999
--- /dev/null
+++ b/pkg/vendordb/vendordb_test.go
@@ -0,0 +1,126 @@
+package vendordb_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	"github.com/aquasecurity/trivy/pkg/vendordb"
+)
+
+// archiveURL is where the module fetches the archive of a family below a base URL (<base>/<family>/all.zip).
+func archiveURL(base, family string) string {
+	return base + "/" + url.PathEscape(family) + "/" + osvdata.ArchiveName
+}
+
+// recorder answers every request with 404 and remembers the URLs.
+type recorder struct {
+	mu   sync.Mutex
+	urls []string
+}
+
+func (r *recorder) RoundTrip(req *http.Request) (*http.Response, error) {
+	r.mu.Lock()
+	r.urls = append(r.urls, req.URL.String())
+	r.mu.Unlock()
+	return &http.Response{
+		StatusCode: http.StatusNotFound,
+		Status:     "404 Not Found",
+		Body:       http.NoBody,
+		Header:     make(http.Header),
+		Request:    req,
+	}, nil
+}
+
+// With no configuration every family is requested from its own default: the
+// osv.dev bucket for the distributions, the product base URL for the runtimes.
+func TestDefaultSources(t *testing.T) {
+	vendordb.Init(vendordb.Options{CacheDir: t.TempDir(), Quiet: true})
+	src := vendordb.Source()
+	rec := &recorder{}
+	src.HTTPClient = &http.Client{Transport: rec}
+
+	want := map[string]string{
+		osvinternal.EcosystemLinux:    archiveURL(osvdata.DefaultBaseURL, osvinternal.EcosystemLinux),
+		osvinternal.EcosystemHardened: archiveURL(osvdata.DefaultBaseURL, osvinternal.EcosystemHardened),
+		osvinternal.EcosystemJDK:      archiveURL(osvdata.DefaultProductBaseURL, osvinternal.EcosystemJDK),
+		osvinternal.EcosystemNIK:      archiveURL(osvdata.DefaultProductBaseURL, osvinternal.EcosystemNIK),
+	}
+	for family, url := range want {
+		rec.urls = nil
+		idx, err := vendordb.Index(context.Background(), src, family)
+		require.NoError(t, err, family) // unavailable: a warning, not an error
+		assert.Nil(t, idx, family)
+		assert.Equal(t, []string{url}, rec.urls, family)
+	}
+}
+
+// An explicit base URL applies to every family; a per-family source wins.
+func TestConfiguredSources(t *testing.T) {
+	vendordb.Init(vendordb.Options{
+		CacheDir: t.TempDir(),
+		BaseURL:  "https://mirror.example/osv",
+		URLs:     map[string]string{osvinternal.EcosystemNIK: "https://nik.example/data"},
+		Quiet:    true,
+	})
+	src := vendordb.Source()
+	assert.Equal(t, archiveURL("https://mirror.example/osv", osvinternal.EcosystemLinux), src.ArchiveURL(osvinternal.EcosystemLinux))
+	assert.Equal(t, archiveURL("https://mirror.example/osv", osvinternal.EcosystemJDK), src.ArchiveURL(osvinternal.EcosystemJDK))
+	assert.Equal(t, archiveURL("https://nik.example/data", osvinternal.EcosystemNIK), src.ArchiveURL(osvinternal.EcosystemNIK))
+}
+
+type failingSource struct{ err error }
+
+func (s failingSource) Ecosystem(context.Context, string) (*osvdata.Index, error) {
+	return nil, s.err
+}
+
+func TestIndex_Unavailable(t *testing.T) {
+	unavailable := &osvdata.UnavailableError{
+		Family: osvinternal.EcosystemJDK,
+		URL:    archiveURL(osvdata.DefaultProductBaseURL, osvinternal.EcosystemJDK),
+		Reason: "HTTP 404",
+	}
+	assert.Equal(t, fmt.Sprintf("%s OSV data for %q is unavailable (HTTP 404); packages of this product were NOT checked against %s advisories. Source: %s",
+		osvinternal.Vendor, osvinternal.EcosystemJDK, osvinternal.Vendor, unavailable.URL), osvdata.UnavailableWarning(unavailable))
+
+	t.Run("default: warn and continue", func(t *testing.T) {
+		vendordb.Init(vendordb.Options{CacheDir: t.TempDir()})
+		idx, err := vendordb.Index(context.Background(), failingSource{err: unavailable}, osvinternal.EcosystemJDK)
+		require.NoError(t, err)
+		assert.Nil(t, idx)
+	})
+	t.Run("strict: fail", func(t *testing.T) {
+		vendordb.Init(vendordb.Options{CacheDir: t.TempDir(), Strict: true})
+		_, err := vendordb.Index(context.Background(), failingSource{err: unavailable}, osvinternal.EcosystemJDK)
+		require.ErrorContains(t, err, "failed to load the "+osvinternal.Vendor+" advisories for "+osvinternal.EcosystemJDK)
+		var ue *osvdata.UnavailableError
+		assert.ErrorAs(t, err, &ue)
+	})
+	t.Run("skip update with nothing cached: warn and continue", func(t *testing.T) {
+		vendordb.Init(vendordb.Options{CacheDir: t.TempDir(), SkipUpdate: true})
+		idx, err := vendordb.Index(context.Background(), vendordb.Source(), osvinternal.EcosystemLinux)
+		require.NoError(t, err)
+		assert.Nil(t, idx)
+	})
+	t.Run("skip update with nothing cached, strict: fail", func(t *testing.T) {
+		vendordb.Init(vendordb.Options{CacheDir: t.TempDir(), SkipUpdate: true, Strict: true})
+		_, err := vendordb.Index(context.Background(), vendordb.Source(), osvinternal.EcosystemLinux)
+		require.ErrorIs(t, err, osvdata.ErrNotCached)
+	})
+	t.Run("another failure is always an error", func(t *testing.T) {
+		vendordb.Init(vendordb.Options{CacheDir: t.TempDir()})
+		_, err := vendordb.Index(context.Background(), failingSource{err: errors.New("cache directory is not writable")}, osvinternal.EcosystemLinux)
+		require.ErrorContains(t, err, "cache directory is not writable")
+	})
+}
