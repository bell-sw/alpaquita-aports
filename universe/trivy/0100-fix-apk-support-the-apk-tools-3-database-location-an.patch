 		Version:    "1.6.0-r0",
 		SrcName:    "pkgconf",
 		SrcVersion: "1.6.0-r0",
@@ -481,6 +482,12 @@ func TestRequired(t *testing.T) {
 			filePath: "usr/lib/apk/db/installed",
 			want:     true,
 		},
+		{
+			// apk-tools 3.x
+			name:     "apk-tools 3 database location",
+			filePath: "var/lib/apk/db/installed",
+			want:     true,
+		},
 		{
 			name:     "unrelated file",
 			filePath: "etc/os-release",
@@ -501,3 +508,28 @@ func TestRequired(t *testing.T) {
 		})
 	}
 }
+
+// TestParseApkInfo_Provides: the package-name entries of "p:" are kept on the
+// package, capabilities are not.
+func TestParseApkInfo_Provides(t *testing.T) {
+	f, err := os.Open("testdata/apk-provides")
+	require.NoError(t, err)
+	defer f.Close()
+
+	a := alpinePkgAnalyzer{}
+	gotPkgs, _ := a.parseApkInfo(t.Context(), bufio.NewScanner(f))
+
+	require.Len(t, gotPkgs, 2)
+
+	assert.Equal(t, "jdk21-lite-jdk-no-deps", gotPkgs[0].Name)
+	assert.Equal(t, "jdk21-lite", gotPkgs[0].SrcName)
+	assert.Equal(t, []string{
+		"java-jdk-no-deps",
+		"java21-jdk-no-deps",
+		"openjdk21-lite-jdk-no-deps",
+	}, gotPkgs[0].Provides)
+
+	// "cmd:apk" is a capability, not a package name
+	assert.Equal(t, "apk-tools", gotPkgs[1].Name)
+	assert.Empty(t, gotPkgs[1].Provides)
+}
