index 547009e..ed50ba6 100644
--- a/pkg/fanal/analyzer/pkg/apk/apk.go
+++ b/pkg/fanal/analyzer/pkg/apk/apk.go
@@ -27,9 +27,17 @@ func init() {
 	analyzer.RegisterAnalyzer(newAlpinePkgAnalyzer())
 }
 
-const analyzerVersion = 3
-
-var requiredFiles = []string{"lib/apk/db/installed", "usr/lib/apk/db/installed"}
+const analyzerVersion = 4
+
+// requiredFiles lists the locations of the apk installed database: the
+// apk-tools 2 ones and var/lib/apk/db/installed of apk-tools 3, which moved
+// the database out of /lib (distributions shipping it have no /lib/apk
+// symlink).
+var requiredFiles = []string{
+	"lib/apk/db/installed",
+	"usr/lib/apk/db/installed",
+	"var/lib/apk/db/installed",
+}
 
 type alpinePkgAnalyzer struct{}
 
@@ -98,7 +106,7 @@ func (a alpinePkgAnalyzer) parseApkInfo(ctx context.Context, scanner *bufio.Scan
 			pkg.InstalledFiles = append(pkg.InstalledFiles, absPath)
 			installedFiles = append(installedFiles, absPath)
 		case "p:": // provides (corresponds to provides in PKGINFO, concatenated by spaces into a single line)
-			a.parseProvides(line, pkg.ID, provides)
+			pkg.Provides = a.parseProvides(line, pkg.ID, provides)
 		case "D:": // dependencies (corresponds to depend in PKGINFO, concatenated by spaces into a single line)
 			pkg.DependsOn = a.parseDependencies(line)
 		case "A:":
@@ -149,13 +157,29 @@ func (a alpinePkgAnalyzer) parseLicense(line string) []string {
 	return licensing.LaxSplitLicenses(line[2:])
 }
 
-func (a alpinePkgAnalyzer) parseProvides(line, pkgID string, provides map[string]string) {
+// parseProvides records every provided name in the provides map used to resolve
+// the dependency graph, and returns the subset that are package name aliases so
+// that they can be kept on the package itself.
+func (a alpinePkgAnalyzer) parseProvides(line, pkgID string, provides map[string]string) []string {
+	var pkgProvides []string
 	for p := range strings.FieldsSeq(line[2:]) {
 		p = a.trimRequirement(p)
 
 		// Assume name ("P:") and version ("V:") are defined before provides ("p:")
 		provides[p] = pkgID
+
+		if isPkgNameProvide(p) {
+			pkgProvides = append(pkgProvides, p)
+		}
 	}
+	return pkgProvides
+}
+
+// isPkgNameProvide reports whether a provided name is an alternative package
+// name ("openjdk21-lite-jdk-no-deps") rather than a namespaced capability
+// ("so:libz.so.1", "cmd:apk", "pc:sqlite3") or a path ("/bin/sh").
+func isPkgNameProvide(name string) bool {
+	return name != "" && !strings.Contains(name, ":") && !strings.HasPrefix(name, "/")
 }
 
 func (a alpinePkgAnalyzer) parseDependencies(line string) []string {
