+// Every family of the module is matched with the grammar of its kind against
+// its own archive and reports its own source.
+func TestScanner_Detect_EveryFamily(t *testing.T) {
+	src := indexSource{idx: loadIndexes(t)}
+	for _, p := range osvinternal.Products {
+		t.Run(p.Family, func(t *testing.T) {
+			pkg := ftypes.Package{Name: "jdk", Version: "21.0.2+14"}
+			if p.Kind == osvinternal.KindNIK {
+				pkg = ftypes.Package{Name: "core", Version: "23.1.0+1"}
+			}
+			got, err := vendorjdk.NewScanner(vendorjdk.WithSource(src)).Detect(context.Background(), vendordb.LangTypeOf(p), []ftypes.Package{pkg})
+			require.NoError(t, err)
+			require.Len(t, got, 1)
+			assert.Equal(t, vendordb.SourceOf(p), got[0].SeveritySource)
+			assert.Equal(t, vendordb.SourceOf(p), got[0].DataSource.ID)
+			assert.Equal(t, p.Family+" OSV database", got[0].DataSource.Name)
+		})
+	}
+}
