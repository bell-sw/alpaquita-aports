+// Every product family of the module has its own package type and source id,
+// the family's purl name, and each maps back to the family.
+func TestProductTypes(t *testing.T) {
+	require.NotEmpty(t, osvinternal.Products)
+	require.Len(t, vendordb.LangTypes(), len(osvinternal.Products))
+	require.Len(t, vendordb.ProductSources(), len(osvinternal.Products))
+	for i, p := range osvinternal.Products {
+		typ := vendordb.LangTypeOf(p)
+		assert.Equal(t, ftypes.LangType(p.PURLName), typ)
+		assert.Equal(t, typ, vendordb.LangTypes()[i])
+		assert.Equal(t, dbTypes.SourceID(p.PURLName), vendordb.SourceOf(p))
+		assert.Equal(t, vendordb.SourceOf(p), vendordb.ProductSources()[i])
+
+		got, ok := vendordb.ProductForLangType(typ)
+		assert.True(t, ok)
+		assert.Equal(t, p, got)
+		family, ok := vendordb.FamilyForLangType(typ)
+		assert.True(t, ok)
+		assert.Equal(t, p.Family, family)
+		back, ok := vendordb.LangTypeForFamily(p.Family)
+		assert.True(t, ok)
+		assert.Equal(t, typ, back)
+		assert.Equal(t, p.PURLName, vendordb.PURLName(typ))
+		back, ok = vendordb.LangTypeForPURLName(p.PURLName)
+		assert.True(t, ok)
+		assert.Equal(t, typ, back)
+		assert.True(t, vendordb.IsVendorRuntime(typ))
+		assert.True(t, vendordb.IsVendorRuntimePURL(osvinternal.PURLNamespace, p.PURLName))
+		assert.False(t, vendordb.IsVendorRuntimePURL("acme", p.PURLName))
+
+		ds := vendordb.DataSource(p.Ecosystem("21"), "https://example.com/record.json")
+		assert.Equal(t, vendordb.SourceOf(p), ds.ID)
+		assert.Equal(t, p.Family+" OSV database", ds.Name)
+		assert.Equal(t, "https://example.com/record.json", ds.URL)
+	}
+
+	_, ok := vendordb.ProductForLangType(ftypes.Jar)
+	assert.False(t, ok)
+	assert.False(t, vendordb.IsVendorRuntime(ftypes.Jar))
+	assert.Equal(t, "", vendordb.PURLName(ftypes.Jar))
+	_, ok = vendordb.LangTypeForFamily(osvinternal.EcosystemLinux)
+	assert.False(t, ok)
+	_, ok = vendordb.LangTypeForPURLName("openssl")
+	assert.False(t, ok)
+	assert.False(t, vendordb.IsVendorRuntimePURL(osvinternal.PURLNamespace, "openssl"))
+}
