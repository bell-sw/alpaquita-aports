pkgname=trivy
pkgver=0.74.0
pkgrel=9
pkgdesc="Comprehensive vulnerability scanner for containers, filesystems, repositories and SBOMs"
url="https://trivy.dev/"
arch="all"
license="Apache-2.0"
makedepends="go osv-internal>=0.5.5"
_osvmod=github.com/bell-sw/osv-internal
subpackages="
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
options="net"
source="https://github.com/aquasecurity/trivy/archive/v$pkgver/trivy-$pkgver.tar.gz
	0100-fix-apk-support-the-apk-tools-3-database-location-an.patch
	0101-feat-vendorapk-add-the-vendor-s-apk-based-distributi.patch
	0102-build-compile-and-behave-the-same-with-Go-1.26-and-G.patch
	0103-feat-vendordb-read-the-vendor-advisories-from-the-OS.patch
	0104-feat-vendorjdk-detect-standalone-vendor-JDK-and-NIK-.patch
	0105-fix-vendorapk-resolve-the-source-package-from-the-pu.patch
	0106-feat-vendorjdk-match-standalone-vendor-runtimes-sent.patch
	0107-feat-vendorjdk-one-package-type-per-product-family-o.patch
	"

# Trivy 0.74.0 is built with the jsonv2 experiment upstream (goreleaser.yml)
export GOEXPERIMENT=jsonv2
export GOFLAGS="$GOFLAGS -modcacherw -trimpath"
export CGO_ENABLED=0

prepare() {
	default_prepare

	go mod edit -replace $_osvmod=/usr/share/go-modules/$_osvmod
}

build() {
	go build -ldflags " \
		-X github.com/aquasecurity/trivy/pkg/version/app.ver=$pkgver" \
		-o bin/trivy ./cmd/trivy

	./bin/trivy completion bash > $pkgname.bash
	./bin/trivy completion zsh > $pkgname.zsh
	./bin/trivy completion fish > $pkgname.fish
}

check() {
	# The packages touched by the vendor patches; the full upstream suite
	# needs network fixtures and docker. -vet=off: with the go 1.26 directive,
	# Go 1.27's vet flags every encoding/json/v2 use as "requires go1.27"
	# (stdversion notes, not errors). pkg/iac/scanners/cloudformation/parser
	# (also touched) needs integration/testimages.ini, which the release tarball
	# does not ship; it is tested in the source tree (tests/unit.log).
	go test -vet=off ./pkg/vendordb/... \
		./pkg/detector/ospkg/vendorapk/... \
		./pkg/detector/library/... \
		./pkg/fanal/analyzer/language/java/vendorjdk/... \
		./pkg/fanal/analyzer/os/release/... \
		./pkg/fanal/analyzer/pkg/apk/... \
		./pkg/scan/langpkg/... \
		./pkg/scan/local/... \
		./pkg/sbom/... \
		./pkg/purl/... \
		./pkg/flag/... \
		./pkg/x/json/... \
		./pkg/result/...
}

package() {
	install -Dm755 bin/trivy -t "$pkgdir"/usr/bin/

	install -Dm644 $pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 $pkgname.zsh "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
	install -Dm644 $pkgname.fish "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
}

