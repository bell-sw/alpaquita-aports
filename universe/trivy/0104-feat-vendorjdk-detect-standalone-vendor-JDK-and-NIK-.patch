+		Type:    core.TypeLibrary,
+		Group:   osvjdk.PURLNamespace,
+		Name:    osvjdk.PURLNameJDK,
+		Version: "21.0.11.0.1+1",
+		PkgIdentifier: ftypes.PkgIdentifier{
+			PURL: &packageurl.PackageURL{
+				Type:      packageurl.TypeGeneric,
+				Namespace: osvjdk.PURLNamespace,
+				Name:      osvjdk.PURLNameJDK,
+				Version:   "21.0.11.0.1+1",
+				Qualifiers: packageurl.Qualifiers{
+					{Key: "package_type", Value: "jdk"},
+				},
+			},
+		},
+	})
+
+	var got types.SBOM
+	require.NoError(t, sbomio.NewDecoder(bom).Decode(t.Context(), &got))
+	require.Len(t, got.Applications, 1)
+	assert.Equal(t, ftypes.VendorJDK, got.Applications[0].Type)
+	require.Len(t, got.Applications[0].Packages, 1)
+	assert.Equal(t, "jdk", got.Applications[0].Packages[0].Name)
+	assert.Equal(t, "21.0.11.0.1+1", got.Applications[0].Packages[0].Version)
+}
