+// Standalone runtime families (the module's names); Trivy maps a family to a
+// package type and back for SBOMs.
+const (
+	// EcosystemNIK is the family of the Native Image Kit, "<family>:<nik major>-<java major>".
+	EcosystemNIK = osvinternal.EcosystemNIK
+	// PURLNameJDK and PURLNameNIK are the purl names under the module's namespace.
+	PURLNameJDK = osvjdk.PURLNameJDK
+	PURLNameNIK = osvjdk.PURLNameNIK
