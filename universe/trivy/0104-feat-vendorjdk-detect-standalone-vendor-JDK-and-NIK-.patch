diff --git a/pkg/detector/library/vendorjdk/vendorjdk.go b/pkg/detector/library/vendorjdk/vendorjdk.go
new file mode 100644
index 0000000..842b96a
--- /dev/null
+++ b/pkg/detector/library/vendorjdk/vendorjdk.go
@@ -0,0 +1,112 @@
+// Package vendorjdk detects vulnerabilities of standalone vendor runtimes
+// (JDK and Native Image Kit) found by the vendorjdk analyzer, matched by the
+// shared osv-internal module against the JDK ("<family>:<major>") and NIK
+// ("<family>:<nik major>-<java major>") ecosystems of the vendor OSV source.
+package vendorjdk
+
+import (
+	"context"
+
+	"golang.org/x/xerrors"
+
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/log"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/vendordb"
+)
+
+// Option configures a Scanner.
+type Option func(*Scanner)
+
+// WithSource replaces the advisory source (for tests).
+func WithSource(src vendordb.AdvisorySource) Option {
+	return func(s *Scanner) {
+		s.src = src
+	}
+}
+
+// Scanner matches standalone runtimes against the advisories of their family.
+type Scanner struct {
+	src    vendordb.AdvisorySource
+	logger *log.Logger
+}
+
+// NewScanner is the factory method for Scanner.
+func NewScanner(opts ...Option) *Scanner {
+	s := &Scanner{logger: log.WithPrefix("vendor-jdk")}
+	for _, opt := range opts {
+		opt(s)
+	}
+	return s
+}
+
+func (s *Scanner) source() vendordb.AdvisorySource {
+	if s.src != nil {
+		return s.src
+	}
+	return vendordb.Source()
+}
+
+// Detect returns the vulnerabilities of the given runtimes of one product
+// type; a package's name is the variant ("jdk", "core", ...) and its version
+// the product version ("21.0.2+14", "8u402+7", "23.1.0+1").
+func (s *Scanner) Detect(ctx context.Context, libType ftypes.LangType, pkgs []ftypes.Package) ([]types.DetectedVulnerability, error) {
+	if len(pkgs) == 0 {
+		return nil, nil
+	}
+	family, ok := vendordb.FamilyForLangType(libType)
+	if !ok {
+		return nil, xerrors.Errorf("%s is not a vendor runtime type", libType)
+	}
+	idx, err := vendordb.Index(ctx, s.source(), family)
+	if err != nil {
+		return nil, err
+	}
+	if idx == nil {
+		// unavailable archive (warned): no findings
+		return nil, nil
+	}
+
+	var vulns []types.DetectedVulnerability
+	for _, pkg := range pkgs {
+		if pkg.Version == "" {
+			s.logger.DebugContext(ctx, "Skipping a runtime without a version", log.String("name", pkg.Name),
+				log.FilePath(pkg.FilePath))
+			continue
+		}
+		findings, err := matchRuntime(idx, libType, pkg)
+		if err != nil {
+			s.logger.DebugContext(ctx, "Skipping a runtime the feed cannot evaluate",
+				log.String("name", pkg.Name), log.String("version", pkg.Version), log.Err(err))
+			continue
+		}
+		for _, f := range findings {
+			v := vendordb.Vulnerability(f)
+			v.PkgID = pkg.ID
+			v.PkgName = pkg.Name
+			v.InstalledVersion = pkg.Version
+			v.PkgPath = pkg.FilePath
+			v.Layer = pkg.Layer
+			v.PkgIdentifier = pkg.Identifier
+			vulns = append(vulns, v)
+		}
+	}
+	return vulns, nil
+}
+
+// matchRuntime evaluates one runtime against the index of its product family.
+// The ecosystem ("<family>:21", "<family>:23-21") is in SrcName; a
+// JDK without it (re-scanned from an SBOM purl) is placed by its version, a
+// NIK without it cannot be placed on a Java line and is skipped.
+func matchRuntime(idx *osvdata.Index, libType ftypes.LangType, pkg ftypes.Package) ([]match.Finding, error) {
+	if pkg.SrcName != "" {
+		return match.MatchProduct(idx, pkg.SrcName, pkg.Name, pkg.Version)
+	}
+	if libType == ftypes.VendorJDK {
+		return match.MatchJDK(idx, pkg.Name, pkg.Version)
+	}
+	return nil, xerrors.Errorf("%s %s@%s: the Java line of the runtime is unknown", libType, pkg.Name, pkg.Version)
+}
diff --git a/pkg/detector/library/vendorjdk/vendorjdk_test.go b/pkg/detector/library/vendorjdk/vendorjdk_test.go
new file mode 100644
index 0000000..71a6792
--- /dev/null
+++ b/pkg/detector/library/vendorjdk/vendorjdk_test.go
@@ -0,0 +1,347 @@
+package vendorjdk_test
+
+import (
+	"archive/zip"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/xerrors"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/osvdata"
+	"github.com/bell-sw/osv-internal/testfix"
+
+	dbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/detector/library/vendorjdk"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/vendordb"
+)
+
+type indexSource struct {
+	idx map[string]*osvdata.Index
+	err error
+}
+
+func (s indexSource) Ecosystem(_ context.Context, family string) (*osvdata.Index, error) {
+	if s.err != nil {
+		return nil, s.err
+	}
+	idx, ok := s.idx[family]
+	if !ok {
+		return nil, xerrors.Errorf("unexpected family %s", family)
+	}
+	return idx, nil
+}
+
+// loadIndexes zips testdata/*.json into an archive and builds the index of
+// each product family from it (the prototype archives carry the same records).
+func loadIndexes(t *testing.T) map[string]*osvdata.Index {
+	t.Helper()
+	return map[string]*osvdata.Index{
+		osvinternal.EcosystemJDK: loadIndex(t, osvinternal.EcosystemJDK),
+		osvinternal.EcosystemNIK: loadIndex(t, osvinternal.EcosystemNIK),
+	}
+}
+
+func loadIndex(t *testing.T, family string) *osvdata.Index {
+	t.Helper()
+	return loadIndexFrom(t, "testdata/*.json", family)
+}
+
+func loadIndexFrom(t *testing.T, pattern, family string) *osvdata.Index {
+	t.Helper()
+	zipPath := filepath.Join(t.TempDir(), "all.zip")
+	f, err := os.Create(zipPath)
+	require.NoError(t, err)
+	zw := zip.NewWriter(f)
+	files, err := filepath.Glob(pattern)
+	require.NoError(t, err)
+	for _, name := range files {
+		b, err := os.ReadFile(name)
+		require.NoError(t, err)
+		w, err := zw.Create(filepath.Base(name))
+		require.NoError(t, err)
+		_, err = w.Write(testfix.RewriteOSV(b))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, f.Close())
+	idx, err := osvdata.LoadArchive(zipPath, family)
+	require.NoError(t, err)
+	return idx
+}
+
+func TestScanner_Detect(t *testing.T) {
+	src := indexSource{idx: loadIndexes(t)}
+	jdk21 := ftypes.Package{
+		ID:       "jdk@21.0.2+14",
+		Name:     "jdk",
+		Version:  "21.0.2+14",
+		SrcName:  osvinternal.Ecosystem(osvinternal.EcosystemJDK, "21"),
+		FilePath: "opt/jdk-21.0.2",
+		Layer:    ftypes.Layer{DiffID: "sha256:aaaa"},
+	}
+	nikSource := &dbTypes.DataSource{
+		ID:   vendordb.SourceNIK,
+		Name: osvinternal.EcosystemNIK + " OSV database",
+		URL:  "https://github.com/bell-sw/osv-database/blob/master/BELL-CVE/BELL-CVE-2025-23165.json",
+	}
+	tests := []struct {
+		name    string
+		libType ftypes.LangType
+		src     vendordb.AdvisorySource
+		pkgs    []ftypes.Package
+		want    []types.DetectedVulnerability
+		wantErr string
+	}{
+		{
+			name:    "NIK core 23.1.0+1 on the 21 line",
+			libType: ftypes.VendorNIK,
+			src:     src,
+			pkgs:    []ftypes.Package{{Name: "core", Version: "23.1.0+1", SrcName: osvinternal.Ecosystem(osvinternal.EcosystemNIK, "23-21"), FilePath: "opt/nik"}},
+			want: []types.DetectedVulnerability{{
+				VulnerabilityID:  "CVE-2025-23165",
+				VendorIDs:        []string{"BELL-CVE-2025-23165"},
+				PkgName:          "core",
+				PkgPath:          "opt/nik",
+				InstalledVersion: "23.1.0+1",
+				FixedVersion:     "23.1.8",
+				DataSource:       nikSource,
+				SeveritySource:   vendordb.SourceNIK,
+				Vulnerability:    nikVuln(),
+			}},
+		},
+		{
+			name:    "NIK fixed version",
+			libType: ftypes.VendorNIK,
+			src:     src,
+			pkgs:    []ftypes.Package{{Name: "core", Version: "23.1.8+1", SrcName: osvinternal.Ecosystem(osvinternal.EcosystemNIK, "23-21")}},
+			want:    nil,
+		},
+		{
+			name:    "NIK without its Java line is skipped",
+			libType: ftypes.VendorNIK,
+			src:     src,
+			pkgs:    []ftypes.Package{{Name: "core", Version: "23.1.0+1"}},
+			want:    nil,
+		},
+		{
+			name: "vulnerable jdk 21",
+			src:  src,
+			pkgs: []ftypes.Package{jdk21},
+			want: []types.DetectedVulnerability{
+				{
+					VulnerabilityID:  "CVE-2025-24855",
+					VendorIDs:        []string{"BELL-CVE-2025-24855"},
+					PkgID:            "jdk@21.0.2+14",
+					PkgName:          "jdk",
+					PkgPath:          "opt/jdk-21.0.2",
+					InstalledVersion: "21.0.2+14",
+					FixedVersion:     "21.0.8+12",
+					Layer:            ftypes.Layer{DiffID: "sha256:aaaa"},
+					DataSource: &dbTypes.DataSource{
+						ID:   vendordb.SourceJDK,
+						Name: osvinternal.EcosystemJDK + " OSV database",
+						URL:  "https://github.com/bell-sw/osv-database/blob/master/BELL-CVE/BELL-CVE-2025-24855.json",
+					},
+					SeveritySource: vendordb.SourceJDK,
+					Vulnerability: dbTypes.Vulnerability{
+						Severity:         "HIGH",
+						References:       []string{"https://docs.bell-sw.com/security/cves/CVE-2025-24855"},
+						PublishedDate:    timePtr("2025-03-14T17:42:18.239166Z"),
+						LastModifiedDate: timePtr("2026-09-05T10:49:10.119410Z"),
+						CVSS: dbTypes.VendorCVSS{
+							vendordb.SourceJDK: {
+								V3Vector: "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H",
+								V3Score:  7.8,
+							},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "fixed jdk 21",
+			src:  src,
+			pkgs: []ftypes.Package{{Name: "jdk", Version: "21.0.8+12"}},
+			want: nil,
+		},
+		{
+			name: "java 8 product notation",
+			src:  src,
+			pkgs: []ftypes.Package{{Name: "jdk", Version: "8u402+7"}},
+			want: []types.DetectedVulnerability{{
+				VulnerabilityID:  "CVE-2025-24855",
+				VendorIDs:        []string{"BELL-CVE-2025-24855"},
+				PkgName:          "jdk",
+				InstalledVersion: "8u402+7",
+				FixedVersion:     "8u462+11",
+				DataSource: &dbTypes.DataSource{
+					ID:   vendordb.SourceJDK,
+					Name: osvinternal.EcosystemJDK + " OSV database",
+					URL:  "https://github.com/bell-sw/osv-database/blob/master/BELL-CVE/BELL-CVE-2025-24855.json",
+				},
+				SeveritySource: vendordb.SourceJDK,
+				Vulnerability: dbTypes.Vulnerability{
+					Severity:         "HIGH",
+					References:       []string{"https://docs.bell-sw.com/security/cves/CVE-2025-24855"},
+					PublishedDate:    timePtr("2025-03-14T17:42:18.239166Z"),
+					LastModifiedDate: timePtr("2026-09-05T10:49:10.119410Z"),
+					CVSS: dbTypes.VendorCVSS{
+						vendordb.SourceJDK: {
+							V3Vector: "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H",
+							V3Score:  7.8,
+						},
+					},
+				},
+			}},
+		},
+		{
+			name: "crac variant has its own range",
+			src:  src,
+			pkgs: []ftypes.Package{{Name: "jdk-crac", Version: "21.0.2+14"}},
+			want: nil, // crac introduced at 21.0.2+15
+		},
+		{
+			name: "unknown variant",
+			src:  src,
+			pkgs: []ftypes.Package{{Name: "jdk-unknown", Version: "21.0.2+14"}},
+			want: nil,
+		},
+		{
+			name: "no version",
+			src:  src,
+			pkgs: []ftypes.Package{{Name: "jdk"}},
+			want: nil,
+		},
+		{
+			name:    "source error",
+			src:     indexSource{err: xerrors.New("archive not cached")},
+			pkgs:    []ftypes.Package{jdk21},
+			wantErr: "failed to load the " + osvinternal.Vendor + " advisories",
+		},
+		{
+			name: "unavailable archive: a warning, the runtime stays without findings",
+			src: indexSource{err: &osvdata.UnavailableError{
+				Family: osvinternal.EcosystemJDK, Reason: "HTTP 404",
+				URL: (&osvdata.Source{}).ArchiveURL(osvinternal.EcosystemJDK),
+			}},
+			pkgs: []ftypes.Package{jdk21},
+			want: nil,
+		},
+		{
+			name: "no packages, no source access",
+			src:  indexSource{err: xerrors.New("must not be called")},
+			pkgs: nil,
+			want: nil,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			libType := tt.libType
+			if libType == "" {
+				libType = ftypes.VendorJDK
+			}
+			got, err := vendorjdk.NewScanner(vendorjdk.WithSource(tt.src)).Detect(context.Background(), libType, tt.pkgs)
+			if tt.wantErr != "" {
+				require.ErrorContains(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+// Version strings reach the matcher untouched, whatever the release type: a
+// CPU build (the previous PSU plus ".0.1", five components) counts as the PSU
+// of its cycle, and a CSPU build (fourth component) is newer than its PSU.
+func TestScanner_Detect_ReleaseTypes(t *testing.T) {
+	src := indexSource{idx: map[string]*osvdata.Index{
+		osvinternal.EcosystemJDK: loadIndexFrom(t, "testdata/release-types/*.json", osvinternal.EcosystemJDK),
+	}}
+	tests := []struct {
+		name    string
+		version string
+		want    map[string]string // CVE -> fixed version
+	}{
+		{
+			name:    "CPU 21.0.9.0.1+1 is the 21.0.10 cycle: fixed 21.0.10+10 does not match, fixed 21.0.11+11 does",
+			version: "21.0.9.0.1+1",
+			want:    map[string]string{"CVE-2099-00011": "21.0.11+11"},
+		},
+		{
+			name:    "PSU 21.0.9+11 precedes both fixes",
+			version: "21.0.9+11",
+			want:    map[string]string{"CVE-2099-00010": "21.0.10+10", "CVE-2099-00011": "21.0.11+11"},
+		},
+		{
+			name:    "CSPU 21.0.10.1+1 follows its PSU",
+			version: "21.0.10.1+1",
+			want:    map[string]string{"CVE-2099-00011": "21.0.11+11"},
+		},
+		{
+			name:    "CSPU 21.0.12.1+1 is past both fixes",
+			version: "21.0.12.1+1",
+			want:    map[string]string{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			pkgs := []ftypes.Package{{Name: "jdk", Version: tt.version, SrcName: osvinternal.Ecosystem(osvinternal.EcosystemJDK, "21")}}
+			vulns, err := vendorjdk.NewScanner(vendorjdk.WithSource(src)).Detect(context.Background(), ftypes.VendorJDK, pkgs)
+			require.NoError(t, err)
+			got := make(map[string]string)
+			for _, v := range vulns {
+				assert.Equal(t, tt.version, v.InstalledVersion)
+				got[v.VulnerabilityID] = v.FixedVersion
+			}
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+// nikVuln is the detail of BELL-CVE-2025-23165 as the prototype record carries it.
+func nikVuln() dbTypes.Vulnerability {
+	rec, err := os.ReadFile("testdata/BELL-CVE-2025-23165.json")
+	if err != nil {
+		panic(err)
+	}
+	var r struct {
+		Published  time.Time `json:"published"`
+		Modified   time.Time `json:"modified"`
+		Severity   []struct{ Score string }
+		References []struct{ URL string }
+	}
+	if err := json.Unmarshal(rec, &r); err != nil {
+		panic(err)
+	}
+	var refs []string
+	for _, ref := range r.References {
+		refs = append(refs, ref.URL)
+	}
+	return dbTypes.Vulnerability{
+		Severity:         "LOW", // CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L = 3.7
+		References:       refs,
+		PublishedDate:    &r.Published,
+		LastModifiedDate: &r.Modified,
+		CVSS: dbTypes.VendorCVSS{
+			vendordb.SourceNIK: {V3Vector: r.Severity[0].Score, V3Score: 3.7},
+		},
+	}
+}
+
+func timePtr(s string) *time.Time {
+	t, err := time.Parse(time.RFC3339Nano, s)
+	if err != nil {
+		panic(err)
+	}
+	return &t
+}
