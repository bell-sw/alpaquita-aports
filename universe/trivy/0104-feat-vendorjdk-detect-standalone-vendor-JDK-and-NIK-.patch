+
+// LangTypeForFamily maps the ecosystem family of a detected runtime to the
+// Trivy package type; ok is false for a family Trivy does not scan.
+func LangTypeForFamily(family string) (ftypes.LangType, bool) {
+	switch family {
+	case osvinternal.EcosystemJDK:
+		return ftypes.VendorJDK, true
+	case EcosystemNIK:
+		return ftypes.VendorNIK, true
+	}
+	return "", false
+}
+
+// FamilyForLangType is the inverse of LangTypeForFamily.
+func FamilyForLangType(t ftypes.LangType) (string, bool) {
+	switch t {
+	case ftypes.VendorJDK:
+		return osvinternal.EcosystemJDK, true
+	case ftypes.VendorNIK:
+		return EcosystemNIK, true
+	}
+	return "", false
+}
+
+// PURLName returns the purl name of a standalone runtime type ("" for others).
+func PURLName(t ftypes.LangType) string {
+	switch t {
+	case ftypes.VendorJDK:
+		return PURLNameJDK
+	case ftypes.VendorNIK:
+		return PURLNameNIK
+	}
+	return ""
+}
+
+// LangTypeForPURLName is the inverse of PURLName.
+func LangTypeForPURLName(name string) (ftypes.LangType, bool) {
+	switch name {
+	case PURLNameJDK:
+		return ftypes.VendorJDK, true
+	case PURLNameNIK:
+		return ftypes.VendorNIK, true
+	}
+	return "", false
+}
+
+// IsVendorRuntimePURL reports whether the purl namespace and name are those of
+// a standalone vendor runtime (pkg:generic/<namespace>/<jdk or nik name>).
+func IsVendorRuntimePURL(namespace, name string) bool {
+	_, ok := LangTypeForPURLName(name)
+	return ok && namespace == osvjdk.PURLNamespace
+}
+
+// IsVendorRuntime reports whether t is one of the standalone vendor runtimes.
+func IsVendorRuntime(t ftypes.LangType) bool {
+	_, ok := FamilyForLangType(t)
+	return ok
+}
