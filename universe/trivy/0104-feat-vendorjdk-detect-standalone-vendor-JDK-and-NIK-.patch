--- /dev/null
+++ b/pkg/scan/langpkg/scan_test.go
@@ -0,0 +1,62 @@
+package langpkg
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+)
+
+func TestDropOSManagedRuntimes(t *testing.T) {
+	apkRuntime := ftypes.Application{
+		Type:     ftypes.VendorJDK,
+		FilePath: "usr/lib/jvm/jdk21-lite/release",
+		Packages: []ftypes.Package{{Name: "jdk-lite", Version: "21.0.2+14", FilePath: "usr/lib/jvm/jdk21-lite"}},
+	}
+	optRuntime := ftypes.Application{
+		Type:     ftypes.VendorJDK,
+		FilePath: "opt/jdk-21.0.2/release",
+		Packages: []ftypes.Package{{Name: "jdk", Version: "21.0.2+14", FilePath: "opt/jdk-21.0.2"}},
+	}
+	jar := ftypes.Application{Type: ftypes.Jar, FilePath: "usr/lib/jvm/jdk21-lite/lib/foo.jar"}
+
+	tests := []struct {
+		name string
+		os   ftypes.OS
+		apps []ftypes.Application
+		want []ftypes.Application
+	}{
+		{
+			name: "vendor Linux: the apk-installed runtime is dropped, others stay",
+			os:   ftypes.OS{Family: ftypes.VendorLinux, Name: "23"},
+			apps: []ftypes.Application{apkRuntime, optRuntime, jar},
+			want: []ftypes.Application{optRuntime, jar},
+		},
+		{
+			name: "hardened containers: same rule",
+			os:   ftypes.OS{Family: ftypes.VendorHardened, Name: "stream"},
+			apps: []ftypes.Application{apkRuntime},
+			want: []ftypes.Application{},
+		},
+		{
+			name: "debian: a runtime under /usr/lib/jvm is standalone",
+			os:   ftypes.OS{Family: ftypes.Debian, Name: "11"},
+			apps: []ftypes.Application{apkRuntime, optRuntime},
+			want: []ftypes.Application{apkRuntime, optRuntime},
+		},
+		{
+			name: "no OS: nothing dropped",
+			apps: []ftypes.Application{apkRuntime},
+			want: []ftypes.Application{apkRuntime},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := dropOSManagedRuntimes(context.Background(), types.ScanTarget{OS: tt.os, Applications: tt.apps})
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
