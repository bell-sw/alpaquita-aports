+package vendorjdk
+
+import (
+	"context"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"testing"
+
+	"github.com/package-url/packageurl-go"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/testfix"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+
+	"github.com/aquasecurity/trivy/pkg/fanal/analyzer"
+	"github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/mapfs"
+)
+
+// testFS assembles the named runtimes under the given virtual roots, the
+// way the analyzer group hands a layer to a post-analyzer.
+func testFS(t *testing.T, dirs map[string]string) *mapfs.FS {
+	t.Helper()
+	mfs := mapfs.New()
+	for virtual, name := range dirs {
+		spec, ok := runtimes[name]
+		require.True(t, ok, name)
+		real := filepath.Join(t.TempDir(), name)
+		testfix.Write(t, real, spec)
+		err := filepath.WalkDir(real, func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			rel, err := filepath.Rel(real, p)
+			if err != nil {
+				return err
+			}
+			dst := path.Join(virtual, filepath.ToSlash(rel))
+			if d.IsDir() {
+				return mfs.MkdirAll(dst, 0o755)
+			}
+			return mfs.WriteFile(dst, p)
+		})
+		require.NoError(t, err)
+	}
+	return mfs
+}
+
+func TestVendorJDKAnalyzer_PostAnalyze(t *testing.T) {
+	tests := []struct {
+		name string
+		dirs map[string]string // virtual dir -> runtime spec
+		want []types.Application
+	}{
+		{
+			name: "JDK 21 standard",
+			dirs: map[string]string{"opt/jdk-21.0.2": "jdk-21.0.2"},
+			want: []types.Application{
+				{
+					Type:     types.VendorJDK,
+					FilePath: "opt/jdk-21.0.2/release",
+					Packages: []types.Package{
+						{
+							ID:         "jdk@21.0.2+14",
+							Name:       "jdk",
+							Version:    "21.0.2+14",
+							SrcName:    osvinternal.Ecosystem(osvinternal.EcosystemJDK, "21"),
+							FilePath:   "opt/jdk-21.0.2",
+							Identifier: types.PkgIdentifier{PURL: purlOf("jdk", "21.0.2+14")},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "JDK 8: no IMPLEMENTOR in release, vendor from libjvm.so and rt.jar",
+			dirs: map[string]string{"opt/jdk8u402": "jdk8u402"},
+			want: []types.Application{
+				{
+					Type:     types.VendorJDK,
+					FilePath: "opt/jdk8u402/release",
+					Packages: []types.Package{
+						{
+							ID:         "jdk@8u402+7",
+							Name:       "jdk",
+							Version:    "8u402+7",
+							SrcName:    osvinternal.Ecosystem(osvinternal.EcosystemJDK, "8"),
+							FilePath:   "opt/jdk8u402",
+							Identifier: types.PkgIdentifier{PURL: purlOf("jdk", "8u402+7")},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "JRE 21 lite: no javac, lite from the home name",
+			dirs: map[string]string{"usr/lib/jvm/jre-21.0.2-lite": "jre-21.0.2-lite"},
+			want: []types.Application{
+				{
+					Type:     types.VendorJDK,
+					FilePath: "usr/lib/jvm/jre-21.0.2-lite/release",
+					Packages: []types.Package{
+						{
+							ID:         "jre-lite@21.0.2+14",
+							Name:       "jre-lite",
+							Version:    "21.0.2+14",
+							SrcName:    osvinternal.Ecosystem(osvinternal.EcosystemJDK, "21"),
+							FilePath:   "usr/lib/jvm/jre-21.0.2-lite",
+							Identifier: types.PkgIdentifier{PURL: purlOf("jre-lite", "21.0.2+14")},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "another vendor is ignored",
+			dirs: map[string]string{"usr/lib/jvm/zulu21-ca-amd64": "zulu21"},
+			want: nil,
+		},
+		{
+			// GraalVM markers make it NIK: reported once, as NIK (core bundle, version
+			// from GRAALVM_VERSION), never as a JDK
+			name: "NIK (GraalVM) is reported as NIK, not as a JDK",
+			dirs: map[string]string{"opt/nik-23": "nik-23"},
+			want: []types.Application{
+				{
+					Type:     types.VendorNIK,
+					FilePath: "opt/nik-23/release",
+					Packages: []types.Package{
+						{
+							ID:         "core@23.1.2",
+							Name:       "core",
+							Version:    "23.1.2",
+							SrcName:    osvinternal.Ecosystem(osvinternal.EcosystemNIK, "23-21"),
+							FilePath:   "opt/nik-23",
+							Identifier: types.PkgIdentifier{PURL: purlFrom(osvjdk.PURLNIK("core", "23.1.2"))},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "apk-installed runtime with a stripped release file is still a vendor runtime at this stage",
+			dirs: map[string]string{"usr/lib/jvm/jdk21-lite": "apk-jdk21-lite"},
+			want: []types.Application{
+				{
+					Type:     types.VendorJDK,
+					FilePath: "usr/lib/jvm/jdk21-lite/release",
+					Packages: []types.Package{
+						{
+							ID:         "jre-lite@21.0.2+14",
+							Name:       "jre-lite",
+							Version:    "21.0.2+14",
+							SrcName:    osvinternal.Ecosystem(osvinternal.EcosystemJDK, "21"),
+							FilePath:   "usr/lib/jvm/jdk21-lite",
+							Identifier: types.PkgIdentifier{PURL: purlOf("jre-lite", "21.0.2+14")},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "two runtimes in one layer",
+			dirs: map[string]string{
+				"opt/jdk-21.0.2": "jdk-21.0.2",
+				"opt/jdk8u402":   "jdk8u402",
+			},
+			want: []types.Application{
+				{
+					Type:     types.VendorJDK,
+					FilePath: "opt/jdk-21.0.2/release",
+					Packages: []types.Package{{ID: "jdk@21.0.2+14", Name: "jdk", Version: "21.0.2+14", SrcName: osvinternal.Ecosystem(osvinternal.EcosystemJDK, "21"), FilePath: "opt/jdk-21.0.2", Identifier: types.PkgIdentifier{PURL: purlOf("jdk", "21.0.2+14")}}},
+				},
+				{
+					Type:     types.VendorJDK,
+					FilePath: "opt/jdk8u402/release",
+					Packages: []types.Package{{ID: "jdk@8u402+7", Name: "jdk", Version: "8u402+7", SrcName: osvinternal.Ecosystem(osvinternal.EcosystemJDK, "8"), FilePath: "opt/jdk8u402", Identifier: types.PkgIdentifier{PURL: purlOf("jdk", "8u402+7")}}},
+				},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			a, err := newVendorJDKAnalyzer(analyzer.AnalyzerOptions{})
+			require.NoError(t, err)
+			got, err := a.PostAnalyze(context.Background(), analyzer.PostAnalysisInput{FS: testFS(t, tt.dirs)})
+			require.NoError(t, err)
+			sort.Slice(got.Applications, func(i, j int) bool {
+				return got.Applications[i].FilePath < got.Applications[j].FilePath
+			})
+			assert.Equal(t, tt.want, got.Applications)
+		})
+	}
+}
+
+func TestVendorJDKAnalyzer_Required(t *testing.T) {
+	a := &vendorJDKAnalyzer{}
+	tests := []struct {
+		path string
+		size int64
+		want bool
+	}{
+		{"opt/jdk-21.0.2/lib/server/libjvm.so", 27_000_000, true},
+		{"opt/jdk8u402/jre/lib/amd64/server/libjvm.so", 17_000_000, true},
+		{"opt/jdk-21.0.2/release", 2_000, true},
+		{"opt/jdk8u402/jre/lib/rt.jar", 65_000_000, true},
+		{"opt/jdk-21.0.2/bin/javac", 13_000, true},
+		{"opt/jdk-21.0.2/bin/java", 13_000, true},
+		{"opt/jdk8u402/jre/bin/java", 9_000, true},
+		{"opt/nik/bin/native-image", 9_000, true},
+		{"opt/nik/lib/svm/bin/native-image", 25_403_584, true}, // the real launcher, a native image itself
+		{"opt/nik/lib/svm/bin/native-image-configure", 10_240, true},
+		{"opt/nik/lib/svm/builder/svm.jar", 30_000_000, false},
+		{"opt/jdk8u402/jre/lib/ext/jfxrt.jar", 18_000_000, true},
+		{"opt/jdk-21.0.2/lib/modules", 140_000_000, false},
+		{"opt/jdk-21.0.2/bin/jar", 13_000, false},
+		{"usr/bin/java", 900_000_000, false}, // a 900 MB "java" is not a launcher
+		{"app/release", 100, true},           // a release file anywhere is cheap to look at
+		{"usr/lib/libjvm.so.1", 100, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.path, func(t *testing.T) {
+			assert.Equal(t, tt.want, a.Required(tt.path, fakeInfo{size: tt.size}))
+		})
+	}
+}
+
+// purlOf is the purl the shared module assigns to a vendor JDK runtime.
+func purlOf(variant, version string) *packageurl.PackageURL {
+	return purlFrom(osvjdk.PURL(variant, version))
+}
+
+func purlFrom(s string) *packageurl.PackageURL {
+	p, err := packageurl.FromString(s)
+	if err != nil {
+		panic(err)
+	}
+	return &p
+}
+
+type fakeInfo struct {
+	os.FileInfo
+	size int64
+}
+
+func (f fakeInfo) Size() int64 { return f.size }
