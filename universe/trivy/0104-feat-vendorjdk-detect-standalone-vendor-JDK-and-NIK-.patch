+// dropOSManagedRuntimes removes the vendor runtime applications under
+// /usr/lib/jvm on the vendor distributions: they are apk packages already
+// covered by the OS scan.
+func dropOSManagedRuntimes(ctx context.Context, target types.ScanTarget) []ftypes.Application {
+	apps := make([]ftypes.Application, 0, len(target.Applications))
+	for _, app := range target.Applications {
+		if vendordb.IsVendorRuntime(app.Type) && isVendorOS(target.OS.Family) && osvjdk.ManagedByAPK(app.FilePath) {
+			log.DebugContext(ctx, "Skipping a runtime installed by the OS package manager",
+				log.FilePath(app.FilePath), log.String("os", string(target.OS.Family)))
+			continue
+		}
+		apps = append(apps, app)
+	}
+	return apps
+}
+
+func isVendorOS(family ftypes.OSType) bool {
+	return family == ftypes.VendorLinux || family == ftypes.VendorHardened
+}
