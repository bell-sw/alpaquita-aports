new file mode 100644
index 0000000..15dbc63
--- /dev/null
+++ b/pkg/fanal/analyzer/language/java/vendorjdk/fs.go
@@ -0,0 +1,13 @@
+package vendorjdk
+
+import (
+	"io/fs"
+)
+
+// fsStat is fs.Stat with the leading slash the walker may leave stripped.
+func fsStat(fsys fs.FS, name string) (fs.FileInfo, error) {
+	for len(name) > 0 && name[0] == '/' {
+		name = name[1:]
+	}
+	return fs.Stat(fsys, name)
+}
diff --git a/pkg/fanal/analyzer/language/java/vendorjdk/vendorjdk.go b/pkg/fanal/analyzer/language/java/vendorjdk/vendorjdk.go
new file mode 100644
index 0000000..c1a2858
--- /dev/null
+++ b/pkg/fanal/analyzer/language/java/vendorjdk/vendorjdk.go
@@ -0,0 +1,140 @@
+// Package vendorjdk detects standalone vendor JDK/JRE and NIK
+// runtimes (tarball or package installations not managed by apk). The
+// detection is the shared github.com/bell-sw/osv-internal module's; this
+// analyzer collects the files the detector reads and turns a runtime into a
+// Trivy package.
+package vendorjdk
+
+import (
+	"context"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/xerrors"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+	"github.com/package-url/packageurl-go"
+
+	"github.com/aquasecurity/trivy/pkg/dependency"
+	"github.com/aquasecurity/trivy/pkg/fanal/analyzer"
+	"github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/log"
+	"github.com/aquasecurity/trivy/pkg/vendordb"
+)
+
+func init() {
+	analyzer.RegisterPostAnalyzer(analyzer.TypeVendorJDK, newVendorJDKAnalyzer)
+}
+
+const version = 1
+
+// maxLauncherSize bounds the bin/java and bin/javac launchers copied for the
+// detector; the real ones are a few tens of kilobytes.
+const maxLauncherSize = 4 << 20
+
+// maxNativeImageSize bounds the native-image launcher of the vendor NIK.
+const maxNativeImageSize = 256 << 20
+
+type vendorJDKAnalyzer struct {
+	logger *log.Logger
+}
+
+func newVendorJDKAnalyzer(analyzer.AnalyzerOptions) (analyzer.PostAnalyzer, error) {
+	return &vendorJDKAnalyzer{logger: log.WithPrefix("vendor-jdk")}, nil
+}
+
+// PostAnalyze runs the shared detector over the collected files and emits one
+// application per runtime, with a single package named after the
+// distribution variant.
+func (a *vendorJDKAnalyzer) PostAnalyze(_ context.Context, input analyzer.PostAnalysisInput) (*analyzer.AnalysisResult, error) {
+	runtimes, err := osvjdk.Scan(input.FS)
+	if err != nil {
+		return nil, xerrors.Errorf("vendor-jdk scan error: %w", err)
+	}
+
+	var apps []types.Application
+	for _, rt := range runtimes {
+		// The module names the product (the JDK or NIK family) through the
+		// ecosystem of the runtime; Trivy keeps one package type per product.
+		langType, ok := vendordb.LangTypeForFamily(osvinternal.Family(rt.Ecosystem()))
+		if !ok {
+			a.logger.Debug("Skipping a runtime of an unsupported product", log.String("home", rt.Home),
+				log.String("ecosystem", rt.Ecosystem()))
+			continue
+		}
+		home := filepath.ToSlash(rt.Home)
+		// the release file is the location the apk database lists, so the
+		// system file filter drops package-manager installs
+		location := path.Join(home, "release")
+		if _, err := fsStat(input.FS, location); err != nil {
+			location = filepath.ToSlash(rt.LibJVM)
+		}
+		pkg := types.Package{
+			ID:       dependency.ID(langType, rt.Variant, rt.Version),
+			Name:     rt.Variant,
+			Version:  rt.Version,
+			FilePath: home,
+			// the ecosystem; a NIK version alone does not name the Java line
+			SrcName: rt.Ecosystem(),
+		}
+		// The purl is the module's; the applier only computes one when it is missing.
+		if p, err := packageurl.FromString(rt.PURL()); err == nil {
+			pkg.Identifier.PURL = &p
+		}
+		// The package model has no free-form property, so the release type the
+		// module derives (psu, cpu, cspu) is shown in the log only.
+		a.logger.Debug("Detected a vendor runtime", log.String("home", home), log.String("ecosystem", rt.Ecosystem()),
+			log.String("variant", rt.Variant), log.String("version", rt.Version),
+			log.String("release_type", rt.ReleaseType.String()))
+		apps = append(apps, types.Application{
+			FilePath: location,
+			Type:     langType,
+			Packages: []types.Package{pkg},
+		})
+	}
+	return &analyzer.AnalysisResult{Applications: apps}, nil
+}
+
+// Required collects the files the detector reads: the HotSpot library
+// (libjvm.so, libjvm.dylib on macOS, jvm.dll on Windows), the release file,
+// rt.jar (Java 8), the launchers that decide the variant and the markers of a
+// GraalVM-based runtime (NIK). Windows names are case-insensitive.
+func (a *vendorJDKAnalyzer) Required(filePath string, info os.FileInfo) bool {
+	p := filepath.ToSlash(filePath)
+	if osvjdk.IsCandidate(p) {
+		return true
+	}
+	base := strings.ToLower(path.Base(p))
+	dir := strings.ToLower(path.Base(path.Dir(p)))
+	switch {
+	case base == "libjvm.so" || base == "libjvm.dylib" || base == "jvm.dll":
+		return true
+	case base == "release" || base == "rt.jar":
+		return true
+	case dir == "bin" && (base == "native-image" || base == "native-image.exe" || base == "native-image.cmd"):
+		// The NIK launcher is itself a native image (about 25 MB) and holds the
+		// product version with its build number (NIKVendorVersionPrefix + "23.1.0-1").
+		return info == nil || info.Size() <= maxNativeImageSize
+	case dir == "bin" && (base == "java" || base == "javac" || base == "java.exe" || base == "javac.exe"):
+		return info == nil || info.Size() <= maxLauncherSize
+	case base == "jfxrt.jar" && dir == "ext":
+		return true
+	case strings.Contains(strings.ToLower(p), "/lib/svm/") || strings.HasPrefix(strings.ToLower(p), "lib/svm/"):
+		return info == nil || info.Size() <= maxLauncherSize
+	case strings.Contains(strings.ToLower(p), "/languages/") || strings.HasPrefix(strings.ToLower(p), "languages/"):
+		// NIK bundle markers (languages/js, python, ruby, llvm)
+		return info == nil || info.Size() <= maxLauncherSize
+	}
+	return false
+}
+
+func (a *vendorJDKAnalyzer) Type() analyzer.Type {
+	return analyzer.TypeVendorJDK
+}
+
+func (a *vendorJDKAnalyzer) Version() int {
+	return version
+}
