diff --git a/pkg/detector/ospkg/vendorapk/vendorapk.go b/pkg/detector/ospkg/vendorapk/vendorapk.go
new file mode 100644
index 0000000..dadb947
--- /dev/null
+++ b/pkg/detector/ospkg/vendorapk/vendorapk.go
@@ -0,0 +1,188 @@
+// Package vendorapk is the vulnerability scanner of the vendor's apk-based
+// distributions (the Linux distribution and the hardened containers): a rolling
+// "stream" plus numbered LTS branches, one OSV advisory feed.
+package vendorapk
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"golang.org/x/xerrors"
+
+	"github.com/aquasecurity/trivy-db/pkg/db"
+	dbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy-db/pkg/vulnsrc/bellsoft"
+	"github.com/aquasecurity/trivy/pkg/detector/ospkg/version"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/log"
+	"github.com/aquasecurity/trivy/pkg/scan/utils"
+	"github.com/aquasecurity/trivy/pkg/types"
+)
+
+// streamRelease is the rolling release of both distributions. It never reaches
+// end of life.
+const streamRelease = "stream"
+
+// eolDates holds the end of commercial support for the LTS releases.
+// Only the year is published, so the last day of that year is used.
+// cf. https://bell-sw.com/alpaquita-support/
+var eolDates = map[string]time.Time{
+	"23": time.Date(2026, 12, 31, 23, 59, 59, 0, time.UTC),
+	"25": time.Date(2031, 12, 31, 23, 59, 59, 0, time.UTC),
+}
+
+// Scanner implements the vendor apk scanner
+type Scanner struct {
+	vs       bellsoft.VulnSrc
+	comparer version.Comparer
+	logger   *log.Logger
+}
+
+// NewScanner is the factory method for Scanner.
+// osFamily selects which of the two vendor distributions to scan.
+func NewScanner(osFamily ftypes.OSType) *Scanner {
+	variant := bellsoft.Alpaquita
+	if osFamily == ftypes.VendorHardened {
+		variant = bellsoft.HardenedContainers
+	}
+	return &Scanner{
+		vs:       bellsoft.NewVulnSrc(variant),
+		comparer: version.NewAPKComparer(),
+		logger:   log.WithPrefix(string(osFamily)),
+	}
+}
+
+// Detect vulnerabilities in packages using the vendor advisory database
+func (s *Scanner) Detect(ctx context.Context, osVer string, _ *ftypes.Repository, pkgs []ftypes.Package) ([]types.DetectedVulnerability, error) {
+	log.InfoContext(ctx, "Detecting vulnerabilities...", log.String("os_version", osVer),
+		log.Int("pkg_num", len(pkgs)))
+
+	var vulns []types.DetectedVulnerability
+	for _, pkg := range pkgs {
+		installed := utils.FormatSrcVersion(pkg)
+
+		for _, name := range sourceNames(pkg) {
+			advisories, err := s.vs.Get(db.GetParams{
+				Release: osVer,
+				PkgName: name,
+			})
+			if err != nil {
+				return nil, xerrors.Errorf("failed to get vendor advisories: %w", err)
+			}
+			if len(advisories) == 0 {
+				continue
+			}
+
+			for _, adv := range advisories {
+				if !s.isVulnerable(ctx, installed, adv) {
+					continue
+				}
+				vulns = append(vulns, types.DetectedVulnerability{
+					VulnerabilityID:  adv.VulnerabilityID,
+					PkgID:            pkg.ID,
+					PkgName:          pkg.Name,
+					InstalledVersion: utils.FormatVersion(pkg),
+					FixedVersion:     strings.Join(adv.PatchedVersions, ", "),
+					Layer:            pkg.Layer,
+					PkgIdentifier:    pkg.Identifier,
+					Custom:           adv.Custom,
+					DataSource:       adv.DataSource,
+				})
+			}
+
+			// the first name the feed knows wins: a package is not reported
+			// twice through two aliases
+			break
+		}
+	}
+	return vulns, nil
+}
+
+// sourceNames returns the candidate source package names of pkg in the order
+// to try them: the apk origin, then every provided name with the subpackage
+// suffix stripped. Advisories are keyed on the source package, and a package
+// published under another name (the vendor's JDK: origin "liberica21-lite",
+// feed "openjdk21-lite") carries the alias only in its provides field:
+//
+//	package name  liberica21-lite-jdk-no-deps
+//	origin        liberica21-lite
+//	suffix        -jdk-no-deps
+//	provides      openjdk21-lite-jdk-no-deps -> openjdk21-lite
+func sourceNames(pkg ftypes.Package) []string {
+	srcName := pkg.SrcName
+	if srcName == "" {
+		srcName = pkg.Name
+	}
+
+	names := []string{srcName}
+	seen := map[string]struct{}{srcName: {}}
+
+	// the subpackage suffix ("-jdk-no-deps" above)
+	suffix := strings.TrimPrefix(pkg.Name, srcName)
+
+	add := func(name string) {
+		if name == "" {
+			return
+		}
+		// "so:", "cmd:", ... are capabilities, not package names
+		if strings.Contains(name, ":") {
+			return
+		}
+		if _, ok := seen[name]; ok {
+			return
+		}
+		seen[name] = struct{}{}
+		names = append(names, name)
+	}
+
+	for _, provide := range pkg.Provides {
+		if suffix != "" && suffix != pkg.Name {
+			add(strings.TrimSuffix(provide, suffix))
+		}
+		add(provide)
+	}
+
+	return names
+}
+
+func (s *Scanner) isVulnerable(ctx context.Context, installedVersion string, adv dbTypes.Advisory) bool {
+	// no vulnerable range: not fixed yet, every version is vulnerable
+	if len(adv.VulnerableVersions) == 0 {
+		return true
+	}
+	if installedVersion == "" {
+		return false
+	}
+
+	for _, constraintStr := range adv.VulnerableVersions {
+		constraints, err := version.NewConstraints(constraintStr, s.comparer)
+		if err != nil {
+			s.logger.DebugContext(ctx, "Failed to parse the vulnerable version range",
+				log.String("range", constraintStr), log.Err(err))
+			continue
+		}
+
+		satisfied, err := constraints.Check(installedVersion)
+		if err != nil {
+			s.logger.DebugContext(ctx, "Failed to check the version constraints",
+				log.String("version", installedVersion),
+				log.String("range", constraintStr), log.Err(err))
+			continue
+		}
+		if satisfied {
+			return true
+		}
+	}
+	return false
+}
+
+// IsSupportedVersion checks if the version is supported.
+// The rolling "stream" release is always supported; LTS releases are checked
+// against their end of support date.
+func (s *Scanner) IsSupportedVersion(ctx context.Context, osFamily ftypes.OSType, osVer string) bool {
+	if osVer == streamRelease {
+		return true
+	}
+	return version.Supported(ctx, eolDates, osFamily, osVer)
+}
