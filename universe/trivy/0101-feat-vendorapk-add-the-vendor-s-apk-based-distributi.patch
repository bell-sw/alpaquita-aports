+			osFamily: ftypes.VendorLinux,
+			osVer:    "25",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "openssl",
+					Version:    "3.1.1-r1",
+					SrcName:    "openssl",
+					SrcVersion: "3.1.1-r1",
+				},
+			},
+			want: nil,
+		},
+		{
+			name:     "broken bucket",
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/invalid.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "openssl",
+					Version:    "3.1.1-r1",
+					SrcName:    "openssl",
+					SrcVersion: "3.1.1-r1",
+				},
+			},
+			wantErr: "failed to get vendor advisories",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_ = dbtest.InitDB(t, tt.fixtures)
+			defer dbtest.Close()
+
+			s := vendorapk.NewScanner(tt.osFamily)
+			got, err := s.Detect(t.Context(), tt.osVer, nil, tt.pkgs)
+			if tt.wantErr != "" {
+				require.ErrorContains(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+
+			sort.Slice(got, func(i, j int) bool {
+				return got[i].VulnerabilityID < got[j].VulnerabilityID
+			})
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestScanner_IsSupportedVersion(t *testing.T) {
+	tests := []struct {
+		name     string
+		now      time.Time
+		osFamily ftypes.OSType
+		osVer    string
+		want     bool
+	}{
+		{
+			name:     "stream is always supported",
+			now:      time.Date(2040, 1, 1, 0, 0, 0, 0, time.UTC),
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			want:     true,
+		},
+		{
+			name:     "25 LTS is supported",
+			now:      time.Date(2026, 8, 24, 0, 0, 0, 0, time.UTC),
+			osFamily: ftypes.VendorLinux,
+			osVer:    "25",
+			want:     true,
+		},
+		{
+			name:     "23 LTS is supported before end of support",
+			now:      time.Date(2026, 8, 24, 0, 0, 0, 0, time.UTC),
+			osFamily: ftypes.VendorLinux,
+			osVer:    "23",
+			want:     true,
+		},
+		{
+			name:     "23 LTS is out of support",
+			now:      time.Date(2027, 1, 1, 0, 0, 0, 0, time.UTC),
+			osFamily: ftypes.VendorLinux,
+			osVer:    "23",
+			want:     false,
+		},
+		{
+			name:     "unknown release is assumed supported",
+			now:      time.Date(2026, 8, 24, 0, 0, 0, 0, time.UTC),
+			osFamily: ftypes.VendorHardened,
+			osVer:    "27",
+			want:     true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := clock.With(t.Context(), tt.now)
+			s := vendorapk.NewScanner(tt.osFamily)
+			assert.Equal(t, tt.want, s.IsSupportedVersion(ctx, tt.osFamily, tt.osVer))
+		})
+	}
+}
