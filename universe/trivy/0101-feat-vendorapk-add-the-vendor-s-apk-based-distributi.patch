+// vendorOSRelease writes an os-release with the given ID (the OS type's value) and VERSION_ID, ID_LIKE=alpine, to a
+// temporary file and returns its path.
+func vendorOSRelease(t *testing.T, family types.OSType, versionID string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "os-release")
+	content := "NAME=\"" + string(family) + "\"\nID=" + string(family) + "\nID_LIKE=alpine\nVERSION_ID=" + versionID +
+		"\nPRETTY_NAME=\"" + string(family) + " " + versionID + "\"\n"
+	require.NoError(t, os.WriteFile(p, []byte(content), 0o644))
+	return p
+}
