+					VulnerabilityID:  "CVE-2026-99999",
+					PkgName:          "zlib",
+					InstalledVersion: "1.3.1-r0",
+					FixedVersion:     "1.3.1-r9",
+					DataSource:       hardenedSource,
+				},
+			},
+		},
+		{
+			// Linux advisories must not be reported for the hardened containers.
+			name:     "no cross-family detection",
