+			},
+			pkgs: []ftypes.Package{
+				{
+					ID:         "openssl@3.1.1-r1",
+					Name:       "openssl",
+					Version:    "3.1.1-r1",
+					SrcName:    "openssl",
+					SrcVersion: "3.1.1-r1",
+					Layer: ftypes.Layer{
+						DiffID: "sha256:932da51564135c98a49a34a193d6cd363d8fa4184d957fde16c9d8527b3f3b02",
+					},
+				},
+			},
+			want: []types.DetectedVulnerability{
+				{
+					VulnerabilityID:  "CVE-2024-41996",
+					PkgID:            "openssl@3.1.1-r1",
+					PkgName:          "openssl",
+					InstalledVersion: "3.1.1-r1",
+					FixedVersion:     "3.5.0-r0",
+					Layer: ftypes.Layer{
+						DiffID: "sha256:932da51564135c98a49a34a193d6cd363d8fa4184d957fde16c9d8527b3f3b02",
+					},
+					DataSource: linuxSource,
+				},
+			},
+		},
+		{
+			name:     "already fixed",
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "openssl",
+					Version:    "3.5.0-r0",
+					SrcName:    "openssl",
+					SrcVersion: "3.5.0-r0",
+				},
+			},
+			want: nil,
+		},
+		{
+			name:     "not yet introduced",
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "openssl",
+					Version:    "3.0.8-r4",
+					SrcName:    "openssl",
+					SrcVersion: "3.0.8-r4",
+				},
+			},
+			want: nil,
+		},
+		{
+			name:     "unfixed vulnerability",
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "linux-lts",
+					Version:    "6.18.35-r1",
+					SrcName:    "linux-lts",
+					SrcVersion: "6.18.35-r1",
+				},
+			},
+			want: []types.DetectedVulnerability{
+				{
+					VulnerabilityID:  "CVE-2026-53237",
+					PkgName:          "linux-lts",
+					InstalledVersion: "6.18.35-r1",
+					DataSource:       linuxSource,
+				},
+			},
+		},
+		{
+			// origin "jdk21-lite", feed "openjdk21-lite": resolved through
+			// the provided name
+			name:     "source name resolved through apk provides",
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					ID:         "jdk21-lite-jdk-no-deps@21.0.10.1_p1-r0",
+					Name:       "jdk21-lite-jdk-no-deps",
+					Version:    "21.0.10.1_p1-r0",
+					SrcName:    "jdk21-lite",
+					SrcVersion: "21.0.10.1_p1-r0",
+					Provides: []string{
+						"java-jdk-no-deps",
+						"java21-jdk-no-deps",
+						"openjdk21-lite-jdk-no-deps",
+					},
+				},
+			},
+			want: []types.DetectedVulnerability{
+				{
+					VulnerabilityID:  "CVE-2026-60589",
+					PkgID:            "jdk21-lite-jdk-no-deps@21.0.10.1_p1-r0",
+					PkgName:          "jdk21-lite-jdk-no-deps",
+					InstalledVersion: "21.0.10.1_p1-r0",
+					FixedVersion:     "21.0.12.1_p1-r0",
+					DataSource:       linuxSource,
+				},
+			},
+		},
+		{
+			name:     "no advisories without provides",
+			osFamily: ftypes.VendorLinux,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "jdk21-lite-jdk-no-deps",
+					Version:    "21.0.10.1_p1-r0",
+					SrcName:    "jdk21-lite",
+					SrcVersion: "21.0.10.1_p1-r0",
+				},
+			},
+			want: nil,
+		},
+		{
+			name:     "hardened containers use their own advisories",
+			osFamily: ftypes.VendorHardened,
+			osVer:    "stream",
+			fixtures: []string{
+				"testdata/fixtures/vendorapk.yaml",
+				"testdata/fixtures/data-source.yaml",
+			},
+			pkgs: []ftypes.Package{
+				{
+					Name:       "zlib",
