pkgname=unrar
pkgver=7.2.2
pkgrel=0
pkgdesc="Extract, view, and test RAR archives"
url="https://www.rarlab.com/rar_add.htm"
arch="all"
license="custom"
options="!check"
subpackages="$pkgname-dbg"

source="https://www.rarlab.com/rar/unrarsrc-$pkgver.tar.gz"
builddir="$srcdir/$pkgname"

build() {
	local CXXFLAGS="-std=c++11 $CXXFLAGS"
	local LDFLAGS="-pthread $LDFLAGS"

	make CXXFLAGS="$CXXFLAGS" LDFLAGS="$LDFLAGS" STRIP=: unrar
}


package() {
	install -Dm755 unrar \
		"$pkgdir"/usr/bin/unrar

	install -Dm644 readme.txt \
		"$pkgdir"/usr/share/doc/$pkgname/readme.txt
	install -Dm644 license.txt \
		"$pkgdir"/usr/share/licenses/$pkgname/license.txt
}


sha512sums="
a2041925f1c4ba948edb07d2a3b8a97b3da3f0108748fb4e52fa89a9344a03b432ab00e83e2c69641974db225ba07548953764d053d62e95a953fe26014bdd3a  unrarsrc-7.2.2.tar.gz
"
