pkgname=alsa-lib
pkgver=1.2.14
pkgrel=2
pkgdesc="Advanced Linux Sound Architecture (ALSA) library"
url="https://alsa-project.org/"
arch="all"
license="LGPL-2.1-or-later"
subpackages="$pkgname-dbg $pkgname-dev"
makedepends="linux-headers"
source="https://alsa-project.org/files/pub/lib/alsa-lib-$pkgver.tar.bz2
	remove-test.patch

	0100-CVE-2026-25068.patch
	0101-CVE-2026-56109.patch
	"

# secfixes:
#   1.2.14-r2:
#     - CVE-2026-56109
#   1.2.14-r1:
#     - CVE-2026-25068

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-python \
		--disable-static \
		--disable-resmgr \
		--enable-rawmidi \
		--enable-seq \
		--enable-aload \
		--disable-dependency-tracking \
		--without-versioned
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
	install -d -m755 "$pkgdir"/etc/alsa/conf.d
}

