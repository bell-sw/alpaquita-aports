# Description:

pkgname=py3-urllib3
_pkgname=urllib3
pkgver=1.26.20
pkgrel=3
pkgdesc="HTTP library with thread-safe connection pooling, file post, and more"
url="https://github.com/urllib3/urllib3"
arch="noarch"
license="MIT"
depends="python3"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="https://github.com/urllib3/urllib3/releases/download/$pkgver/urllib3-$pkgver.tar.gz

	0100-CVE-2025-66418.patch
	0101-CVE-2026-21441.patch
	0102-CVE-2026-44431.patch
	"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # needs py3-tornado from community

replaces="py-urllib3" # Backwards compatibility
provides="py-urllib3=$pkgver-r$pkgrel" # Backwards compatibility

# secfixes:
#   1.26.20-r3:
#     - CVE-2026-44431
#   1.26.20-r2:
#     - CVE-2026-21441
#   1.26.20-r1:
#     - CVE-2025-66418
#   1.26.18-r0:
#     - CVE-2023-45803
#   1.26.17-r0:
#     - CVE-2023-43804
#   1.25.9-r0:
#     - CVE-2020-26137
#   1.26.4-r0:
#     - CVE-2021-28363

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

