pkgname=strace
pkgver=7.2
pkgrel=0
pkgdesc="Diagnostic, debugging and instructional userspace tracer"
url="https://strace.io"
arch="all"
# checks fail on CI
options="!check"
license="BSD-3-Clause"
# strace with libunwind doesn't work right on musl
makedepends="binutils-dev elfutils-dev gawk linux-headers"
subpackages="$pkgname-doc $pkgname-dbg"
source="https://github.com/strace/strace/releases/download/v$pkgver/strace-$pkgver.tar.xz
	off64.patch
	busybox.patch
	tv_usec.patch
	nlattr-fix.patch
	"

build() {
	CFLAGS="$CFLAGS -flto=auto" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-mpers=no
	# FIXME don't use bundled kernel headers
	#	--enable-bundled=no
	make
}

check() {
	make check || {
		cat tests/test-suite.log
		return 1
	}
}

package() {
	make DESTDIR="$pkgdir" install
}

