pkgname=crun
pkgver=1.17
pkgrel=2
pkgdesc="Fast and lightweight fully featured OCI runtime and C library for running containers"
url="https://github.com/containers/crun"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
arch="all"
makedepends="libcap-dev libseccomp-dev yajl-dev musl:argp-standalone python3 go-md2man zstd"
subpackages="$pkgname-doc $pkgname-static"
source="https://github.com/containers/crun/releases/download/$pkgver/crun-$pkgver.tar.zst
	0100-CVE-2025-24965.patch
	0101-CVE-2026-47766.patch
	0102-CVE-2026-88265.patch
	0103-CVE-2026-88264.patch
	"

