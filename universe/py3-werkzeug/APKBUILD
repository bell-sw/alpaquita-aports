pkgname=py3-werkzeug
_pkgname=Werkzeug
pkgver=2.2.2
pkgrel=4
pkgdesc="The WSGI swiss-army knife"
url="https://werkzeug.palletsprojects.com/"
arch="noarch"
license="MIT"
depends="python3 py3-markupsafe"
makedepends="py3-setuptools"
checkdepends="py3-pytest py3-requests py3-pytest-timeout"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz
		0100-test_exclude_patterns-does-not-rely-on-sys.prefix.patch
		0101-CVE-2024-49767.patch
		"
builddir="$srcdir/$_pkgname-$pkgver"

replaces="py-werkzeug" # Backwards compatibility
provides="py-werkzeug=$pkgver-r$pkgrel" # Backwards compatibility

# secfixes:
#   2.2.2-r3:
#     - CVE-2024-49767
#   2.2.2-r0:
#     - CVE-2022-29361

build() {
	python3 setup.py build
}

package() {
	python3 setup.py install --prefix=/usr --root="$pkgdir"
}

check() {
	# dev_server tests require ephemeral-port-reserve which we don't provide
	PYTHONPATH=$PWD/build/lib pytest --noconftest -m "not dev_server"
}

