pkgname=vte3
pkgver=0.84.1
pkgrel=1
pkgdesc="Virtual Terminal Emulator library"
url="https://gitlab.gnome.org/GNOME/vte"
arch="all"
license="LGPL-2.0-or-later"
depends="$pkgname-profile"
subpackages="
	$pkgname-app
	$pkgname-dbg
	$pkgname-dev
	$pkgname-lang
	$pkgname-profile::noarch
	"
makedepends="
	bash
	fast_float
	fmt-dev
	gnutls-dev
	gobject-introspection-dev
	gperf
	gtk+3.0-dev
	gtk-doc
	icu-dev
	libxml2-utils
	linux-headers
	lz4-dev
	meson
	ncurses-dev
	pango-dev
	pcre2-dev
	simdutf-dev
	vala
	"
source="https://gitlab.gnome.org/GNOME/vte/-/archive/$pkgver/vte-$pkgver.tar.gz
	fix-W_EXITCODE.patch
	"

builddir="$srcdir/vte-$pkgver"

build() {
	abuild-meson \
		-Dgtk4=false \
		-Ddocs=false \
		-D_systemd=false \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

profile() {
	pkgdesc="$pkgdesc (profile files)"

	amove etc/profile.d
}

app() {
	pkgdesc="$pkgdesc (apps)"

	amove usr/bin
	amove usr/share/xdg-terminals
	amove usr/share/applications
}

sha512sums="
c59c3abf37307ba18ace0abae1d8b9da8f98fa9f4ac1994e79e2b2b3662dde811cccddd56a83e4879f1a39c3f0d938f14611f110088bb934d82986f3b50f093c  vte-0.84.1.tar.gz
b6c1856bf075c2e3e91a0d4aff700c59e738bd6abe4122a11d680f104a2dab9d99f7d836a3ef3020b25ceff0a37231a6561eb917f0e4b9f90837eb634d8f7f20  fix-W_EXITCODE.patch
"
