pkgname=vte3
pkgver=0.84.0
pkgrel=0
pkgdesc="Virtual Terminal Emulator library"
url="https://gitlab.gnome.org/GNOME/vte"
arch="all"
license="LGPL-2.0-or-later"
depends="$pkgname-profile"
subpackages="
	$pkgname-app
	$pkgname-dbg
	$pkgname-dev
	$pkgname-lang
	$pkgname-profile::noarch
	"
makedepends="
	bash
	fast_float
	fmt-dev
	gnutls-dev
	gobject-introspection-dev
	gperf
	gtk+3.0-dev
	gtk-doc
	icu-dev
	libxml2-utils
	linux-headers
	lz4-dev
	meson
	ncurses-dev
	pango-dev
	pcre2-dev
	simdutf-dev
	vala
	"
source="https://gitlab.gnome.org/GNOME/vte/-/archive/$pkgver/vte-$pkgver.tar.gz
	fix-W_EXITCODE.patch
	"

builddir="$srcdir/vte-$pkgver"

build() {
	abuild-meson \
		-Dgtk4=false \
		-Ddocs=false \
		-D_systemd=false \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

profile() {
	pkgdesc="$pkgdesc (profile files)"

	amove etc/profile.d
}

app() {
	pkgdesc="$pkgdesc (apps)"

	amove usr/bin
	amove usr/share/xdg-terminals
	amove usr/share/applications
}

sha512sums="
1bf75e54ecdb4b9aa601cda1a13779c3df6aebdff320d8d2236f29b4138661d26316b2e8066a80139cef369bbb5f36f7f74aa0842b17d6d9a7d1e0fda317c765  vte-0.84.0.tar.gz
b6c1856bf075c2e3e91a0d4aff700c59e738bd6abe4122a11d680f104a2dab9d99f7d836a3ef3020b25ceff0a37231a6561eb917f0e4b9f90837eb634d8f7f20  fix-W_EXITCODE.patch
"
