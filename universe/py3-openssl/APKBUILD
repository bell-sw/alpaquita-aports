7792215e8815a2cca05ca4d73f3263293eda27e03653899c5d53d95fc668f53aac3ba2d622cce1703bcce2da935644d9bb36e6afb40dd84a18d99a80b3b2c8b2  0100-CVE-2026-27448.patch
