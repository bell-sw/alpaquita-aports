b9af0204f37a8bd05cfbb48bba60d7b7a1336efdb8a7cc07b75371eee9ef4c4162dfb744e54762d8dfdc43e3ee3d46f5915218eca9013fb41170df095edc3089  0100-glibc-disable-dynamic-sigstksz.patch
"
