From 9c400c673f7adfd90020c262cbdfb4239e6a1521 Mon Sep 17 00:00:00 2001
From: Dmitry Klochkov <dmitry.klochkov@bell-sw.com>
Date: Thu, 2 Feb 2023 14:48:47 +0300
Subject: [PATCH] move vendor variables to functions.sh.in

---
 abuild.in       | 6 ------
 functions.sh.in | 8 ++++++++
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/abuild.in b/abuild.in
index 1bb31d2..f058442 100644
--- a/abuild.in
+++ b/abuild.in
@@ -25,12 +25,6 @@ fi
 # defaults
 : ${FAKEROOT:="fakeroot"}
 : ${APK:="apk"}
-: ${VENDOR_NAME:="BellSoft"}
-: ${VENDOR_URL:="https://bell-sw.com/"}
-: ${VENDOR_BUG_REPORT_URL:="https://bell-sw.com/support/"}
-: ${VENDOR_DISTRO:="alpaquita"}
-: ${VENDOR_DISTRO_NAME:="Alpaquita"}
-: ${VENDOR_JAVA_NAME:="Liberica"}
 if command -v abuild-apk >/dev/null; then
 	: ${SUDO_APK:="abuild-apk --no-interactive"}
 	: ${ADDUSER:="abuild-adduser"}
diff --git a/functions.sh.in b/functions.sh.in
index e84c147..a87485d 100644
--- a/functions.sh.in
+++ b/functions.sh.in
@@ -188,6 +188,14 @@ readconfig() {
 			export LDFLAGS="--sysroot=${CBUILDROOT} $LDFLAGS"
 		fi
 	fi
+
+	: ${VENDOR_NAME:="BellSoft"}
+	: ${VENDOR_URL:="https://bell-sw.com/"}
+	: ${VENDOR_BUG_REPORT_URL:="https://bell-sw.com/support/"}
+	: ${VENDOR_DISTRO:="alpaquita"}
+	: ${VENDOR_DISTRO_NAME:="Alpaquita"}
+	: ${VENDOR_JAVA_NAME:="Liberica"}
+
 	return 0
 }
 readconfig
-- 
2.55.0

