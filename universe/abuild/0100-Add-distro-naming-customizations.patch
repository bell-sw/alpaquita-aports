From 6fdf3177dfd3c115cace2c781cf367533ded75a5 Mon Sep 17 00:00:00 2001
From: Stanislav Kholmanskikh <stanislav.kholmanskikh@bell-sw.com>
Date: Wed, 18 Jan 2023 10:20:25 +0300
Subject: [PATCH] Add distro naming customizations

---
 abuild.in       | 2 +-
 functions.sh.in | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/abuild.in b/abuild.in
index 1dfcb1f..9dc17b6 100644
--- a/abuild.in
+++ b/abuild.in
@@ -2596,7 +2596,7 @@ rootbld() {
 		--arch $CBUILD_ARCH \
 		--root "$BUILD_ROOT" \
 		${cachedir:+--cache-dir $cachedir} \
-		abuild alpine-base $hostdeps $builddeps
+		abuild distro-base $hostdeps $builddeps
 
 	# busybox adduser/addgroup check if uid is 0 so we need to generate the files manually
 	awk -F: -v pkggroups="$pkggroups" -v pkgusers="$pkgusers" -v root="$BUILD_ROOT" -v home="$HOME" 'BEGIN {
diff --git a/functions.sh.in b/functions.sh.in
index 994494e..2ec4e87 100644
--- a/functions.sh.in
+++ b/functions.sh.in
@@ -132,7 +132,7 @@ readconfig() {
 		if [ -n "$gitbase" ]; then
 			case $($git remote get-url origin 2>/dev/null || true) in
 			# '.git' for SSH URLs, and no suffix for HTTPS URLs
-			*/aports|*/aports.git) APORTSDIR=$gitbase ;;
+			*/*aports|*/*aports.git) APORTSDIR=$gitbase ;;
 			*) APORTSDIR= ;;
 			esac
 		else
-- 
2.52.0

