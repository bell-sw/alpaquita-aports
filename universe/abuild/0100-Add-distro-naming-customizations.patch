From 40dc618bcdd491960aa3cdabb5405224d1df42d4 Mon Sep 17 00:00:00 2001
From: Stanislav Kholmanskikh <stanislav.kholmanskikh@bell-sw.com>
Date: Wed, 18 Jan 2023 10:20:25 +0300
Subject: [PATCH] Add distro naming customizations

---
 abuild.in       | 2 +-
 functions.sh.in | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/abuild.in b/abuild.in
index fe54580..c9d2c0d 100644
--- a/abuild.in
+++ b/abuild.in
@@ -2567,7 +2567,7 @@ rootbld() {
 	$ROOTBLD_APK add "$@" --initdb --update \
 		--arch $CBUILD_ARCH \
 		--root "$BUILD_ROOT" \
-		abuild alpine-base $builddeps
+		abuild distro-base $builddeps
 
 	if cross_compiling || cross_creating; then
 		mkdir -p -- "$BUILD_ROOT/home/user/sysroot-$CTARGET_ARCH"
diff --git a/functions.sh.in b/functions.sh.in
index 3167da3..a828258 100644
--- a/functions.sh.in
+++ b/functions.sh.in
@@ -138,7 +138,7 @@ readconfig() {
 		if [ -n "$gitbase" ]; then
 			case $($git remote get-url origin 2>/dev/null || true) in
 			# '.git' for SSH URLs, and no suffix for HTTPS URLs
-			*/aports|*/aports.git) APORTSDIR=$gitbase ;;
+			*/*aports|*/*aports.git) APORTSDIR=$gitbase ;;
 			*) APORTSDIR= ;;
 			esac
 		else
-- 
2.53.0

