From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Thu, 8 Sep 2022 16:28:03 +0300
Subject: [PATCH] create common vendor variables

---
 abuild.in | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/abuild.in b/abuild.in
index 2c07bc0..e5e8f2b 100644
--- a/abuild.in
+++ b/abuild.in
@@ -25,6 +25,10 @@ fi
 # defaults
 : ${FAKEROOT:="fakeroot"}
 : ${APK:="apk"}
+: ${VENDOR_NAME:="BellSoft"}
+: ${VENDOR_URL:="https://bell-sw.com/"}
+: ${VENDOR_BUG_REPORT_URL:="https://bell-sw.com/support/"}
+: ${VENDOR_JAVA_NAME:="Liberica"}
 if command -v abuild-apk >/dev/null; then
 	: ${SUDO_APK:="abuild-apk --no-interactive"}
 	: ${ADDUSER:="abuild-adduser"}
