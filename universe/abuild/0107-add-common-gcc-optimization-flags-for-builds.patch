From 16bb012a316258e206b0b02f17a1f320f36b83f2 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Thu, 14 Jul 2022 14:52:44 +0300
Subject: [PATCH] add common gcc optimization flags for builds

---
 functions.sh.in | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/functions.sh.in b/functions.sh.in
index 0ce6fa9..94a91ff 100644
--- a/functions.sh.in
+++ b/functions.sh.in
@@ -293,3 +293,19 @@ sign_kernel_modules() {
 	done
 	cd -
 }
+
+optimize_gcc_build()
+{
+	local level="${1:-3}"
+	local opts=""
+
+	if [ "$level" = "3" ]; then
+		opts="-Ofast"
+	fi
+
+	export CPPFLAGS="${CPPFLAGS/-Os/-O$level} $opts"
+	export CXXFLAGS="${CXXFLAGS/-Os/-O$level} $opts"
+	export CFLAGS="${CFLAGS/-Os/-O$level} $opts"
+
+	msg "Using -O$level, CFLAGS: $CFLAGS"
+}
-- 
