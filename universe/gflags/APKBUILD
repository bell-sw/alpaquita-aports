pkgname=gflags
pkgver=2.3.1
pkgrel=0
pkgdesc="The gflags package contains a C++ library that implements commandline flags processing."
url="https://gflags.github.io/gflags/"
arch="all"
license="BSD-3-Clause"
makedepends="cmake samurai"
subpackages="$pkgname-dev"
source="gflags-$pkgver.tar.gz::https://github.com/gflags/gflags/archive/v$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DBUILD_STATIC_LIBS=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_TESTING=ON \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DREGISTER_INSTALL_PREFIX=OFF
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
fb8d90848ff846d0e67d3b8381699c9f0a0ea88ab77f1bd84beffc1c23639a676238cbdb27542cbe91e30dfd7e1624556a49386eac25bd5a0ef5317ed662019e  gflags-2.3.1.tar.gz
"
