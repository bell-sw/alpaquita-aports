d08189624caf501249456c7daab69ec9c298253c3e03fd669ae0755fd74e722c775babd910b8fa6918bb5369c2c1dcac0501999e8ae0eabb48cae32899e24f9d  0100-Fix-texinfo-errors-and-warnings.patch
"
