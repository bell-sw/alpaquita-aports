+func expatAdvisory(introduced, fixed string) osvdata.Advisory {
+	return osvdata.Advisory{
+		ID:          "BELL-CVE-2025-59375",
+		CVE:         "CVE-2025-59375",
+		Introduced:  introduced,
+		Fixed:       fixed,
+		Severity:    "HIGH",
+		CVSSVersion: "3.1",
+		CVSSVector:  "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
+		CVSSScore:   7.5,
+		Details:     "libexpat before 2.7.2 has a signed integer overflow in big2_update_position",
+		References:  []osvdata.Reference{{Type: "ADVISORY", URL: "https://docs.bell-sw.com/security/cves/CVE-2025-59375"}},
+		SourceURL:   "https://github.com/bell-sw/osv-database/blob/master/BELL-CVE/BELL-CVE-2025-59375.json",
+		Published:   time.Date(2025, 9, 15, 0, 0, 0, 0, time.UTC),
+	}
+}
