+func TestProvider_DistroNameQuery(t *testing.T) {
+	engine, p := newFixture()
+	linux23 := distro.New(distro.VendorLinux, "23", "")
+
+	// the apk matcher resolves jdk21-lite-jdk-no-deps to the feed name openjdk21-lite and searches it like an
+	// origin package: a distro + name query lists the advisories keyed on that name
+	vulns, err := p.FindVulnerabilities(search.ByDistro(*linux23), search.ByPackageName("openjdk21-lite"))
+	require.NoError(t, err)
+	require.Len(t, vulns, 1)
+	v := vulns[0]
+	assert.Equal(t, "CVE-2025-30754", v.ID, "the CVE is the vulnerability id")
+	assert.Equal(t, DistroNamespace(linux23, "23"), v.Namespace)
+	assert.Equal(t, "openjdk21-lite", v.PackageName)
+	assert.Equal(t, vulnerability.FixStateFixed, v.Fix.State)
+	assert.Equal(t, []string{"21.0.8_p12-r0"}, v.Fix.Versions)
+	require.Len(t, v.Advisories, 1)
+	assert.Equal(t, "BELL-CVE-2025-30754", v.Advisories[0].ID)
+	require.Len(t, v.RelatedVulnerabilities, 1)
+	assert.Equal(t, "BELL-CVE-2025-30754", v.RelatedVulnerabilities[0].ID, "the BELL id is kept as a related id")
+	require.NotNil(t, v.Metadata)
+	assert.Equal(t, "Medium", v.Metadata.Severity)
+	assert.Equal(t, "< 21.0.8_p12-r0 (apk)", v.Constraint.String())
+	assert.Contains(t, engine.Calls, "advisories "+osvinternal.Ecosystem(EcosystemLinux, "23")+" openjdk21-lite")
+
+	// the version check is delegated to the module's apk range evaluation
+	vulnerable, err := v.Constraint.Satisfied(version.New("21.0.2_p14-r1", version.ApkFormat))
+	require.NoError(t, err)
+	assert.True(t, vulnerable)
+	vulnerable, err = v.Constraint.Satisfied(version.New("21.0.8_p12-r0", version.ApkFormat))
+	require.NoError(t, err)
+	assert.False(t, vulnerable)
+
+	// names the feed does not know yield nothing (the apk matcher then tries the provided names)
+	vulns, err = p.FindVulnerabilities(search.ByDistro(*linux23), search.ByPackageName("jdk21-lite-jdk-no-deps"))
+	require.NoError(t, err)
+	assert.Empty(t, vulns)
+
+	// the distro criteria of grype's own search layer accept the namespace
+	ok, _, err := search.ByDistro(*linux23).MatchesVulnerability(v)
+	require.NoError(t, err)
+	assert.True(t, ok)
+}
