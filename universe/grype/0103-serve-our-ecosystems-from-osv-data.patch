+/*
+Package vendordbtest provides an in-memory Engine for unit tests of the adapter and the matchers: findings are
+served from static tables keyed by (ecosystem, feed name), with a minimal version check
+so that tests can exercise grype's constraint plumbing without the real module data.
+*/
+package vendordbtest
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+)
+
+// Entry is one feed entry of the fake: an advisory for a package under an ecosystem with a version predicate.
+type Entry struct {
+	Advisory osvdata.Advisory
+	// Affected decides whether an installed version is inside the advisory's range.
+	Affected func(version string) bool
+}
+
+// Engine is a static vendordb.Engine.
+type Engine struct {
+	// Entries by full ecosystem ("<family>:23", "<family>:21") then feed name ("openjdk21-lite", "jdk").
+	Entries map[string]map[string][]Entry
+	// Calls records every query, for assertions.
+	Calls []string
+}
+
+func New() *Engine {
+	return &Engine{Entries: map[string]map[string][]Entry{}}
+}
+
+// Add registers an entry.
+func (e *Engine) Add(ecosystem, feedName string, a osvdata.Advisory, affected func(version string) bool) {
+	if e.Entries[ecosystem] == nil {
+		e.Entries[ecosystem] = map[string][]Entry{}
+	}
+	a.Ecosystem = ecosystem
+	a.Package = feedName
+	if a.CVE == "" {
+		a.CVE = a.ID
+	}
+	e.Entries[ecosystem][feedName] = append(e.Entries[ecosystem][feedName], Entry{Advisory: a, Affected: affected})
+}
+
+// candidates mirrors the module's resolution order: origin, provided names, provided names minus the sub-package
+// suffix; the first name known to the feed wins.
+func candidates(p match.Package) []string {
+	origin := p.Origin
+	if origin == "" {
+		origin = p.Name
+	}
+	names := []string{origin}
+	suffix := ""
+	if strings.HasPrefix(p.Name, origin) {
+		suffix = strings.TrimPrefix(p.Name, origin)
+	}
+	var stripped []string
+	for _, pv := range p.Provides {
+		if strings.Contains(pv, ":") || strings.HasPrefix(pv, "/") {
+			continue
+		}
+		if i := strings.IndexAny(pv, "=<>~"); i > 0 {
+			pv = pv[:i]
+		}
+		names = append(names, pv)
+		if suffix != "" && strings.HasSuffix(pv, suffix) {
+			stripped = append(stripped, strings.TrimSuffix(pv, suffix))
+		}
+	}
+	return append(names, stripped...)
+}
+
+func (e *Engine) APKFindings(_ context.Context, family, release string, p match.Package) ([]match.Finding, error) {
+	eco := osvinternal.Ecosystem(family, release)
+	e.Calls = append(e.Calls, fmt.Sprintf("apk %s %s@%s", eco, p.Name, p.Version))
+	byName := e.Entries[eco]
+	for _, name := range candidates(p) {
+		entries, ok := byName[name]
+		if !ok {
+			continue
+		}
+		var out []match.Finding
+		for _, en := range entries {
+			if en.Affected != nil && !en.Affected(p.Version) {
+				continue
+			}
+			out = append(out, match.Finding{
+				Advisory:         en.Advisory,
+				Ecosystem:        eco,
+				MatchedName:      name,
+				InstalledVersion: p.Version,
+				FixedVersion:     en.Advisory.Fixed,
+				Unfixed:          en.Advisory.Fixed == "",
+			})
+		}
+		return out, nil
+	}
+	return nil, nil
+}
+
+func (e *Engine) RuntimeFindings(_ context.Context, ecosystem, pkgName, version string) ([]match.Finding, error) {
+	e.Calls = append(e.Calls, fmt.Sprintf("runtime %s %s@%s", ecosystem, pkgName, version))
+	var out []match.Finding
+	for _, en := range e.Entries[ecosystem][pkgName] {
+		if en.Affected != nil && !en.Affected(version) {
+			continue
+		}
+		out = append(out, match.Finding{
+			Advisory:         en.Advisory,
+			Ecosystem:        ecosystem,
+			MatchedName:      pkgName,
+			InstalledVersion: version,
+			FixedVersion:     en.Advisory.Fixed,
+			Unfixed:          en.Advisory.Fixed == "",
+		})
+	}
+	return out, nil
+}
+
+func (e *Engine) Advisories(_ context.Context, family, release, feedName string) ([]osvdata.Advisory, error) {
+	eco := osvinternal.Ecosystem(family, release)
+	e.Calls = append(e.Calls, fmt.Sprintf("advisories %s %s", eco, feedName))
+	var out []osvdata.Advisory
+	for _, en := range e.Entries[eco][feedName] {
+		out = append(out, en.Advisory)
+	}
+	return out, nil
+}
+
+func (e *Engine) EOL(release string) *time.Time {
+	switch release {
+	case "23":
+		t := time.Date(2026, 12, 31, 0, 0, 0, 0, time.UTC)
+		return &t
+	case "25":
+		t := time.Date(2031, 12, 31, 0, 0, 0, 0, time.UTC)
+		return &t
+	}
+	return nil
+}
+
+func (e *Engine) Provenance() map[string]time.Time {
+	return map[string]time.Time{osvinternal.EcosystemLinux: time.Date(2026, 10, 10, 0, 0, 0, 0, time.UTC)}
+}
