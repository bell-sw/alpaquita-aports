new file mode 100644
index 0000000..15496ed
--- /dev/null
+++ b/grype/vulnerability/vendordb/config.go
@@ -0,0 +1,56 @@
+package vendordb
+
+import (
+	"net/http"
+	"time"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/osvdata"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+)
+
+// Ecosystem names as published on osv.dev (and the prototype runtime ecosystems).
+const (
+	EcosystemLinux    = osvinternal.EcosystemLinux
+	EcosystemHardened = osvinternal.EcosystemHardened
+	EcosystemJDK      = osvinternal.EcosystemJDK
+	EcosystemNIK      = osvinternal.EcosystemNIK
+
+	// DefaultBaseURL (the osv.dev bucket) and DefaultJDKBaseURL are the module's default sources of the distribution
+	// and the runtime families (osvdata.DefaultBaseURLFor).
+	DefaultBaseURL    = osvdata.DefaultBaseURL
+	DefaultJDKBaseURL = osvdata.DefaultProductBaseURL
+
+	// Provider is the namespace prefix of every vulnerability served by this adapter: the vendor's id, the
+	// module's purl namespace.
+	Provider = osvjdk.PURLNamespace
+
+	DefaultCacheTTL = osvdata.DefaultTTL
+	DefaultTimeout  = 5 * time.Minute
+)
+
+// Config is the adapter configuration (populated from the CLI options: vendor.* / GRYPE_VENDOR_*).
+type Config struct {
+	// BaseURL serves every ecosystem unless overridden; accepts https://, file:// and plain directory paths. Empty
+	// (the default) means each family uses its own default source.
+	BaseURL string
+	// EcosystemURLs overrides the base URL per ecosystem name (e.g. the JDK family -> a local HTTP server or path).
+	EcosystemURLs map[string]string
+	// CacheDir holds <ecosystem>/ sub-directories with the downloaded archive, timestamp and index.
+	CacheDir string
+	// TTL is the cache lifetime; an older archive is re-downloaded (unless Offline).
+	TTL time.Duration
+	// Offline forbids downloads (grype db.auto-update=false): a present cache is used, a missing one makes the
+	// family unavailable.
+	Offline bool
+	// Strict turns an unavailable archive (download failure, HTTP error, offline with nothing cached) into an error
+	// that fails the scan. By default the scan warns once per family and continues without that family's findings.
+	Strict bool
+	// Warn, when set, also receives the warning about an unavailable family (the CLI shows it as a notification);
+	// the warning is always logged at WARN level.
+	Warn func(message string)
+	// HTTPClient replaces the download client (tests).
+	HTTPClient *http.Client
+	// Timeout bounds one archive download.
+	Timeout time.Duration
+}
diff --git a/grype/vulnerability/vendordb/constraint.go b/grype/vulnerability/vendordb/constraint.go
new file mode 100644
index 0000000..36496fa
--- /dev/null
+++ b/grype/vulnerability/vendordb/constraint.go
@@ -0,0 +1,64 @@
+package vendordb
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	"github.com/anchore/grype/grype/version"
+)
+
+// evaluator answers whether the given version is affected by the advisory (delegated to the module).
+type evaluator func(advisoryID, ver string) (bool, error)
+
+// rangeConstraint is a version.Constraint backed by the module's range evaluation: String() renders the OSV range,
+// Satisfied() asks the engine, so grype never re-implements apk or JDK version comparison.
+type rangeConstraint struct {
+	display    string
+	format     version.Format
+	advisoryID string
+	eval       evaluator
+}
+
+func newRangeConstraint(a osvdata.Advisory, format version.Format, eval evaluator) version.Constraint {
+	var parts []string
+	if a.Introduced != "" && a.Introduced != "0" {
+		parts = append(parts, ">= "+a.Introduced)
+	}
+	switch {
+	case a.Fixed != "":
+		parts = append(parts, "< "+a.Fixed)
+	case a.LastAffected != "":
+		parts = append(parts, "<= "+a.LastAffected)
+	}
+	display := strings.Join(parts, ", ")
+	if display == "" {
+		display = ">= 0"
+	}
+	return &rangeConstraint{display: display, format: format, advisoryID: a.ID, eval: eval}
+}
+
+func (c *rangeConstraint) String() string {
+	return fmt.Sprintf("%s (%s)", c.display, strings.ToLower(c.format.String()))
+}
+
+func (c *rangeConstraint) Value() string {
+	return c.display
+}
+
+func (c *rangeConstraint) Format() version.Format {
+	return c.format
+}
+
+func (c *rangeConstraint) Satisfied(v *version.Version) (bool, error) {
+	if v == nil {
+		return false, version.ErrNoVersionProvided
+	}
+	if c.eval == nil {
+		return false, nil
+	}
+	return c.eval(c.advisoryID, v.Raw)
+}
+
+var _ version.Constraint = (*rangeConstraint)(nil)
diff --git a/grype/vulnerability/vendordb/criteria.go b/grype/vulnerability/vendordb/criteria.go
new file mode 100644
index 0000000..67a23af
--- /dev/null
+++ b/grype/vulnerability/vendordb/criteria.go
@@ -0,0 +1,131 @@
+package vendordb
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/bell-sw/osv-internal/jdkver"
+	osvjdk "github.com/bell-sw/osv-internal/vendorjdk"
+
+	"github.com/anchore/grype/grype/distro"
+	"github.com/anchore/grype/grype/pkg"
+	"github.com/anchore/grype/grype/vulnerability"
+	syftPkg "github.com/anchore/syft/syft/pkg"
+)
+
+// IsVendorDistro reports whether the distro is served by the vendor OSV data.
+func IsVendorDistro(d *distro.Distro) bool {
+	if d == nil {
+		return false
+	}
+	return ecosystemForDistro(d.Type) != ""
+}
+
+// ecosystemForDistro maps a grype distro type to the OSV ecosystem family.
+func ecosystemForDistro(t distro.Type) string {
+	switch t {
+	case distro.VendorLinux:
+		return EcosystemLinux
+	case distro.VendorHardened:
+		return EcosystemHardened
+	}
+	return ""
+}
+
+// releaseOf returns the VERSION_ID the distro was created from ("stream", "23", "25"), untouched.
+func releaseOf(d distro.Distro) string {
+	if d.Version != "" {
+		return d.Version
+	}
+	return d.LabelVersion()
+}
+
+// RuntimeCriteria asks the provider to evaluate a standalone vendor runtime in its product ecosystem (JDK
+// "<family>:<major>", package = variant, version "21.0.2+14" / "8u402+7"; NIK "<family>:<nik major>-<java major>", package =
+// bundle, version "23.1.0+1"). Other providers ignore it.
+type RuntimeCriteria struct {
+	Ecosystem string
+	Package   string
+	Version   string
+}
+
+// ByRuntime builds the RuntimeCriteria for a vendor JDK / NIK package.
+func ByRuntime(p pkg.Package) vulnerability.Criteria {
+	return &RuntimeCriteria{Ecosystem: RuntimeEcosystem(p), Package: p.Name, Version: p.Version}
+}
+
+// RuntimeEcosystem returns the OSV ecosystem of a vendor JDK / NIK package, as the shared module names it
+// (vendorjdk.Runtime.Ecosystem): the Java major comes from the JDK version, or for a NIK from the bundled Java version
+// kept in the package metadata. It returns "" when the package is not a vendor runtime or the major is unknown.
+func RuntimeEcosystem(p pkg.Package) string {
+	rt := osvjdk.Runtime{Variant: p.Name, Version: p.Version}
+	switch p.Type {
+	case syftPkg.VendorJdkPkg:
+		v, err := jdkver.Parse(p.Version)
+		if err != nil {
+			return ""
+		}
+		rt.Product, rt.Major = osvjdk.ProductJDK, v.Major
+	case syftPkg.VendorNikPkg:
+		rt.Product, rt.IsNIK = osvjdk.ProductNIK, true
+		if md, ok := p.Metadata.(pkg.JavaVMInstallationMetadata); ok {
+			rt.Major = javaMajor(md.Release.JavaVersion)
+			if rt.Major == 0 {
+				rt.Major = javaMajor(md.Release.JavaRuntimeVersion)
+			}
+		}
+		if rt.NIKMajor() == 0 {
+			return ""
+		}
+	default:
+		return ""
+	}
+	if rt.Major == 0 {
+		return ""
+	}
+	return rt.Ecosystem()
+}
+
+func (c *RuntimeCriteria) MatchesVulnerability(_ vulnerability.Vulnerability) (bool, string, error) {
+	return true, "", nil
+}
+
+func (c *RuntimeCriteria) Summarize() string {
+	return fmt.Sprintf("%s runtime %s@%s", c.Ecosystem, c.Package, c.Version)
+}
+
+// FamilyOfType maps the syft package types of standalone vendor runtimes to their OSV ecosystem family.
+func FamilyOfType(t syftPkg.Type) string {
+	switch t {
+	case syftPkg.VendorJdkPkg:
+		return EcosystemJDK
+	case syftPkg.VendorNikPkg:
+		return EcosystemNIK
+	}
+	return ""
+}
+
+// IsVendorRuntimeType reports whether a syft package type is a standalone vendor runtime type.
+func IsVendorRuntimeType(t syftPkg.Type) bool {
+	return FamilyOfType(t) != ""
+}
+
+// javaMajor extracts the Java major from a JAVA_VERSION-like string: "21", "21.0.2", "21+37" -> 21; "1.8.0_402" -> 8.
+func javaMajor(v string) int {
+	v = strings.TrimSpace(v)
+	if strings.HasPrefix(v, "1.") {
+		v = v[2:]
+	}
+	n := 0
+	for _, r := range v {
+		if r < '0' || r > '9' {
+			break
+		}
+		n = n*10 + int(r-'0')
+	}
+	return n
+}
+
+var _ interface {
+	vulnerability.Criteria
+} = (*RuntimeCriteria)(nil)
diff --git a/grype/vulnerability/vendordb/engine.go b/grype/vulnerability/vendordb/engine.go
new file mode 100644
index 0000000..973be70
--- /dev/null
+++ b/grype/vulnerability/vendordb/engine.go
@@ -0,0 +1,38 @@
+/*
+Package vendordb is grype's adapter for the vendor OSV data (its apk-based distributions and standalone JDK and
+NIK runtimes). It composes a vulnerability.Provider: queries for the vendor distro namespaces and
+the vendor JDK / NIK package types are answered from the OSV bulk archives through the shared osv-internal
+module, every other query by the wrapped provider (Anchore's database); `grype db` is untouched.
+
+The adapter owns the grype-specific concerns only: criteria routing, namespaces, vulnerability/match shapes, metadata
+enrichment from the wrapped provider and configuration. Archive fetch/cache/index, range evaluation and the alias
+resolution are the module's (see Engine).
+*/
+package vendordb
+
+import (
+	"context"
+	"time"
+
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+)
+
+// Engine is the slice of the osv-internal module used by the adapter (bound in engine_module.go; faked in tests).
+type Engine interface {
+	// APKFindings evaluates an installed apk package of the given ecosystem family (the module's EcosystemLinux /
+	// EcosystemHardened) and release ("stream", "23", "25") against the feed, resolving the feed name through origin and
+	// provided names. Only findings whose range contains the installed version are returned.
+	APKFindings(ctx context.Context, family, release string, p match.Package) ([]match.Finding, error)
+	// RuntimeFindings evaluates a standalone vendor runtime against its product ecosystem, given in full as the module
+	// names it ("<JDK family>:21" with package = variant such as "jdk" and version "21.0.2+14" / "8u402+7";
+	// "<NIK family>:23-21" with package = bundle such as "core" and version "23.1.0+1").
+	RuntimeFindings(ctx context.Context, ecosystem, pkgName, version string) ([]match.Finding, error)
+	// Advisories lists every advisory of the family/release keyed on a feed (source) package name, whatever the
+	// version; used for grype's fix bookkeeping and NVD de-duplication.
+	Advisories(ctx context.Context, family, release, feedName string) ([]osvdata.Advisory, error)
+	// EOL returns the end-of-life date of a distribution release, or nil when it never reaches end of life or is unknown.
+	EOL(release string) *time.Time
+	// Provenance reports, per family already loaded, when its archive was captured.
+	Provenance() map[string]time.Time
+}
diff --git a/grype/vulnerability/vendordb/engine_module.go b/grype/vulnerability/vendordb/engine_module.go
new file mode 100644
index 0000000..a692f74
--- /dev/null
+++ b/grype/vulnerability/vendordb/engine_module.go
@@ -0,0 +1,132 @@
+package vendordb
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/distro"
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	"github.com/anchore/grype/internal/log"
+)
+
+// NewEngine binds the adapter to the shared osv-internal module.
+func NewEngine(cfg Config) (Engine, error) {
+	src := &osvdata.Source{
+		// an empty base URL keeps the module's per-family defaults (osvdata.DefaultBaseURLFor)
+		BaseURL:  cfg.BaseURL,
+		URLs:     cfg.EcosystemURLs,
+		CacheDir: cfg.CacheDir,
+		TTL:      cfg.TTL,
+		Offline:  cfg.Offline,
+		Logf: func(format string, args ...any) {
+			log.Debugf("vendordb: "+format, args...)
+		},
+	}
+	switch {
+	case cfg.HTTPClient != nil:
+		src.HTTPClient = cfg.HTTPClient
+	case cfg.Timeout > 0:
+		src.HTTPClient = &http.Client{Timeout: cfg.Timeout}
+	}
+	return &moduleEngine{source: src, strict: cfg.Strict, warn: cfg.Warn, loaded: map[string]time.Time{}, unavailable: map[string]bool{}}, nil
+}
+
+type moduleEngine struct {
+	source      *osvdata.Source
+	strict      bool
+	warn        func(string)
+	mu          sync.Mutex
+	loaded      map[string]time.Time
+	unavailable map[string]bool
+}
+
+// index returns the index of a family. An unavailable archive is warned about once per family with the module's
+// canonical text and yields no findings (nil index, nil error); in strict mode it is an error.
+func (e *moduleEngine) index(ctx context.Context, family string) (*osvdata.Index, error) {
+	e.mu.Lock()
+	gone := e.unavailable[family]
+	e.mu.Unlock()
+	if gone {
+		return nil, nil
+	}
+
+	var idx *osvdata.Index
+	var err error
+	if e.strict {
+		idx, err = e.source.Ecosystem(ctx, family)
+	} else {
+		var warning string
+		idx, warning, err = e.source.EcosystemOrWarn(ctx, family)
+		if err == nil && warning != "" {
+			e.mu.Lock()
+			first := !e.unavailable[family]
+			e.unavailable[family] = true
+			e.mu.Unlock()
+			if first {
+				log.Warn(warning)
+				if e.warn != nil {
+					e.warn(warning)
+				}
+			}
+			return nil, nil
+		}
+	}
+	if err != nil {
+		return nil, fmt.Errorf("unable to load the vendor OSV archive for %q: %w", family, err)
+	}
+	e.mu.Lock()
+	if _, ok := e.loaded[family]; !ok {
+		e.loaded[family] = idx.DownloadedAt
+		log.WithFields("ecosystem", family, "records", idx.Records, "advisories", idx.Len(), "downloaded", idx.DownloadedAt, "stale", idx.Stale).Info("loaded vendor OSV data")
+	}
+	e.mu.Unlock()
+	return idx, nil
+}
+
+func (e *moduleEngine) APKFindings(ctx context.Context, family, release string, p match.Package) ([]match.Finding, error) {
+	idx, err := e.index(ctx, family)
+	if err != nil || idx == nil {
+		return nil, err
+	}
+	return match.MatchAPK(idx, p, release)
+}
+
+func (e *moduleEngine) RuntimeFindings(ctx context.Context, ecosystem, pkgName, version string) ([]match.Finding, error) {
+	idx, err := e.index(ctx, osvinternal.Family(ecosystem))
+	if err != nil || idx == nil {
+		return nil, err
+	}
+	return match.MatchProduct(idx, ecosystem, pkgName, version)
+}
+
+func (e *moduleEngine) Advisories(ctx context.Context, family, release, feedName string) ([]osvdata.Advisory, error) {
+	idx, err := e.index(ctx, family)
+	if err != nil || idx == nil {
+		return nil, err
+	}
+	return idx.Advisories(feedName, release), nil
+}
+
+func (e *moduleEngine) EOL(release string) *time.Time {
+	eol, known := distro.EOL(release)
+	if !known || eol.IsZero() {
+		return nil
+	}
+	return &eol
+}
+
+func (e *moduleEngine) Provenance() map[string]time.Time {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	out := make(map[string]time.Time, len(e.loaded))
+	for k, v := range e.loaded {
+		out[k] = v
+	}
+	return out
+}
diff --git a/grype/vulnerability/vendordb/engine_module_test.go b/grype/vulnerability/vendordb/engine_module_test.go
new file mode 100644
index 0000000..ed97b59
--- /dev/null
+++ b/grype/vulnerability/vendordb/engine_module_test.go
@@ -0,0 +1,183 @@
+package vendordb
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	"github.com/anchore/grype/grype/distro"
+	"github.com/anchore/grype/grype/pkg"
+	"github.com/anchore/grype/grype/search"
+	"github.com/anchore/grype/grype/vulnerability/mock"
+	syftPkg "github.com/anchore/syft/syft/pkg"
+)
+
+// recorder is an http.RoundTripper that records every requested URL and answers with a fixed status.
+type recorder struct {
+	mu     sync.Mutex
+	urls   []string
+	status int
+}
+
+func (r *recorder) RoundTrip(req *http.Request) (*http.Response, error) {
+	r.mu.Lock()
+	r.urls = append(r.urls, req.URL.String())
+	r.mu.Unlock()
+	return &http.Response{
+		StatusCode: r.status,
+		Status:     http.StatusText(r.status),
+		Body:       io.NopCloser(strings.NewReader("")),
+		Header:     http.Header{},
+		Request:    req,
+	}, nil
+}
+
+func (r *recorder) requested() []string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]string(nil), r.urls...)
+}
+
+// archiveURL is where the module fetches the archive of a family below a base URL (<base>/<family>/all.zip);
+// defaultArchiveURL applies the module's built-in base of the family.
+func archiveURL(base, family string) string {
+	return base + "/" + url.PathEscape(family) + "/" + osvdata.ArchiveName
+}
+
+func defaultArchiveURL(family string) string {
+	return archiveURL(osvdata.DefaultBaseURLFor(family), family)
+}
+
+// unavailableWarning is the module's canonical warning for a family whose archive could not be fetched from its
+// default source.
+func unavailableWarning(family, reason string) string {
+	return (&osvdata.UnavailableError{Family: family, Reason: reason, URL: defaultArchiveURL(family)}).Warning()
+}
+
+func newRecordingEngine(t *testing.T, cfg Config) (Engine, *recorder, *[]string) {
+	t.Helper()
+	rec := &recorder{status: http.StatusNotFound}
+	var warnings []string
+	cfg.CacheDir = t.TempDir()
+	cfg.HTTPClient = &http.Client{Transport: rec}
+	cfg.Warn = func(msg string) { warnings = append(warnings, msg) }
+	engine, err := NewEngine(cfg)
+	require.NoError(t, err)
+	return engine, rec, &warnings
+}
+
+// With no configuration every family is requested from its built-in source: the osv.dev bucket for the two
+// distributions, the module's product base URL for the two runtime families.
+func TestEngine_DefaultSources(t *testing.T) {
+	engine, rec, _ := newRecordingEngine(t, Config{})
+	ctx := context.Background()
+
+	_, err := engine.Advisories(ctx, EcosystemLinux, "stream", "glibc")
+	require.NoError(t, err)
+	_, err = engine.APKFindings(ctx, EcosystemHardened, "stream", match.Package{Name: "glibc", Version: "2.37.0-r0", Origin: "glibc"})
+	require.NoError(t, err)
+	_, err = engine.RuntimeFindings(ctx, osvinternal.Ecosystem(EcosystemJDK, "21"), "jdk", "21.0.2+14")
+	require.NoError(t, err)
+	_, err = engine.RuntimeFindings(ctx, osvinternal.Ecosystem(EcosystemNIK, "23-21"), "core", "23.1.0+1")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{
+		archiveURL(osvdata.DefaultBaseURL, EcosystemLinux),
+		archiveURL(osvdata.DefaultBaseURL, EcosystemHardened),
+		archiveURL(osvdata.DefaultProductBaseURL, EcosystemJDK),
+		archiveURL(osvdata.DefaultProductBaseURL, EcosystemNIK),
+	}, rec.requested())
+}
+
+// A global base URL and the per-family overrides win over the built-in sources.
+func TestEngine_Overrides(t *testing.T) {
+	engine, rec, _ := newRecordingEngine(t, Config{
+		BaseURL:       "https://mirror.example/osv",
+		EcosystemURLs: map[string]string{EcosystemNIK: "https://nik.example/data"},
+	})
+	ctx := context.Background()
+	_, _ = engine.Advisories(ctx, EcosystemLinux, "stream", "glibc")
+	_, _ = engine.RuntimeFindings(ctx, osvinternal.Ecosystem(EcosystemJDK, "21"), "jdk", "21.0.2+14")
+	_, _ = engine.RuntimeFindings(ctx, osvinternal.Ecosystem(EcosystemNIK, "23-21"), "core", "23.1.0+1")
+	assert.Equal(t, []string{
+		archiveURL("https://mirror.example/osv", EcosystemLinux),
+		archiveURL("https://mirror.example/osv", EcosystemJDK),
+		archiveURL("https://nik.example/data", EcosystemNIK),
+	}, rec.requested())
+}
+
+// An archive that cannot be obtained is not an error: one canonical warning per family, no findings from that
+// family, and the source is not asked again for every package.
+func TestEngine_UnavailableWarnsOnceAndContinues(t *testing.T) {
+	engine, rec, warnings := newRecordingEngine(t, Config{})
+	ctx := context.Background()
+
+	for i := 0; i < 3; i++ {
+		findings, err := engine.RuntimeFindings(ctx, osvinternal.Ecosystem(EcosystemJDK, "21"), "jdk", "21.0.2+14")
+		require.NoError(t, err)
+		assert.Empty(t, findings)
+		advisories, err := engine.Advisories(ctx, EcosystemLinux, "23", "openjdk21-lite")
+		require.NoError(t, err)
+		assert.Empty(t, advisories)
+	}
+
+	require.Len(t, *warnings, 2, "one warning per family")
+	assert.Equal(t, unavailableWarning(EcosystemJDK, "HTTP 404"), (*warnings)[0])
+	assert.Equal(t, unavailableWarning(EcosystemLinux, "HTTP 404"), (*warnings)[1])
+	assert.Len(t, rec.requested(), 2, "an unavailable family is not requested again during the scan")
+}
+
+// The same policy with updates disabled and nothing cached; through the provider a scan simply gets no vendor
+// vulnerabilities for the affected packages.
+func TestEngine_OfflineWithoutCacheWarns(t *testing.T) {
+	engine, rec, warnings := newRecordingEngine(t, Config{Offline: true})
+	p := Wrap(mock.VulnerabilityProvider(), engine)
+
+	vulns, err := p.FindVulnerabilities(search.ByPackageName("glibc"), search.ByDistro(*distro.New(distro.VendorHardened, "stream", "")))
+	require.NoError(t, err)
+	assert.Empty(t, vulns)
+
+	jdk := pkg.Package{Name: "jdk", Version: "21.0.2+14", Type: syftPkg.VendorJdkPkg}
+	vulns, err = p.FindVulnerabilities(search.ByEcosystem(syftPkg.Java, syftPkg.VendorJdkPkg), search.ByPackageName("jdk"), ByRuntime(jdk))
+	require.NoError(t, err)
+	assert.Empty(t, vulns)
+
+	require.Len(t, *warnings, 2)
+	assert.Contains(t, (*warnings)[0], fmt.Sprintf("%s OSV data for %q is unavailable (", osvinternal.Vendor, EcosystemHardened))
+	assert.Contains(t, (*warnings)[0], fmt.Sprintf("packages of this product were NOT checked against %s advisories. Source: %s", osvinternal.Vendor, defaultArchiveURL(EcosystemHardened)))
+	assert.Contains(t, (*warnings)[1], fmt.Sprintf("%s OSV data for %q is unavailable (", osvinternal.Vendor, EcosystemJDK))
+	assert.Empty(t, rec.requested(), "offline: nothing is downloaded")
+}
+
+// Strict mode restores failing: the error names the family, is an osvdata.UnavailableError and reaches the matchers
+// marked as ErrSourceUnavailable.
+func TestEngine_StrictFails(t *testing.T) {
+	for _, offline := range []bool{false, true} {
+		engine, _, warnings := newRecordingEngine(t, Config{Strict: true, Offline: offline})
+		_, err := engine.RuntimeFindings(context.Background(), osvinternal.Ecosystem(EcosystemJDK, "21"), "jdk", "21.0.2+14")
+		require.Error(t, err)
+		var unavailable *osvdata.UnavailableError
+		require.True(t, errors.As(err, &unavailable), "%v", err)
+		assert.Equal(t, EcosystemJDK, unavailable.Family)
+		assert.Equal(t, offline, errors.Is(err, osvdata.ErrNotCached))
+		assert.Empty(t, *warnings)
+
+		p := Wrap(mock.VulnerabilityProvider(), engine)
+		_, err = p.FindVulnerabilities(search.ByPackageName("glibc"), search.ByDistro(*distro.New(distro.VendorLinux, "stream", "")))
+		require.Error(t, err)
+		assert.ErrorIs(t, err, ErrSourceUnavailable)
+	}
+}
diff --git a/grype/vulnerability/vendordb/provider.go b/grype/vulnerability/vendordb/provider.go
new file mode 100644
index 0000000..5a0cde0
--- /dev/null
+++ b/grype/vulnerability/vendordb/provider.go
@@ -0,0 +1,473 @@
+package vendordb
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	"github.com/anchore/grype/grype/distro"
+	"github.com/anchore/grype/grype/pkg"
+	"github.com/anchore/grype/grype/search"
+	"github.com/anchore/grype/grype/version"
+	"github.com/anchore/grype/grype/vulnerability"
+	"github.com/anchore/grype/internal/cvss"
+	"github.com/anchore/grype/internal/log"
+)
+
+var (
+	_ vulnerability.Provider              = (*provider)(nil)
+	_ vulnerability.StoreMetadataProvider = (*provider)(nil)
+	_ vulnerability.EOLChecker            = (*provider)(nil)
+)
+
+// ErrSourceUnavailable marks every error of the vendor OSV data source that reaches a matcher (in strict mode an
+// archive that cannot be obtained, in any mode a cache fault or an unreadable index); matchers turn it into a fatal
+// error. Without strict mode an unavailable archive is a warning, not an error.
+var ErrSourceUnavailable = errors.New(osvinternal.Vendor + " OSV data source unavailable")
+
+type sourceError struct {
+	err error
+}
+
+func (e *sourceError) Error() string { return "vendor osv: " + e.err.Error() }
+func (e *sourceError) Unwrap() error { return e.err }
+func (e *sourceError) Is(target error) bool {
+	return target == ErrSourceUnavailable
+}
+
+func wrapSourceError(err error) error {
+	if err == nil {
+		return nil
+	}
+	return &sourceError{err: err}
+}
+
+// Wrap composes the vendor OSV source with an existing provider (Anchore's database): vendor distro namespaces and
+// vendor JDK / NIK packages are answered from the OSV data, everything else by upstream.
+func Wrap(upstream vulnerability.Provider, engine Engine) vulnerability.Provider {
+	return &provider{
+		upstream:  upstream,
+		engine:    engine,
+		metaCache: map[string]*vulnerability.Metadata{},
+	}
+}
+
+type provider struct {
+	upstream  vulnerability.Provider
+	engine    Engine
+	mu        sync.Mutex
+	metaCache map[string]*vulnerability.Metadata
+}
+
+type queryKind int
+
+const (
+	upstreamQuery queryKind = iota
+	apkQuery
+	jdkQuery
+)
+
+// query is one flattened AND-row of criteria classified for routing.
+type query struct {
+	kind       queryKind
+	ecosystem  string // apk: ecosystem family
+	release    string // apk: VERSION_ID
+	distro     *distro.Distro
+	name       string // ByPackageName
+	jdk        *RuntimeCriteria
+	id         string // ByID
+	unaffected bool
+	rest       []vulnerability.Criteria // criteria applied as in-memory filters
+}
+
+func classify(row []vulnerability.Criteria) query {
+	q := query{}
+	for _, c := range row {
+		switch c := c.(type) {
+		case *search.DistroCriteria:
+			for i := range c.Distros {
+				d := c.Distros[i]
+				if eco := ecosystemForDistro(d.Type); eco != "" {
+					q.kind = apkQuery
+					q.ecosystem = eco
+					q.release = releaseOf(d)
+					q.distro = &d
+					break
+				}
+			}
+		case *search.EcosystemCriteria:
+			if IsVendorRuntimeType(c.PackageType) {
+				q.kind = jdkQuery
+			}
+		case *search.PackageNameCriteria:
+			q.name = c.PackageName
+		case *RuntimeCriteria:
+			q.jdk = c
+		case *search.IDCriteria:
+			q.id = c.ID
+		case *search.UnaffectedCriteria:
+			q.unaffected = true
+		default:
+			q.rest = append(q.rest, c)
+		}
+	}
+	return q
+}
+
+func (p *provider) FindVulnerabilities(criteria ...vulnerability.Criteria) ([]vulnerability.Vulnerability, error) {
+	if err := search.ValidateCriteria(criteria); err != nil {
+		return nil, err
+	}
+
+	var rows [][]vulnerability.Criteria
+	var queries []query
+	ours := false
+	for _, row := range search.CriteriaIterator(criteria) {
+		q := classify(row)
+		if q.kind != upstreamQuery {
+			ours = true
+		}
+		rows = append(rows, row)
+		queries = append(queries, q)
+	}
+	if !ours {
+		return p.upstream.FindVulnerabilities(criteria...)
+	}
+
+	var out []vulnerability.Vulnerability
+	for i, q := range queries {
+		var vulns []vulnerability.Vulnerability
+		var err error
+		switch q.kind {
+		case upstreamQuery:
+			vulns, err = p.upstream.FindVulnerabilities(rows[i]...)
+		case apkQuery:
+			vulns, err = p.findAPK(q)
+		case jdkQuery:
+			vulns, err = p.findJDK(q)
+		}
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, vulns...)
+	}
+	return out, nil
+}
+
+func (p *provider) findAPK(q query) ([]vulnerability.Vulnerability, error) {
+	if q.unaffected {
+		// the vendor feed carries affected ranges only (no NAK / unaffected records)
+		return nil, nil
+	}
+	ctx := context.Background()
+	ns := DistroNamespace(q.distro, q.release)
+	var vulns []vulnerability.Vulnerability
+	if q.name == "" {
+		log.WithFields("ecosystem", q.ecosystem, "release", q.release).Trace("vendor osv: distro search without a package name; nothing to do")
+		return nil, nil
+	}
+	advisories, err := p.engine.Advisories(ctx, q.ecosystem, q.release, q.name)
+	if err != nil {
+		return nil, wrapSourceError(err)
+	}
+	for _, a := range advisories {
+		vulns = append(vulns, p.newVulnerability(ns, a, q.name, p.apkEvaluator(q, q.name), version.ApkFormat))
+	}
+	return p.filter(vulns, q)
+}
+
+func (p *provider) findJDK(q query) ([]vulnerability.Vulnerability, error) {
+	if q.unaffected {
+		return nil, nil
+	}
+	if q.jdk == nil {
+		log.WithFields("package", q.name).Trace("vendor osv: runtime search without the runtime criteria; nothing to do")
+		return nil, nil
+	}
+	if q.jdk.Ecosystem == "" {
+		log.WithFields("package", q.jdk.Package, "version", q.jdk.Version).Warn("vendor osv: unable to determine the ecosystem of a vendor runtime; not matched")
+		return nil, nil
+	}
+	findings, err := p.engine.RuntimeFindings(context.Background(), q.jdk.Ecosystem, q.jdk.Package, q.jdk.Version)
+	if err != nil {
+		return nil, wrapSourceError(err)
+	}
+	var vulns []vulnerability.Vulnerability
+	for _, f := range findings {
+		ns := RuntimeNamespace(f.Ecosystem)
+		vulns = append(vulns, p.newVulnerability(ns, f.Advisory, q.jdk.Package, p.runtimeEvaluator(*q.jdk), version.JVMFormat))
+	}
+	return p.filter(vulns, q)
+}
+
+// filter applies the ID criteria and every criteria that is not routed structurally.
+func (p *provider) filter(vulns []vulnerability.Vulnerability, q query) ([]vulnerability.Vulnerability, error) {
+	var out []vulnerability.Vulnerability
+	for _, v := range vulns {
+		if q.id != "" && !hasID(v, q.id) {
+			continue
+		}
+		keep := true
+		for _, c := range q.rest {
+			ok, reason, err := c.MatchesVulnerability(v)
+			if err != nil {
+				return nil, err
+			}
+			if !ok {
+				vulnerability.LogDropped(v.ID, "vendordb", reason, v)
+				keep = false
+				break
+			}
+		}
+		if keep {
+			out = append(out, v)
+		}
+	}
+	return out, nil
+}
+
+func hasID(v vulnerability.Vulnerability, id string) bool {
+	if strings.EqualFold(v.ID, id) {
+		return true
+	}
+	for _, r := range v.RelatedVulnerabilities {
+		if strings.EqualFold(r.ID, id) {
+			return true
+		}
+	}
+	return false
+}
+
+// apkEvaluator answers "is <version> of this feed name affected by advisory <id>?" through the engine, so that
+// grype's constraint checks (e.g. NVD de-duplication) use the module's apk range evaluation.
+func (p *provider) apkEvaluator(q query, feedName string) evaluator {
+	return func(advisoryID, ver string) (bool, error) {
+		findings, err := p.engine.APKFindings(context.Background(), q.ecosystem, q.release, match.Package{Name: feedName, Version: ver, Origin: feedName})
+		if err != nil {
+			return false, wrapSourceError(err)
+		}
+		for _, f := range findings {
+			if f.Advisory.ID == advisoryID {
+				return true, nil
+			}
+		}
+		return false, nil
+	}
+}
+
+func (p *provider) runtimeEvaluator(c RuntimeCriteria) evaluator {
+	return func(advisoryID, ver string) (bool, error) {
+		findings, err := p.engine.RuntimeFindings(context.Background(), c.Ecosystem, c.Package, ver)
+		if err != nil {
+			return false, wrapSourceError(err)
+		}
+		for _, f := range findings {
+			if f.Advisory.ID == advisoryID {
+				return true, nil
+			}
+		}
+		return false, nil
+	}
+}
+
+// DistroNamespace is "<provider>:distro:<id>:<release>", the v5-style distro namespace grype's distro criteria parse.
+func DistroNamespace(d *distro.Distro, release string) string {
+	id := ""
+	if d != nil {
+		id = d.ID()
+	}
+	return fmt.Sprintf("%s:distro:%s:%s", Provider, id, release)
+}
+
+// RuntimeNamespace maps a product ecosystem "<family>:<release>" to the namespace
+// "<provider>:<family lower-cased, spaces hyphenated>:<release>".
+func RuntimeNamespace(ecosystem string) string {
+	family, release, _ := strings.Cut(ecosystem, ":")
+	id := strings.ToLower(strings.ReplaceAll(strings.TrimSpace(family), " ", "-"))
+	return fmt.Sprintf("%s:%s:%s", Provider, id, strings.TrimSpace(release))
+}
+
+func (p *provider) newVulnerability(ns string, a osvdata.Advisory, pkgName string, eval evaluator, format version.Format) vulnerability.Vulnerability {
+	id := a.CVE
+	if id == "" {
+		id = a.ID
+	}
+	fix := vulnerability.Fix{State: vulnerability.FixStateNotFixed}
+	if a.Fixed != "" {
+		fix = vulnerability.Fix{Versions: []string{a.Fixed}, State: vulnerability.FixStateFixed}
+	}
+	var related []vulnerability.Reference
+	if id != a.ID {
+		related = append(related, vulnerability.Reference{ID: a.ID, Namespace: ns})
+	}
+	for _, alias := range a.Aliases {
+		if alias != id && alias != a.ID {
+			related = append(related, vulnerability.Reference{ID: alias, Namespace: ns})
+		}
+	}
+	link := a.SourceURL
+	if link == "" && len(a.References) > 0 {
+		link = a.References[0].URL
+	}
+	return vulnerability.Vulnerability{
+		Reference:              vulnerability.Reference{ID: id, Namespace: ns},
+		PackageName:            pkgName,
+		Constraint:             newRangeConstraint(a, format, eval),
+		Fix:                    fix,
+		Advisories:             []vulnerability.Advisory{{ID: a.ID, Link: link}},
+		RelatedVulnerabilities: related,
+		Metadata:               p.metadata(ns, id, a),
+	}
+}
+
+// metadata builds the vendor metadata (severity from the CVSS vector, record URLs, description) enriched from the
+// upstream database by CVE id (NVD CVSS, EPSS, KEV, CWEs). Cached per advisory and namespace.
+func (p *provider) metadata(ns, id string, a osvdata.Advisory) *vulnerability.Metadata {
+	key := ns + "|" + a.ID
+	p.mu.Lock()
+	if m, ok := p.metaCache[key]; ok {
+		p.mu.Unlock()
+		return m
+	}
+	p.mu.Unlock()
+
+	m := &vulnerability.Metadata{
+		ID:          id,
+		DataSource:  a.SourceURL,
+		Namespace:   ns,
+		Severity:    severityString(vulnerability.UnknownSeverity),
+		Description: a.Details,
+	}
+	if m.Description == "" {
+		m.Description = a.Summary
+	}
+	if m.DataSource == "" && len(a.References) > 0 {
+		m.DataSource = a.References[0].URL
+	}
+	for _, ref := range a.References {
+		if ref.URL != m.DataSource {
+			m.URLs = append(m.URLs, ref.URL)
+		}
+	}
+	m.URLs = append(m.URLs, a.OSVURL())
+
+	if a.Severity != "" {
+		m.Severity = severityString(vulnerability.ParseSeverity(a.Severity))
+	}
+	if a.CVSSVector != "" {
+		metrics, err := cvss.ParseMetricsFromVector(a.CVSSVector)
+		if err != nil || metrics == nil {
+			log.WithFields("advisory", a.ID, "vector", a.CVSSVector, "error", err).Debug("vendor osv: unable to parse CVSS vector")
+			metrics = &vulnerability.CvssMetrics{BaseScore: a.CVSSScore}
+		}
+		if m.Severity == severityString(vulnerability.UnknownSeverity) {
+			m.Severity = severityString(cvss.SeverityFromBaseScore(metrics.BaseScore))
+		}
+		m.Cvss = append(m.Cvss, vulnerability.Cvss{
+			Source:  osvinternal.Vendor,
+			Type:    "Primary",
+			Version: cvssVersionOf(a),
+			Vector:  a.CVSSVector,
+			Metrics: *metrics,
+		})
+	}
+
+	if a.CVE != "" && p.upstream != nil {
+		if nvd, err := p.upstream.VulnerabilityMetadata(vulnerability.Reference{ID: a.CVE, Namespace: "nvd:cpe"}); err == nil && nvd != nil {
+			m.Cvss = append(m.Cvss, nvd.Cvss...)
+			m.KnownExploited = nvd.KnownExploited
+			m.EPSS = nvd.EPSS
+			m.CWEs = nvd.CWEs
+			if m.Severity == severityString(vulnerability.UnknownSeverity) && nvd.Severity != "" {
+				m.Severity = nvd.Severity
+			}
+			if m.Description == "" {
+				m.Description = nvd.Description
+			}
+		}
+	}
+
+	p.mu.Lock()
+	p.metaCache[key] = m
+	p.mu.Unlock()
+	return m
+}
+
+func cvssVersionOf(a osvdata.Advisory) string {
+	if a.CVSSVersion != "" {
+		return a.CVSSVersion
+	}
+	if strings.HasPrefix(a.CVSSVector, "CVSS:") {
+		if v, _, ok := strings.Cut(strings.TrimPrefix(a.CVSSVector, "CVSS:"), "/"); ok {
+			return v
+		}
+	}
+	return ""
+}
+
+func severityString(s vulnerability.Severity) string {
+	str := s.String()
+	if str == "" {
+		return "Unknown"
+	}
+	return strings.ToUpper(str[:1]) + str[1:]
+}
+
+// Deprecated: vulnerability.Vulnerability objects carry their metadata; kept for the interface.
+func (p *provider) VulnerabilityMetadata(ref vulnerability.Reference) (*vulnerability.Metadata, error) {
+	if strings.HasPrefix(ref.Namespace, Provider+":") {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		for _, m := range p.metaCache {
+			if m.Namespace == ref.Namespace && (m.ID == ref.ID) {
+				return m, nil
+			}
+		}
+		return &vulnerability.Metadata{ID: ref.ID, DataSource: Provider, Namespace: ref.Namespace, Severity: severityString(vulnerability.UnknownSeverity)}, nil
+	}
+	return p.upstream.VulnerabilityMetadata(ref)
+}
+
+func (p *provider) PackageSearchNames(pk pkg.Package) []string {
+	return p.upstream.PackageSearchNames(pk)
+}
+
+func (p *provider) Close() error {
+	return p.upstream.Close()
+}
+
+func (p *provider) DataProvenance() (map[string]vulnerability.DataProvenance, error) {
+	out := map[string]vulnerability.DataProvenance{}
+	if dpr, ok := p.upstream.(vulnerability.StoreMetadataProvider); ok {
+		dps, err := dpr.DataProvenance()
+		if err != nil {
+			return nil, err
+		}
+		for k, v := range dps {
+			out[k] = v
+		}
+	}
+	for eco, captured := range p.engine.Provenance() {
+		out[Provider+"/"+eco] = vulnerability.DataProvenance{DateCaptured: captured}
+	}
+	return out, nil
+}
+
+func (p *provider) GetOperatingSystemEOL(d *distro.Distro) (eolDate, eoasDate *time.Time, err error) {
+	if d != nil {
+		if eco := ecosystemForDistro(d.Type); eco != "" {
+			return p.engine.EOL(releaseOf(*d)), nil, nil
+		}
+	}
+	if checker, ok := p.upstream.(vulnerability.EOLChecker); ok {
+		return checker.GetOperatingSystemEOL(d)
+	}
+	return nil, nil, nil
+}
diff --git a/grype/vulnerability/vendordb/provider_test.go b/grype/vulnerability/vendordb/provider_test.go
new file mode 100644
index 0000000..f4ccee1
--- /dev/null
+++ b/grype/vulnerability/vendordb/provider_test.go
@@ -0,0 +1,406 @@
+package vendordb
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	osvinternal "github.com/bell-sw/osv-internal"
+	"github.com/bell-sw/osv-internal/match"
+	"github.com/bell-sw/osv-internal/osvdata"
+
+	"github.com/anchore/grype/grype/distro"
+	"github.com/anchore/grype/grype/pkg"
+	"github.com/anchore/grype/grype/search"
+	"github.com/anchore/grype/grype/version"
+	"github.com/anchore/grype/grype/vulnerability"
+	"github.com/anchore/grype/grype/vulnerability/mock"
+	"github.com/anchore/grype/grype/vulnerability/vendordb/vendordbtest"
+	syftPkg "github.com/anchore/syft/syft/pkg"
+)
+
+func apkLess(a, b string) bool {
+	// enough for the fixtures below: compare "-rN" releases of the same upstream version, else lexical
+	ai := strings.LastIndex(a, "-r")
+	bi := strings.LastIndex(b, "-r")
+	if ai > 0 && bi > 0 && a[:ai] == b[:bi] {
+		return len(a[ai:]) < len(b[bi:]) || (len(a[ai:]) == len(b[bi:]) && a[ai:] < b[bi:])
+	}
+	return a < b
+}
+
+func rangeOf(introduced, fixed string) func(string) bool {
+	return func(v string) bool {
+		if introduced != "" && introduced != "0" && apkLess(v, introduced) {
+			return false
+		}
+		if fixed != "" && !apkLess(v, fixed) {
+			return false
+		}
+		return true
+	}
+}
