+		want string
+	}{
+		{"jdk 21", pkg.Package{Name: "jdk", Version: "21.0.2+14", Type: syftPkg.VendorJdkPkg}, osvinternal.Ecosystem(EcosystemJDK, "21")},
+		{"jre 8", pkg.Package{Name: "jre", Version: "8u402+7", Type: syftPkg.VendorJdkPkg}, osvinternal.Ecosystem(EcosystemJDK, "8")},
+		{"jdk GA", pkg.Package{Name: "jdk-lite", Version: "21+37", Type: syftPkg.VendorJdkPkg}, osvinternal.Ecosystem(EcosystemJDK, "21")},
+		{"jdk CSPU", pkg.Package{Name: "jdk", Version: "21.0.12.1+1", Type: syftPkg.VendorJdkPkg}, osvinternal.Ecosystem(EcosystemJDK, "21")},
+		{"jdk 8 CSPU", pkg.Package{Name: "jdk", Version: "8u504+1", Type: syftPkg.VendorJdkPkg}, osvinternal.Ecosystem(EcosystemJDK, "8")},
+		{"jdk bad version", pkg.Package{Name: "jdk", Version: "unknown", Type: syftPkg.VendorJdkPkg}, ""},
+		{"nik core", pkg.Package{Name: "core", Version: "23.1.0+1", Type: syftPkg.VendorNikPkg, Metadata: nikMeta("21+37", "")}, osvinternal.Ecosystem(EcosystemNIK, "23-21")},
+		{"nik from runtime version", pkg.Package{Name: "full", Version: "24.0.1+1", Type: syftPkg.VendorNikPkg, Metadata: nikMeta("", "22.0.1+10")}, osvinternal.Ecosystem(EcosystemNIK, "24-22")},
+		{"nik without java line", pkg.Package{Name: "core", Version: "23.1.0+1", Type: syftPkg.VendorNikPkg}, ""},
+		{"other type", pkg.Package{Name: "jdk", Version: "21.0.2+14", Type: syftPkg.BinaryPkg}, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, RuntimeEcosystem(tt.p))
+		})
+	}
