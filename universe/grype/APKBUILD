ba6bf89ade82b3f31dc0f39346ba1ce18fc9096464d8173b1eec2c03aead327fac9f65dd91d4fff1b35b02042e32b8d47a79ee9f5da94a38468135aa345d77e3  disable-update-check.patch
"
