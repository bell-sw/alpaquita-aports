pkgname=grype
pkgver=0.114.0
pkgrel=14
_syftver=1.45.1
_osvmod=/usr/share/go-modules/github.com/bell-sw/osv-internal
pkgdesc="Vulnerability scanner for container images, filesystems, and SBOMs"
url="https://github.com/anchore/grype"
license="Apache-2.0"
arch="all !armhf !armv7 !x86" # FTBFS on 32-bit arches
# git is to apply git binary diffs
makedepends="go git osv-internal>=0.5.5"
subpackages="
	$pkgname-bash-completion
	"
source="https://github.com/anchore/grype/archive/v$pkgver/grype-$pkgver.tar.gz
	https://github.com/anchore/syft/archive/v$_syftver/syft-$_syftver.tar.gz
	disable-update-check.patch

	0100-recognize-our-distros.patch
	0101-resolve-advisories-through-apk-provided-names.patch
	0102-transform-osv-records-into-distro-keyed-affected-packages.patch
	0103-serve-our-ecosystems-from-osv-data.patch
	0104-match-standalone-jdk-runtimes-against-their-osv-ecosystems.patch
	0105-runtime-types-from-the-module-s-products-table.patch
	0106-syft-classify-jdk-runtimes.diff
	0107-syft-catalog-jdk-runtimes-with-the-osv-internal-module.diff
	0108-syft-runtime-types-from-the-module-s-products-table.diff
	9999-go-mod.patch
	"
options="net" # Go modules

# secfixes:
#   0.114.0-r3:
#     - CVE-2026-46600
#   0.114.0-r0:
#     - CVE-2024-3817
#     - CVE-2024-6257
#     - CVE-2025-8959
#     - CVE-2026-4660
#     - CVE-2026-44973
#     - CVE-2026-45022
#     - CVE-2026-45570
#     - CVE-2026-45571
#   0.104.1-r0:
#     - CVE-2025-65965

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

prepare() {
	default_prepare

	cd "$srcdir/syft-$_syftver"
	local p; for p in "$srcdir"/*.diff; do
		msg "${p##*/}"
		git apply -v -p1 "$p"
	done
	go mod edit -replace github.com/bell-sw/osv-internal="$_osvmod"

	cd "$builddir"
	go mod edit \
		-replace github.com/anchore/syft="$srcdir/syft-$_syftver" \
		-replace github.com/bell-sw/osv-internal="$_osvmod"
}

build() {
	go build -ldflags "
		-X main.version=$pkgver
		" \
		-o bin/grype ./cmd/grype

	./bin/grype completion bash >$pkgname.bash
}

check() {
	# The Go unit tests of every package the vendor changes touch; the rest of the upstream suite
	# needs docker and the network. -trimpath (abuild's default GOFLAGS) is dropped for the tests:
	# grype's dbtest fixtures are located through the source path of the test file.
	# They also fingerprint the source tree through `git rev-parse --show-toplevel`, hence the git init.
	local goflags
	goflags="$(echo " $GOFLAGS " | sed 's/ -trimpath / /g')"
	[ -d .git ] || git init -q .

	GOFLAGS="$goflags" go test \
		./grype/distro/ \
		./grype/matcher/apk/ \
		./grype/matcher/vendorjdk/ \
		./grype/vulnerability/vendordb/... \
		./grype/db/v6/build/transformers/osv/ \
		./cmd/grype/cli/options/
	# TestSyftLocationExcludes builds a docker image
	GOFLAGS="$goflags" go test -skip TestSyftLocationExcludes ./grype/pkg/

	cd "$srcdir/syft-$_syftver"
	GOFLAGS="$goflags" go test \
		./syft/pkg/ \
		./syft/pkg/cataloger/internal/jvmvendor/ \
		./syft/pkg/cataloger/internal/cpegenerate/ \
		./internal/relationship/ \
		./internal/task/
	GOFLAGS="$goflags" go test -run 'VendorJDK|Jvm' ./syft/pkg/cataloger/java/
	GOFLAGS="$goflags" go test -run 'VendorJDK' ./syft/pkg/cataloger/binary/
}

package() {
	install -Dm755 bin/grype -t "$pkgdir"/usr/bin/

	install -Dm644 $pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
}

