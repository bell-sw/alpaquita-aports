 grype/matcher/apk/provided_names_test.go | 133 ++++++++++++++++++++++
 grype/pkg/apk_metadata.go                |   3 +
 grype/pkg/package.go                     |  20 ++++
 grype/pkg/package_test.go                |  30 +++++
 5 files changed, 325 insertions(+)
