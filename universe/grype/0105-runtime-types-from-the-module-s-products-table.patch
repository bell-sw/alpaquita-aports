 grype/pkg/version_format.go                   |  5 +-
 grype/vulnerability/vendordb/config.go        |  4 +-
 grype/vulnerability/vendordb/criteria.go      | 41 +++++----
 .../vendordb/engine_module_test.go            | 47 +++++-----
 grype/vulnerability/vendordb/provider_test.go | 87 +++++++++++++------
 12 files changed, 176 insertions(+), 108 deletions(-)

