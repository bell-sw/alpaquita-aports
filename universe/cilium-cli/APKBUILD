pkgname=cilium-cli
pkgver=0.19.7
pkgrel=0
pkgdesc="CLI to install, manage and troubleshoot Kubernetes clusters running Cilium"
url="https://cilium.io/"
arch="all"
license="Apache-2.0"
makedepends="go"
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/cilium/cilium-cli/archive/refs/tags/v$pkgver.tar.gz"
# Test files are not provided by the cilium-cli repository, see also:
# https://github.com/cilium/design-cfps/pull/9
options="!check"

# secfixes:
#   0.19.0-r17:
#     - CVE-2026-46600

build() {
	go build -v \
		-ldflags "-X github.com/cilium/cilium/cilium-cli/defaults.CLIVersion=v$pkgver" \
		./cmd/cilium

	for shell in bash fish zsh; do
		./cilium completion $shell > cilium.$shell
	done
}

package() {
	install -Dm755 cilium -t "$pkgdir"/usr/bin/

	install -Dm644 cilium.bash \
		"$pkgdir"/usr/share/bash-completion/completions/cilium
	install -Dm644 cilium.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/cilium.fish
	install -Dm644 cilium.zsh \
		"$pkgdir"/usr/share/zsh/site-functions/_cilium
}

sha512sums="
55fcde2c8fb63e3ae521260be38b5d93c20b179e3cfbd61ca3290e4ab7783073e80d62c2a4b5b42a296ede828fe4a356ec3871172d515367eb544461e7e46d61  cilium-cli-0.19.7.tar.gz
"
