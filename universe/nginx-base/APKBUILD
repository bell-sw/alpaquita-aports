	uwsgi-python3
	"
pkgusers="nginx"
_grp_ngx="nginx"
_grp_www="www-data"
pkggroups="$_grp_ngx $_grp_www"
install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-upgrade $pkgname.post-upgrade"
subpackages="
	$pkgname-dbg
	$pkgname-debug
	$pkgname-doc
	$pkgname-openrc
	$pkgname-vim::noarch
	$pkgname-mod-dev:_mod_dev:noarch
	"
source="https://nginx.org/download/nginx-$pkgver.tar.gz
	$_pkgname-tests-$_tests_rev.tar.gz::https://github.com/nginx/nginx-tests/archive/$_tests_rev.tar.gz
	$_pkgname-njs-$_njs_ver.tar.gz::https://github.com/nginx/njs/archive/$_njs_ver.tar.gz
	no-werror.patch
	nginx.conf
	default.conf
	stream.conf
	$_pkgname.logrotate
	$_pkgname.initd
	$_pkgname.confd
