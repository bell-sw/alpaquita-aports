_pkgname=nginx
pkgname=$_pkgname-base
# NOTE: Upgrade only to even-numbered versions (e.g. 1.14.z, 1.16.z)!
#  Odd-numbered versions are mainline (development) versions.
# NOTE: When bumping, always rebuild all nginx modules (nginx-mod-* aports)!
pkgver=1.30.4
pkgrel=1
# Revision of nginx-tests to use for check().
_tests_rev=4d1de3f357afeb91865d024b27516d6b67aad86e
_njs_ver=0.9.9
# Dependency of the naxsi module. The project is active, but they hasn't
# released a new version since 2017, so we rather bundle it instead of
# packaging (https://github.com/libinjection/libinjection/issues/50).
_libinjection_rev=b9fcaaf9e50e9492807b23ffcc6af46ee1f203b9
# if this isn't set higher than testing/openresty that comes first for some reason
# even though this has a higher version..
provider_priority=100
pkgdesc="HTTP and reverse proxy server (stable version) with only base modules"
url="https://www.nginx.org/"
arch="all"
license="BSD-2-Clause"
# Build dependencies of nginx itself (without third-party modules).
_makedepends_base="
	gd-dev
	geoip-dev
  glibc:libxcrypt-dev
	libxslt-dev
	linux-headers
	openssl-dev
	pcre2-dev
	perl-dev
	zlib-dev
	"
makedepends="
	$_makedepends_base
	brotli-dev
	"
checkdepends="
	gd
	perl
	perl-fcgi
	perl-io-socket-ssl
	perl-net-ssleay
	perl-protocol-websocket
