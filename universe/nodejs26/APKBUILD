pkgname=nodejs26
pkgver=26.7.0
pkgrel=0
pkgdesc="JavaScript runtime built on V8 engine (v26)"
url="https://nodejs.org/"
arch="all"
license="MIT"
depends="ca-certificates"
depends_dev=""
makedepends="
	$depends_dev
	ada-dev
	brotli-dev
	c-ares-dev
	icu-dev
	linux-headers
	nghttp2-dev
	openssl-dev>3
	python3
	samurai
	zlib-dev
	"
subpackages="
	$pkgname-dev
	$pkgname-libs
	$pkgname-doc
	"
provides="nodejs"
source="https://nodejs.org/dist/v$pkgver/node-v$pkgver.tar.xz
	nodejs.pc.in

	elf.patch
	google-sucks.patch
	riscv-trap-handler.patch
	v8-disable-trap-handler-on-riscv-sv39.patch
	v8-ppc_vsx-inl.patch
	v8-x86_mm_cvtsi128_si64.patch
	v8-yield-processor.patch
	ppc64le-adjust-gcc-toc-flags.patch
	v8-armhf_fixedtag.patch
	v8-s390x_mmap.patch
	revert-drop-power8-support-part-1.patch
	revert-drop-power8-support-part-2.patch
	v8-maglev-ir-riscv.patch
	hdr_histogram-x86.patch
	"
builddir="$srcdir/node-v$pkgver"

prepare() {
	default_prepare
	# unbundle
	rm \
		deps/zlib/zlib.gyp
}

build() {
	# Os overwrites the optimizations in BUILDTYPE=Release
	# increases binary size by ~10% (53.1 MiB -> 58.6 MiB),
	# but also increases performance by ~20%  according to
	# v8/web-tooling-benchmark. Node.js is quite huge anyway;
	# there are better options for size constrained environments.
	export CFLAGS="${CFLAGS/-Os/}"
	export CXXFLAGS="${CXXFLAGS/-Os/} -Wno-deprecated-declarations"

	if [ "$CARCH" = "loongarch64" ]; then
		export CXXFLAGS="$CXXFLAGS -mlasx"
	fi

	if [ "$CARCH" = "armhf" ]; then
		export CXXFLAGS="$CXXFLAGS -DCAN_USE_ARMV7_INSTRUCTIONS=1 -DCAN_USE_VFP3_INSTRUCTIONS=1"
	fi

	# When building shared libnode.so, the resulting package size is +15 %
	# (~8 MiB), so we rather build it twice to keep the node binary smaller
	# (there are currently no packages using libnode.so).
	if ! [ -x out/node ]; then
		msg 'Building node binary'
		_build
		cp out/Release/node out/
	fi

	msg 'Building libnode.so'
	_build --shared
	cp out/Release/lib/libnode.so* out/Release/

	sed "s/@VERSION@/$pkgver/" "$srcdir"/nodejs.pc.in > out/Release/nodejs.pc
}

_build() {
	./configure \
		--prefix=/usr \
		--shared-brotli \
		--shared-zlib \
		--shared-openssl \
		--shared-cares \
		--shared-nghttp2 \
		--ninja \
		--with-intl=system-icu \
		--without-npm \
		--openssl-use-def-ca-store \
		"$@"

	make BUILDTYPE=Release
}

# TODO Run provided test suite.
check() {
	cd "$builddir"/out/Release

	./node -e 'console.log("Hello, world!")'
	./node -e "require('assert').equal(process.versions.node, '$pkgver')"
	./node -e 'console.log("Openssl:", process.versions.openssl)'
	./node -e 'require("assert").equal(
		Buffer.from(Buffer.from("foo").toString("base64"), "base64").toString("ascii"),
		"foo")'
}

package() {
	make DESTDIR="$pkgdir" install

	# node binary built without libnode.so.
	install -D -m755 out/node -t "$pkgdir"/usr/bin/

	install -D -m644 out/Release/nodejs.pc -t "$pkgdir"/usr/lib/pkgconfig/

	(cd "$pkgdir"/usr/lib; ln -sf libnode.so.* libnode.so)
}

_subpkg_provides() {
	provides="nodejs${subpkgname#$pkgname}"
}

dev() {
	default_dev
	_subpkg_provides
}

libs() {
	default_libs
	_subpkg_provides
}

doc() {
	default_doc
	_subpkg_provides
}

