pkgname=scx-scheds
pkgver=1.1.3
pkgrel=0
pkgdesc="The BPF task scheduler implementations and tools"
url="https://github.com/sched-ext/scx"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends=""
makedepends="
	bpftool
	bsd-compat-headers
	cargo-auditable
	clang
	clang-libclang
	llvm
	libbpf-dev
	libseccomp-dev
	linux-headers
	zlib-dev
	elfutils-dev
	"
options="!check !annobin"
subpackages="$pkgname-openrc"

source="$pkgname-$pkgver.tar.gz::https://github.com/sched-ext/scx/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	"
builddir="$srcdir/scx-$pkgver"

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	# Build schedulers (production ready)

	C_SCHEDS="\
		scx_ftalcg \
		scx_nest \
		scx_simple \
		" \
		make all

	cargo auditable build --release --frozen --workspace \
		--exclude scx_rlfifo \
		--exclude scx_wd40 \
		--exclude scx_mitosis \
		--exclude scx_chaos \
		--exclude scx_tickless \
		--exclude scxcash \
		--exclude xtask \
		--exclude vmlinux_docify \
		--exclude scx_arena_selftests
}

package() {
	find build/scheds/c target/release -maxdepth 1 -type f -executable \
		! -name '*.so' \
		-exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

