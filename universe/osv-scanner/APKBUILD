pkgname=osv-scanner
pkgver=2.1.0
pkgrel=10
pkgdesc="Vulnerability scanner written in Go which uses the data provided by https://osv.dev"
url="https://github.com/google/osv-scanner"
arch="all"
license="Apache-2.0"
makedepends="go"
checkdepends="tzdata"
# tests appears to be flaky? passes on local machines but fails on builder
options="net !check"
source="https://github.com/google/osv-scanner/archive/v$pkgver/osv-scanner-$pkgver.tar.gz
		osv-scalibr-for_scanner-apk.tar.gz::https://github.com/i-bs/osv-scalibr/archive/refs/heads/for_scanner-apk.tar.gz
		"

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

prepare() {
	default_prepare
	echo "replace github.com/google/osv-scalibr v0.3.1-0.20250709041632-ed2676c6ae1b => ../osv-scalibr-for_scanner-apk" >> go.mod
}

build() {
	mkdir build
	go build -o build/ ./cmd/...
}

check() {
	# TestRun fails because more ghsa's were published since it was made
	# shellcheck disable=2046
	go test $(go list ./... | grep -v cmd/osv-scanner)
}

package() {
	install -Dm755 ./build/osv-scanner -t "$pkgdir"/usr/bin/
}

sha512sums="
5e23dc0b515b135bccbcad7cad9149eba3075cf57ffd6a714903b1187a6b82142f1f53064bf8d508e4b527250b5a730c4f45224872ff0414379a1cb7d6761f52  osv-scanner-2.1.0.tar.gz
779170f7eaea11bff6c10728b8ff32f92b40ffb34270b29df0d0ad0aace28fbaa1e8ad3963b96ada57638292c22ad8302c612a304be37bca928ce7266ef47474  osv-scalibr-for_scanner-apk.tar.gz
"
