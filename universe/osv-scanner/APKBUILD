#     - CVE-2026-44973

build() {
	go build -o build/ ./cmd/...
}

check() {
	# TestRun fails because more ghsa's were published since it was made
	# shellcheck disable=2046
	go test $(go list ./... | grep -v cmd/osv-scanner)
}

package() {
	install -Dm755 ./build/osv-scanner -t "$pkgdir"/usr/bin/
}

