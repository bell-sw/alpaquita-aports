export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

# secfixes:
#   2.3.3-r0:
#     - CVE-2026-46600
#   2.1.0-r13:
#     - CVE-2026-5160
#     - CVE-2026-44973

prepare() {
	default_prepare

	cd "$srcdir/$_scalibr_dir"
	local p; for p in "$srcdir"/*.diff; do
		msg "${p##*/}"
		patch -p1 -i "$p"
	done
	go mod edit -replace $_osvmod=/usr/share/go-modules/$_osvmod

	cd "$builddir"
	go mod edit \
		-replace github.com/google/osv-scalibr="$srcdir/$_scalibr_dir" \
		-replace $_osvmod=/usr/share/go-modules/$_osvmod
}

build() {
	go build -o build/ ./cmd/...
}

check() {
	# unit tests of the packages changed by the vendor patches (upstream's full suites are not run: TestRun
	# snapshots go stale as advisories are published, see the previous recipe). The osv-scalibr
	# packages are tested from this module, i.e. with the dependency versions the binary is built
	# with: osv-scalibr's own go.mod (x/net 0.54, grpc 1.81) does not compile its tests with go 1.27.
	go test ./internal/scalibrannotator/filter/ ./internal/utility/purl/ ./internal/scalibrplugin/ \
		./internal/imodels/ ./cmd/osv-scanner/internal/helper/ \
		github.com/google/osv-scalibr/extractor/filesystem/os/apk/... \
		github.com/google/osv-scalibr/extractor/filesystem/language/java/vendorjdk/... \
		github.com/google/osv-scalibr/enricher/vulnmatch/... \
		github.com/google/osv-scalibr/inventory/osvecosystem/ \
		github.com/google/osv-scalibr/semantic/
}

package() {
	install -Dm755 ./build/osv-scanner -t "$pkgdir"/usr/bin/
}

