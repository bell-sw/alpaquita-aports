From 1ba31ea96584f1e75588f70831efdf1693f87c92 Mon Sep 17 00:00:00 2001
From: BellSoft <info@bell-sw.com>
Date: Sat, 10 Oct 2026 19:10:46 +0000
Subject: [PATCH] fix(filter): keep packages that are queried by version when
 their commit is short

A package with an ecosystem, name and version is queried by version; its
commit is metadata only. The filter nevertheless dropped every such package
whose commit was not a 40-character SHA. apk records the build commit in
the "c:" field, and on distributions whose packages carry "c:-dirty" there
(BellSoft's Alpaquita Linux and Hardened Containers) every package was
filtered:

    Skipping liberica21-lite: short commit hash "-dirty" cannot be queried; ...
    No issues found

Git-only packages (no version) are still filtered.
---
 internal/scalibrannotator/filter/filter.go    | 14 ++++++++++-
 .../scalibrannotator/filter/filter_test.go    | 25 +++++++++++++++++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/internal/scalibrannotator/filter/filter.go b/internal/scalibrannotator/filter/filter.go
index 5a3c18c..c5f9f99 100644
--- a/internal/scalibrannotator/filter/filter.go
+++ b/internal/scalibrannotator/filter/filter.go
@@ -105,7 +105,10 @@ func (a *Annotator) Annotate(_ context.Context, _ *annotator.ScanInput, results
 		}
 
 		// Short commit hashes warning
-		if imodels.Commit(psr) != "" && len(imodels.Commit(psr)) < 40 {
+		// A package with an ecosystem, name and version is queried by version;
+		// its commit is metadata only (apk records the build commit in "c:",
+		// which may be "-dirty").
+		if imodels.Commit(psr) != "" && len(imodels.Commit(psr)) < 40 && !queryableByVersion(psr) {
 			warnings = append(warnings, fmt.Sprintf("Skipping %s: short commit hash %q cannot be queried; OSV API requires a full 40-character SHA.", imodels.Name(psr), imodels.Commit(psr)))
 			unscannableCount++
 			if a.showAllPackages {
@@ -171,6 +174,15 @@ func (a *Annotator) Annotate(_ context.Context, _ *annotator.ScanInput, results
 }
 
 // FilteredPackages returns the list of packages filtered out that should be preserved.
+// queryableByVersion reports whether the package can be looked up by
+// ecosystem, name and version, in which case its commit (if any) is not used.
+func queryableByVersion(pkg *extractor.Package) bool {
+	eco := imodels.Ecosystem(pkg)
+
+	return !eco.IsEmpty() && eco.GetValidity() == nil && eco.String() != "GIT" &&
+		imodels.Name(pkg) != "" && imodels.Version(pkg) != ""
+}
+
 func (a *Annotator) FilteredPackages() []*extractor.Package {
 	return a.filteredPackages
 }
diff --git a/internal/scalibrannotator/filter/filter_test.go b/internal/scalibrannotator/filter/filter_test.go
index 1a9bf21..7a21425 100644
--- a/internal/scalibrannotator/filter/filter_test.go
+++ b/internal/scalibrannotator/filter/filter_test.go
@@ -7,6 +7,7 @@ import (
 	"github.com/google/go-cmp/cmp"
 	"github.com/google/go-cmp/cmp/cmpopts"
 	"github.com/google/osv-scalibr/extractor"
+	apkmeta "github.com/google/osv-scalibr/extractor/filesystem/os/apk/metadata"
 	dpkgmeta "github.com/google/osv-scalibr/extractor/filesystem/os/dpkg/metadata"
 	"github.com/google/osv-scalibr/inventory"
 	"github.com/google/osv-scalibr/purl"
@@ -39,6 +40,21 @@ func TestAnnotator_Annotate(t *testing.T) {
 		},
 		PURLType: purl.TypeNPM,
 	}
+	// queried by version: the short apk build commit ("c:-dirty") must not filter it
+	pkgApkBuildCommit := &extractor.Package{
+		Name:     "liberica21-lite-jdk-no-deps",
+		Version:  "21.0.2_p14-r1",
+		PURLType: purl.TypeApk,
+		Metadata: &apkmeta.Metadata{
+			OSID:        "alpaquita",
+			OSVersionID: "23",
+			PackageName: "liberica21-lite-jdk-no-deps",
+			OriginName:  "liberica21-lite",
+		},
+		SourceCode: &extractor.SourceCodeIdentifier{
+			Commit: "-dirty",
+		},
+	}
 	pkgLinuxKernel := &extractor.Package{
 		Name:     "linux",
 		Version:  "6.1.0",
@@ -86,6 +102,15 @@ func TestAnnotator_Annotate(t *testing.T) {
 			wantPackages:         []*extractor.Package{pkgScannable},
 			wantFilteredPackages: []*extractor.Package{pkgUnscannableNoVersion, pkgUnscannableShortHash},
 		},
+		{
+			name:            "apk_package_with_short_build_commit_is_kept",
+			isContainerScan: true,
+			showAllPackages: true,
+			inputPackages:   []*extractor.Package{pkgApkBuildCommit, pkgUnscannableShortHash},
+			wantPackages:    []*extractor.Package{pkgApkBuildCommit},
+			// the git-only package is still unscannable
+			wantFilteredPackages: []*extractor.Package{pkgUnscannableShortHash},
+		},
 		{
 			name:            "container_scan_filters_linux_kernel",
 			isContainerScan: true,
