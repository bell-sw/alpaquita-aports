+		{"21.0.12.1+1", "21.0.12.1+1"},
+		{"26-ea+5", "26+5"},
+		// CSPU builds
+		{"21.0.12.1+1-LTS", "21.0.12.1+1"},
+		{"8u504+1", "8u504+1"},
+		{"1.8.0_504-b01", "8u504+1"},
+		// CPU builds
+		{"21.0.11.0.1+1-LTS", "21.0.11.0.1+1"},
+		{"21.0.9.0.1+1-LTS", "21.0.9.0.1+1"},
