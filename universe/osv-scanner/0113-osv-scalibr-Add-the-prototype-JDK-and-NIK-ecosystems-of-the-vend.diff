+// upperBoundComparer is implemented by versions whose upper bound of a range
+// ("fixed", "last_affected") is not judged by the plain order, see
+// semantic.VendorJDKVersion.CompareUpperBoundStr.
+type upperBoundComparer interface {
+	CompareUpperBoundStr(str string) (int, error)
+}
+
+// compareUpperBound compares the installed version with a "fixed" or
+// "last_affected" event.
+func compareUpperBound(v semantic.Version, bound string) int {
+	if u, ok := v.(upperBoundComparer); ok {
+		order, _ := u.CompareUpperBoundStr(bound)
+
+		return order
+	}
+	// Ignore errors as we assume the version is correct
+	order, _ := v.CompareStr(bound)
+
+	return order
+}
+
