 pkg/osvscanner/osvscanner.go             | 12 +++--
 pkg/osvscanner/scan.go                   | 62 +++++++++++++++++++++---
 pkg/osvscanner/vendor_internal_test.go   | 38 ++++++++++++++-
 4 files changed, 99 insertions(+), 17 deletions(-)

