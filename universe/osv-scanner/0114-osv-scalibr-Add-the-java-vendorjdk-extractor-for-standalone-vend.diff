+	}
+	if got, want := jdk.Ecosystem().String(), osvjdk.EcosystemFor(21); got != want {
+		t.Errorf("Ecosystem() = %q, want %q", got, want)
+	}
+	if got, want := jdk.PURL().String(), osvjdk.PURL("jdk", "21.0.2+14"); got != want {
+		t.Errorf("PURL() = %q, want %q", got, want)
+	}
