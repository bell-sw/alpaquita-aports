diff --git a/extractor/filesystem/language/java/vendorjdk/metadata/metadata.go b/extractor/filesystem/language/java/vendorjdk/metadata/metadata.go
new file mode 100644
index 0000000..2c89323
--- /dev/null
+++ b/extractor/filesystem/language/java/vendorjdk/metadata/metadata.go
@@ -0,0 +1,90 @@
