+func TestExtract_Glue(t *testing.T) {
+	e := vendorjdk.NewWithDetector(fakeDetector())
+	testdata := buildTestRuntimes(t)
+
+	tests := []struct {
+		name string
+		root string
+		path string
+		want []*extractor.Package
+	}{
