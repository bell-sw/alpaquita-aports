+func TestPackageIdentity(t *testing.T) {
+	nik2321 := osvinternal.Ecosystem(osvinternal.EcosystemNIK, "23-21")
+	jdk := &extractor.Package{
+		Name: "jdk", Version: "21.0.2+14", PURLType: purl.TypeGeneric,
