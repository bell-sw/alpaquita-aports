pkgname=calicoctl
pkgver=3.33.0
pkgrel=0
pkgdesc="Optional command line interface (CLI) to manage Calico resources"
url="https://github.com/projectcalico/calico"
arch="all"
license="Apache-2.0"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/projectcalico/calico/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/calico-$pkgver"
options="!check"

# secfixes:
#   3.31.3-r3:
#     - CVE-2026-46600

build() {
	cd calicoctl
	mkdir -p bin

	go build -o bin/calicoctl \
		-ldflags "
		-X github.com/projectcalico/calico/pkg/buildinfo.Version=$pkgver
		-X github.com/projectcalico/calico/pkg/buildinfo.GitRevision=$VENDOR_DISTRO
		" \
		calicoctl/calicoctl.go 
}

package() {
	cd calicoctl
	install -Dm755 -t "$pkgdir"/usr/bin bin/calicoctl
	install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname ../LICENSE.md
}

sha512sums="
fa8886bd30c32aca87adc1d8614ddfdedec442229bfb8b5f28ec5a64dfd6de567c3a63ab3dac19d0a67e3de53cfb8ed5a6f7bbc3f82bedf9b6a94fae4385de9f  calicoctl-3.33.0.tar.gz
"
