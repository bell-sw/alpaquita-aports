pkgname=google-guest-agent
pkgver=20250317.00
pkgrel=0
pkgdesc="Guest Agent for Google Compute Engine"
url="https://github.com/GoogleCloudPlatform/guest-agent"
arch="all"
license="Apache-2.0"
makedepends="go"
depends="bash"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz
	google-guest-agent.initd
	google-metadata-script-runner.initd
	0001-Replace-systemctl-commands-with-rc-service-commands.patch
	"
builddir="$srcdir/guest-agent-$pkgver"

build() {
	mkdir -p bin
	local cmd
	for cmd in google_guest_agent google_metadata_script_runner; do
		go build -o bin/$cmd ./$cmd
	done
}

check() {
	local cmd
	for cmd in google_guest_agent google_metadata_script_runner; do
		go test -v ./$cmd
	done
}

package() {
	install -v -d -m0755  "$pkgdir"/usr/bin
	install -v -m0755 bin/* "$pkgdir"/usr/bin

	install -v -d -m0755  "$pkgdir"/etc/init.d
	local f
	for f in google-metadata-script-runner google-guest-agent; do
		install -v -m0755 "$srcdir"/$f.initd "$pkgdir"/etc/init.d/$f
	done
}

