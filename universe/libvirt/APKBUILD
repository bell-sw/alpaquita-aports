pkgname=libvirt
pkgver=11.3.0
_ver="${pkgver/_rc/-rc}"
pkgrel=4
pkgdesc="Virtualization API for several hypervisor and container systems"
url="https://libvirt.org/"
arch="all"
options="!check"
license="LGPL-2.1-or-later"
# ongoing efforts since libvirt-10.4.0 to replace iptables with nftables, only `nwfilter` module is still using it
_daemon_deps="
	bridge-utils
	dmidecode
	dnsmasq
	iproute2-tc
	iptables
	util-linux-misc
	"
_client_deps="
	gnutls-utils
	libxslt
	netcat-openbsd
	pm-utils
	"
depends="lvm2"
depends_dev="$pkgname=$pkgver-r$pkgrel"
# mdev support is also present for some time already
makedepends="
	$_client_deps
	$_daemon_deps
	$depends_dev
	acl-dev
	augeas-dev
	bash-completion-dev
	curl-dev
	cyrus-sasl-dev
	device-mapper
	e2fsprogs-dev
	eudev-dev
	fuse3-dev
	gnutls-dev
	json-c-dev
	libcap-ng-dev
	libnl3-dev
	libpcap-dev
	libpciaccess-dev
	libssh2-dev
	libtasn1-dev
	libtirpc-dev
	libxml2-dev
	linux-headers
	lvm2-dev
	meson
	netcf-dev
	parted-dev
	perl
	perl-xml-xpath
	polkit-dev
	py3-docutils
	qemu-pr-helper
	qemu>=5.2.0
	readline-dev
	rpcsvc-proto
	"
install="$pkgname.post-install"
subpackages="
	$pkgname-bash-completion
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-libs
	$pkgname-client
	$pkgname-daemon
	$pkgname-daemon-openrc
	$pkgname-lxc
	$pkgname-qemu
	$pkgname-vbox
	"
source="https://libvirt.org/sources/libvirt-$pkgver.tar.xz
	libvirt.confd
	libvirt.initd
	libvirt-guests.confd
	libvirt-guests.initd
	virtlogd.initd
	virtlockd.initd

	0100-CVE-2025-12748-conf-Add-virDomainDefIDsParseString.patch
	0101-CVE-2025-12748-bhyve-Check-ACLs-before-parsing-the-whole-domain-XML.patch
	0102-CVE-2025-12748-libxl-Check-ACLs-before-parsing-the-whole-domain-XML.patch
	0103-CVE-2025-12748-lxc-Check-ACLs-before-parsing-the-whole-domain-XML.patch
	0104-CVE-2025-12748-vz-Check-ACLs-before-parsing-the-whole-domain-XML.patch
	0105-CVE-2025-12748-ch-Check-ACLs-before-parsing-the-whole-domain-XML.patch
	0106-CVE-2025-12748-qemu-Check-ACLs-before-parsing-the-whole-domain-XML.patch
	0107-CVE-2025-13193.patch
	0108-CVE-2026-63622.patch
	0109-CVE-2026-18917.patch
	"
subpackages="$subpackages $pkgname-common-drivers:_common_drivers"

