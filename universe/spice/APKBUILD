pkgname=spice
pkgver=0.15.2
pkgrel=2
pkgdesc="Implements the SPICE protocol"
url="http://www.spice-space.org/"
arch="all"
license="LGPL-2.0-or-later"
makedepends="
	cyrus-sasl-dev
	gdk-pixbuf-dev
	glib-dev
	gst-plugins-base-dev
	gstreamer-dev
	libjpeg-turbo-dev
	lz4-dev
	meson
	openssl-dev>3
	opus-dev
	orc-dev
	pixman-dev
	py3-parsing
	py3-six
	spice-protocol
	zlib-dev
	"
subpackages="$pkgname-dev"
source="https://www.spice-space.org/download/releases/spice-server/spice-$pkgver.tar.bz2
	failing-tests.patch
	0101-CVE-2026-105959-glz-int-truncation-malloc-callback.patch
	0102-CVE-2026-105959-glz-validate-max_encoders.patch
	0103-CVE-2026-105958-migration-dont-abort-invalid-data.patch
	0104-CVE-2026-105958-reds-agent-migration-struct-size.patch
	0105-CVE-2026-105958-display-validate-surface_id-bounds.patch
	0106-CVE-2026-105958-display-validate-surfaces_at_client_ptr.patch
	0107-CVE-2026-105958-reds-validate-agent-migration-fields.patch
	0108-CVE-2026-105958-char-device-validate-write_data_ptr.patch
	"

# secfixes:
#   0.15.2-r2:
#     - CVE-2026-105958
#     - CVE-2026-105959
#   0.15.0-r0:
#     - CVE-2020-14355
#   0.14.3-r1:
#     - CVE-2021-20201
#   0.14.1-r4:
#     - CVE-2019-3813
#   0.14.1-r0:
#     - CVE-2018-10873
#   0.12.8-r4:
#     - CVE-2017-7506
#   0.12.8-r3:
#     - CVE-2016-9577
#     - CVE-2016-9578

build() {
	abuild-meson \
		-Db_lto=true \
		-Dgstreamer=1.0 \
		-Dlz4=true \
		-Dsasl=true \
		-Dopus=enabled \
		-Dsmartcard=disabled \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	provides="$pkgname-server=$pkgver-r$pkgrel"
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

