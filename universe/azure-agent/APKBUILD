pkgname=azure-agent
pkgver=2.13.1.1
pkgrel=0
pkgdesc="The Microsoft Azure Linux Agent"
url="https://github.com/Azure/WALinuxAgent"
license="Apache-2.0"
arch="noarch"

depends="
	bash
	coreutils
	dhcpcd
	openssl
	parted
	py3-asn1
	py3-distro
	sfdisk
	shadow
	sudo
	util-linux-misc
"

makedepends="py3-setuptools"

source="WALinuxAgent-$pkgver.tar.gz::https://github.com/Azure/WALinuxAgent/archive/refs/tags/v$pkgver.tar.gz
	1000-alpaquita.patch
"

builddir="$srcdir/WALinuxAgent-$pkgver"

subpackages="$pkgname-openrc"

prepare() {
	default_prepare
}

build() {
	python3 setup.py build
}

package() {
	python3 setup.py install --prefix=/usr --root="$pkgdir"
}

