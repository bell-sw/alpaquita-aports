pkgname=perl-http-daemon
pkgver=6.14
pkgrel=1
pkgdesc="HTTP::Daemon perl module"
url="https://metacpan.org/release/HTTP-Daemon"
arch="noarch"
license="GPL-1.0-or-later OR Artistic-1.0-Perl"
depends="perl perl-http-date perl-http-message"
makedepends="perl-module-build-tiny"
checkdepends="perl-test-needs"
replaces="perl-libwww"
subpackages="$pkgname-doc"
source="https://cpan.metacpan.org/authors/id/O/OA/OALDERS/HTTP-Daemon-$pkgver.tar.gz
	0100-CVE-2022-31081.patch
	0101-CVE-2022-31081.patch
	0102-CVE-2022-31081.patch
	0103-CVE-2022-31081-test-1.patch
	0104-CVE-2022-31081-test-2.patch
	0105-CVE-2022-31081-test-3.patch
	"

builddir="$srcdir"/HTTP-Daemon-$pkgver

# secfixes:
#   6.14.0-r1:
#     - CVE-2022-31081

build() {
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
}

check() {
	make test
}

package() {
	make DESTDIR="$pkgdir" install
	find "$pkgdir" \( -name perllocal.pod -o -name .packlist \) -delete
}

